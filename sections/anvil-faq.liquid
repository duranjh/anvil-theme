{% render 'anvil-stylesheet', file: 'anvil-sec-faq.css', section: section %}
{%- liquid
  assign s = section.settings
  assign untitled_label = 'anvil.faq.untitled_question' | t

  # The toggle icon is captured once here and printed per item (shared accordion: assets/anvil-accordion.css).
  assign toggle_icon = s.toggle_icon | default: 'chevron'
  capture toggle_html
    if toggle_icon == 'plus'
      echo '<span class="av-accordion__open">'
      render 'anvil-icon', name: 'plus', size: 20
      echo '</span><span class="av-accordion__close">'
      render 'anvil-icon', name: 'minus', size: 20
      echo '</span>'
    else
      render 'anvil-icon', name: 'chevron-down', size: 20
    endif
  endcapture
  assign opened = false

  # FAQPage JSON-LD, built as a string here so the only for-loop tag over
  # section.blocks is the one that renders the blocks (the chassis lint checks
  # that loop for shopify_attributes). Emitted only when the merchant turns the
  # setting on and at least one item has both texts. Never put a tag delimiter
  # inside a comment line of a liquid tag: it would end the tag early.
  assign faq_entities = ''
  if s.json_ld
    for block in section.blocks
      if block.settings.question != blank and block.settings.answer != blank
        capture faq_entity
          echo '{"@type":"Question","name":'
          echo block.settings.question | strip | json
          echo ',"acceptedAnswer":{"@type":"Answer","text":'
          echo block.settings.answer | json
          echo '}}'
        endcapture
        if faq_entities == ''
          assign faq_entities = faq_entity
        else
          assign faq_entities = faq_entities | append: ',' | append: faq_entity
        endif
      endif
    endfor
  endif
  assign faq_class = 'av-faq av-accordion av-accordion--' | append: s.item_style
  if s.two_columns
    assign faq_class = faq_class | append: ' av-faq--two-col'
  endif
-%}
{%- if section.blocks.size > 0 or request.design_mode -%}
<div {% render 'anvil-section-attrs', section: section, type: 'anvil-faq' %}>
  <div class="av-section__inner">
    {%- if section.blocks.size > 0 -%}
      {%- assign fallback = 'anvil.faq.heading' | t -%}
      {% render 'anvil-section-head', section: section, fallback: fallback %}
      {% render 'anvil-stylesheet', file: 'anvil-accordion.css', section: section %}
      <anvil-collapsible class="{{ faq_class }}"{% if s.single_open %} single{% endif %}>
        {%- for block in section.blocks -%}
          {%- liquid
            # A disclosure without a name fails accessibility, so an item whose
            # question is blank is skipped on the storefront. In the editor it
            # stays visible with a placeholder so the merchant can still select it.
            assign question = block.settings.question | strip
            if question == blank
              if request.design_mode
                assign question = untitled_label
              else
                continue
              endif
            endif
          -%}
          {%- liquid
            # Open the first item that is actually rendered (a blank first question is skipped above).
            assign open_attr = ''
            if s.open_first and opened == false
              assign open_attr = ' open'
              assign opened = true
            endif
          -%}
          <details class="av-accordion__item"{{ open_attr }} {{ block.shopify_attributes }}>
            <summary class="av-accordion__summary">
              <h3 class="av-accordion__title">{{ question | escape_once }}</h3>
              <span class="av-accordion__toggle" aria-hidden="true">{{ toggle_html }}</span>
            </summary>
            <div class="av-accordion__body av-rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </anvil-collapsible>
    {%- else -%}
      {% render 'anvil-section-head', section: section %}
      {% render 'anvil-editor-empty' %}
    {%- endif -%}
  </div>
  {%- if faq_entities != '' -%}
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ faq_entities }}]}</script>
  {%- endif -%}
</div>
{%- endif -%}
{% schema %}
{
  "name": "FAQ",
  "max_blocks": 30,
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Bold a word to colour it with the accent" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "text_alignment", "id": "head_align", "label": "Heading alignment", "default": "center" },
    { "type": "select", "id": "head_size", "label": "Heading size", "options": [ {"value":"xs","label":"Extra small"}, {"value":"sm","label":"Small"}, {"value":"md","label":"Medium"}, {"value":"lg","label":"Large"}, {"value":"xl","label":"Extra large"} ], "default": "lg" },
    { "type": "select", "id": "accent_style", "label": "Accent style for bold words", "options": [ {"value":"color","label":"Accent colour"}, {"value":"underline","label":"Underline"}, {"value":"highlight","label":"Highlight"}, {"value":"gradient","label":"Gradient"} ], "default": "color" },
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "select", "id": "width", "label": "Width", "options": [ {"value":"page","label":"Page width"}, {"value":"narrow","label":"Narrow"}, {"value":"full","label":"Full width"} ], "default": "page" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "select", "id": "pad_mobile", "label": "Padding on phones", "options": [ {"value":"same","label":"Same as desktop"}, {"value":"compact","label":"Compact"}, {"value":"none","label":"None"} ], "default": "compact" },
    { "type": "select", "id": "reveal", "label": "Animate on scroll", "options": [ {"value":"none","label":"Off"}, {"value":"fade-up","label":"Fade up"}, {"value":"fade","label":"Fade"}, {"value":"zoom","label":"Zoom"} ], "default": "none" },
    { "type": "select", "id": "show_on", "label": "Show on", "options": [ {"value":"all","label":"All devices"}, {"value":"mobile","label":"Phones only"}, {"value":"desktop","label":"Desktop only"} ], "default": "all" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "info": "Letters, numbers and hyphens. Link to this section with #your-id" },
    { "type": "header", "content": "FAQ" },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first question",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "single_open",
      "label": "Close other questions when one opens",
      "default": false
    },
    {
      "type": "select",
      "id": "toggle_icon",
      "label": "Open and close icon",
      "options": [
        { "value": "chevron", "label": "Chevron" },
        { "value": "plus", "label": "Plus and minus" }
      ],
      "default": "chevron"
    },
    {
      "type": "select",
      "id": "item_style",
      "label": "Item style",
      "options": [
        { "value": "lines", "label": "Divider lines" },
        { "value": "cards", "label": "Cards" }
      ],
      "default": "lines"
    },
    {
      "type": "checkbox",
      "id": "two_columns",
      "label": "Two columns on desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "json_ld",
      "label": "Add FAQ structured data",
      "info": "Outputs schema.org FAQPage data for the questions in this section so search engines can read them. Turn it on for one FAQ section per page, and only for genuine questions whose answers match what shoppers see here.",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Example: replace with a real one"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "info": "State only what is true for your store. Delivery times, returns and guarantees must match your policies.",
          "default": "<p>Example: replace with a real one.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "settings": {
        "heading": "Frequently asked <strong>questions</strong>",
        "width": "narrow"
      },
      "blocks": [
        {
          "type": "item",
          "settings": {
            "question": "Example: How long does delivery take?",
            "answer": "<p>Example: replace this with your real delivery times by region, taken from your shipping settings. Only promise what you can meet.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Example: What is your returns policy?",
            "answer": "<p>Example: summarise your actual returns window and conditions here and link to your returns policy page.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Example: How do I track my order?",
            "answer": "<p>Example: explain where the tracking link arrives (for example in the shipping confirmation email) and how long carriers take to show updates.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Example: Can I change or cancel an order?",
            "answer": "<p>Example: say how quickly a shopper must contact you, how to reach you, and what happens once an order has shipped.</p>"
          }
        }
      ]
    }
  ],
  "disabled_on": { "groups": ["*"] }
}
{% endschema %}
