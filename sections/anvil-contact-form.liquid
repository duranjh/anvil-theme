{% render 'anvil-stylesheet', file: 'anvil-sec-contact-form.css', section: section %}
{%- liquid
  assign s = section.settings
  assign form_id = 'anvil-contact-' | append: section.id
-%}
<div {% render 'anvil-section-attrs', section: section, type: 'anvil-contact-form' %}>
  <div class="av-section__inner">
    {% render 'anvil-section-head', section: section %}
    <div class="av-contact-form">
      {%- form 'contact', id: form_id, class: 'av-contact-form__form' -%}
        {%- liquid
          assign errors_id = form_id | append: '-errors'
          assign email_invalid = false
          assign body_invalid = false
          if form.errors
            if form.errors contains 'email'
              assign email_invalid = true
            endif
            if form.errors contains 'body'
              assign body_invalid = true
            endif
          endif
        -%}
        {%- if form.posted_successfully? -%}
          <p class="av-contact-form__notice av-form-message av-form-message--success" role="status" tabindex="-1" autofocus>{{ s.success_text | escape }}</p>
        {%- elsif form.errors -%}
          <div class="av-contact-form__notice av-form-message av-form-message--error" id="{{ errors_id }}" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="av-contact-form__grid">
          <div class="av-contact-form__field av-field">
            <label class="av-field__label" for="{{ form_id }}-name">{{ 'anvil.contact_form.name' | t }}</label>
            <input class="av-field__input" id="{{ form_id }}-name" type="text" name="contact[name]" value="{{ form.name }}" autocomplete="name">
          </div>
          <div class="av-contact-form__field av-field">
            <label class="av-field__label" for="{{ form_id }}-email">{{ 'anvil.contact_form.email' | t }} <span aria-hidden="true">*</span></label>
            <input class="av-field__input" id="{{ form_id }}-email" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required aria-required="true"{% if email_invalid %} aria-invalid="true" aria-describedby="{{ errors_id }}"{% endif %}>
          </div>
          {%- if s.show_phone -%}
            <div class="av-contact-form__field av-field">
              <label class="av-field__label" for="{{ form_id }}-phone">{{ 'anvil.contact_form.phone' | t }}</label>
              <input class="av-field__input" id="{{ form_id }}-phone" type="tel" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel">
            </div>
          {%- endif -%}
          <div class="av-contact-form__field av-contact-form__field--full av-field">
            <label class="av-field__label" for="{{ form_id }}-body">{{ 'anvil.contact_form.message' | t }} <span aria-hidden="true">*</span></label>
            <textarea class="av-field__input" id="{{ form_id }}-body" name="contact[body]" rows="6" required aria-required="true"{% if body_invalid %} aria-invalid="true" aria-describedby="{{ errors_id }}"{% endif %}>{{ form.body }}</textarea>
          </div>
        </div>
        <div class="av-contact-form__actions">
          {%- assign btn_label = s.button_label | escape -%}
          {% render 'anvil-button', label: btn_label, style: 'primary', size: 'lg', type: 'submit' %}
        </div>
      {%- endform -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Bold a word to colour it with the accent" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "text_alignment", "id": "head_align", "label": "Heading alignment", "default": "center" },
    { "type": "select", "id": "head_size", "label": "Heading size", "options": [ {"value":"xs","label":"Extra small"}, {"value":"sm","label":"Small"}, {"value":"md","label":"Medium"}, {"value":"lg","label":"Large"}, {"value":"xl","label":"Extra large"} ], "default": "lg" },
    { "type": "select", "id": "accent_style", "label": "Accent style for bold words", "options": [ {"value":"color","label":"Accent colour"}, {"value":"underline","label":"Underline"}, {"value":"highlight","label":"Highlight"}, {"value":"gradient","label":"Gradient"} ], "default": "color" },
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "select", "id": "width", "label": "Width", "options": [ {"value":"page","label":"Page width"}, {"value":"narrow","label":"Narrow"}, {"value":"full","label":"Full width"} ], "default": "page" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "select", "id": "pad_mobile", "label": "Padding on phones", "options": [ {"value":"same","label":"Same as desktop"}, {"value":"compact","label":"Compact"}, {"value":"none","label":"None"} ], "default": "compact" },
    { "type": "select", "id": "reveal", "label": "Animate on scroll", "options": [ {"value":"none","label":"Off"}, {"value":"fade-up","label":"Fade up"}, {"value":"fade","label":"Fade"}, {"value":"zoom","label":"Zoom"} ], "default": "none" },
    { "type": "select", "id": "show_on", "label": "Show on", "options": [ {"value":"all","label":"All devices"}, {"value":"mobile","label":"Phones only"}, {"value":"desktop","label":"Desktop only"} ], "default": "all" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "info": "Letters, numbers and hyphens. Link to this section with #your-id" },
    { "type": "header", "content": "Contact form" },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show phone field",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Send message"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "info": "Shown after the form is sent. Promise only the reply time you can keep.",
      "default": "Thanks — your message has been sent."
    }
  ],
  "presets": [
    {
      "name": "Contact form",
      "settings": {
        "heading": "Send us a <strong>message</strong>"
      }
    }
  ],
  "disabled_on": { "groups": ["*"] }
}
{% endschema %}
