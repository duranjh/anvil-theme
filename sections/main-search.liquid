{%- liquid
  assign s = section.settings
  assign search_terms = search.terms | escape
  assign sort_by = search.sort_by | default: search.default_sort_by
  assign submit_label = 'anvil.search.submit' | t
  assign apply_label = 'anvil.facets.apply' | t
  assign show_filters = false
  if s.show_filters and search.filters.size > 0
    assign show_filters = true
  endif
  assign above_fold = false
  if section.index == nil or section.index <= 2
    assign above_fold = true
  endif
-%}
{{ 'anvil-card.css' | asset_url | stylesheet_tag }}
<div {% render 'anvil-section-attrs', section: section, type: 'main-search' %}>
  <div class="av-section__inner">
    {% render 'anvil-section-head', section: section %}
    <div class="av-search">
      <h1 class="av-search__title">
        {%- if search.performed -%}
          {{ 'anvil.search.results_count' | t: count: search.results_count }} &middot; &ldquo;{{ search_terms }}&rdquo;
        {%- else -%}
          {{ 'anvil.search.label' | t }}
        {%- endif -%}
      </h1>
      <form class="av-search__form av-field--inline" action="{{ routes.search_url }}" method="get" role="search">
        <label class="av-visually-hidden" for="anvil-search-q-{{ section.id }}">{{ 'anvil.search.placeholder' | t }}</label>
        <input class="av-field__input" id="anvil-search-q-{{ section.id }}" type="search" name="q" value="{{ search_terms }}" placeholder="{{ 'anvil.search.placeholder' | t }}" autocomplete="off">
        <input type="hidden" name="options[prefix]" value="last">
        {% render 'anvil-button', label: submit_label, style: 'primary', size: 'md', type: 'submit' %}
      </form>

      {%- if search.performed -%}
        {%- paginate search.results by s.per_page -%}
          <anvil-facets class="av-search__layout av-enhance{% if show_filters %} av-search__layout--has-filters{% endif %}" section-id="{{ section.id }}">
            {%- if show_filters or s.show_sort -%}
              <form class="av-search__facets" method="get" action="{{ routes.search_url }}" data-anvil-facets-form>
                <input type="hidden" name="q" value="{{ search_terms }}">
                <input type="hidden" name="options[prefix]" value="last">
                <div class="av-search__facets-body" data-anvil-section="{{ section.id }}-facets">
                  {%- if s.show_sort -%}
                    <div class="av-search__sort av-field">
                      <label class="av-field__label" for="anvil-search-sort-{{ section.id }}">{{ 'anvil.facets.sort_by' | t }}</label>
                      <div class="av-field__select">
                        <select class="av-field__input" id="anvil-search-sort-{{ section.id }}" name="sort_by" data-anvil-focus-key="sort">
                          {%- for option in search.sort_options -%}
                            <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
                          {%- endfor -%}
                        </select>
                      </div>
                    </div>
                  {%- endif -%}
                  {%- if show_filters -%}
                    <div class="av-search__filters">
                      {%- for filter in search.filters -%}
                        {%- for value in filter.active_values -%}
                          <a class="av-search__active" href="{{ value.url_to_remove }}" data-anvil-facets-link>{{ filter.label | escape }}: {{ value.label | escape }} <span aria-hidden="true">&times;</span><span class="av-visually-hidden">{{ 'anvil.facets.remove' | t }}</span></a>
                        {%- endfor -%}
                      {%- endfor -%}
                      {%- for filter in search.filters -%}
                        {%- assign details_key = filter.param_name | default: filter.label | handleize -%}
                        <details class="av-search__filter" data-anvil-details-key="{{ details_key }}"{% if filter.active_values.size > 0 or filter.min_value.value != nil or filter.max_value.value != nil %} open{% endif %}>
                          <summary class="av-search__filter-summary">{{ filter.label | escape }}</summary>
                          <div class="av-search__filter-body">
                            {%- case filter.type -%}
                              {%- when 'list' -%}
                                <ul class="av-search__values av-list-reset">
                                  {%- for value in filter.values -%}
                                    {%- assign value_key = value.param_name | append: '-' | append: value.value | handleize -%}
                                    <li>
                                      <label class="av-check">
                                        <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %} data-anvil-focus-key="{{ value_key }}">
                                        <span>{{ value.label | escape }} <span class="av-search__count av-muted">({{ value.count }})</span></span>
                                      </label>
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              {%- when 'price_range' -%}
                                {%- comment -%} Cents arithmetic: works for every money format, comma decimals included. {%- endcomment -%}
                                {%- assign range_max = filter.range_max | divided_by: 100.0 -%}
                                <div class="av-search__price">
                                  <label class="av-field">
                                    <span class="av-field__label">{{ 'anvil.facets.from' | t }}</span>
                                    <input class="av-field__input" type="number" name="{{ filter.min_value.param_name }}" {% if filter.min_value.value != nil %}value="{{ filter.min_value.value | divided_by: 100.0 }}"{% endif %} min="0" max="{{ range_max }}" step="0.01" placeholder="0" inputmode="decimal" data-anvil-focus-key="price-min">
                                  </label>
                                  <label class="av-field">
                                    <span class="av-field__label">{{ 'anvil.facets.to' | t }}</span>
                                    <input class="av-field__input" type="number" name="{{ filter.max_value.param_name }}" {% if filter.max_value.value != nil %}value="{{ filter.max_value.value | divided_by: 100.0 }}"{% endif %} min="0" max="{{ range_max }}" step="0.01" placeholder="{{ range_max }}" inputmode="decimal" data-anvil-focus-key="price-max">
                                  </label>
                                </div>
                              {%- when 'boolean' -%}
                                <ul class="av-search__values av-list-reset">
                                  <li>
                                    <label class="av-check">
                                      <input type="checkbox" name="{{ filter.true_value.param_name }}" value="{{ filter.true_value.value | escape }}"{% if filter.true_value.active %} checked{% endif %} data-anvil-focus-key="{{ filter.param_name | handleize }}-true">
                                      <span>{{ filter.true_value.label | escape }}</span>
                                    </label>
                                  </li>
                                  <li>
                                    <label class="av-check">
                                      <input type="checkbox" name="{{ filter.false_value.param_name }}" value="{{ filter.false_value.value | escape }}"{% if filter.false_value.active %} checked{% endif %} data-anvil-focus-key="{{ filter.param_name | handleize }}-false">
                                      <span>{{ filter.false_value.label | escape }}</span>
                                    </label>
                                  </li>
                                </ul>
                            {%- endcase -%}
                          </div>
                        </details>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>
                <div class="av-search__apply av-fallback-only">
                  {% render 'anvil-button', label: apply_label, style: 'secondary', size: 'sm', type: 'submit' %}
                </div>
              </form>
            {%- endif -%}

            <div class="av-search__results" data-anvil-section="{{ section.id }}-results">
              <h2 class="av-visually-hidden">{{ 'anvil.search.results_heading' | t }}</h2>
              <p class="av-search__summary av-muted" tabindex="-1" data-anvil-facets-count>{{ 'anvil.search.results_count' | t: count: search.results_count }}</p>
              {%- if search.results_count == 0 -%}
                <p class="av-search__empty">{{ 'anvil.search.no_results' | t: terms: search.terms }}</p>
              {%- else -%}
                <ul class="av-search__grid av-list-reset">
                  {%- for item in search.results -%}
                    {%- if item.object_type == 'product' -%}
                      {%- liquid
                        assign card_loading = 'lazy'
                        if above_fold and forloop.index <= 4
                          assign card_loading = 'eager'
                        endif
                      -%}
                      <li class="av-search__cell">
                        {% render 'anvil-product-card', product: item, show_vendor: s.show_vendor, show_rating: false, quick_add: false, image_ratio: '1:1', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw', loading: card_loading %}
                      </li>
                    {%- else -%}
                      <li class="av-search__cell av-search__cell--text">
                        <article class="av-search__card">
                          {%- if item.object_type == 'article' and item.image -%}
                            <a class="av-search__card-media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                              {% render 'anvil-media', image: item.image, ratio: '16:9', widths: '300, 450, 600', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: '', class: 'av-search__card-img' %}
                            </a>
                          {%- endif -%}
                          <p class="av-search__type av-muted">{% if item.object_type == 'article' %}{{ 'anvil.search.articles' | t }}{% else %}{{ 'anvil.search.pages' | t }}{% endif %}</p>
                          <h3 class="av-search__card-title"><a class="av-search__card-link" href="{{ item.url }}">{{ item.title | escape }}</a></h3>
                          <p class="av-search__excerpt av-muted">
                            {%- if item.object_type == 'article' -%}
                              {{ item.excerpt_or_content | strip_html | truncatewords: 30 }}
                            {%- else -%}
                              {{ item.content | strip_html | truncatewords: 30 }}
                            {%- endif -%}
                          </p>
                        </article>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              {% render 'anvil-pagination', paginate: paginate %}
            </div>
            <p class="av-visually-hidden" role="status" aria-live="polite" data-anvil-facets-live></p>
          </anvil-facets>
        {%- endpaginate -%}
        <script type="module" src="{{ 'anvil-facets.js' | asset_url }}"></script>
      {%- endif -%}
    </div>
  </div>
</div>
{% stylesheet %}
.av-search__title{margin:0 0 var(--av-space-4);font-size:var(--av-text-2xl)}
.av-search__form{max-width:640px;margin-bottom:var(--av-space-6)}
.av-search__layout{display:grid;grid-template-columns:1fr;gap:var(--av-space-5)}
.av-search__facets,.av-search__facets-body{display:flex;flex-direction:column;gap:var(--av-space-3)}
.av-search__results[aria-busy="true"]{opacity:0.6}
.av-search__summary{margin:0 0 var(--av-space-3);font-size:var(--av-text-sm)}
.av-search__filters{display:flex;flex-direction:column;gap:var(--av-space-2)}
.av-search__active{display:inline-flex;align-items:center;align-self:flex-start;gap:var(--av-space-1);min-height:28px;padding:0 var(--av-space-3);font-size:var(--av-text-xs);color:inherit;text-decoration:none;border:1px solid var(--av-border);border-radius:var(--av-radius-pill)}
.av-search__filter{border-top:1px solid var(--av-border)}
.av-search__filter-summary{padding:var(--av-space-3) 0;font-weight:600;cursor:pointer}
.av-search__filter-body{padding-bottom:var(--av-space-3)}
.av-search__values{display:flex;flex-direction:column;gap:var(--av-space-2)}
.av-search__count{font-size:var(--av-text-xs)}
.av-search__price{display:grid;grid-template-columns:1fr 1fr;gap:var(--av-space-2)}
.av-search__grid{display:grid;grid-template-columns:repeat(2, minmax(0, 1fr));gap:var(--av-grid-gap, var(--av-space-4))}
.av-search__card{display:flex;flex-direction:column;gap:var(--av-space-2);height:100%;padding:var(--av-space-4);border:var(--av-border-w-card) solid var(--av-border);border-radius:var(--av-radius-card)}
.av-search__card-media{display:block}
.av-search__type{margin:0;font-size:var(--av-text-xs);text-transform:uppercase;letter-spacing:0.08em}
.av-search__card-title{margin:0;font-size:var(--av-text-md)}
.av-search__card-link{color:inherit;text-decoration:none}
.av-search__card-link:hover{text-decoration:underline}
.av-search__excerpt{margin:0;font-size:var(--av-text-sm)}
.av-search__empty{padding:var(--av-space-8) 0;text-align:center}
@media (min-width: 750px){
.av-search__grid{grid-template-columns:repeat(3, minmax(0, 1fr))}
}
@media (min-width: 990px){
.av-search__layout--has-filters{grid-template-columns:260px minmax(0, 1fr);align-items:start}
.av-search__grid{grid-template-columns:repeat(4, minmax(0, 1fr))}
}
{% endstylesheet %}
{% schema %}
{
  "name": "Search",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "select", "id": "width", "label": "Width", "options": [ {"value":"page","label":"Page width"}, {"value":"narrow","label":"Narrow"}, {"value":"full","label":"Full width"} ], "default": "page" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "select", "id": "pad_mobile", "label": "Padding on phones", "options": [ {"value":"same","label":"Same as desktop"}, {"value":"compact","label":"Compact"}, {"value":"none","label":"None"} ], "default": "compact" },
    { "type": "header", "content": "Search" },
    {
      "type": "range",
      "id": "per_page",
      "label": "Results per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show sort menu",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show filters",
      "info": "Filters are set up in the Search & Discovery app.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor on product cards",
      "default": false
    }
  ]
}
{% endschema %}
