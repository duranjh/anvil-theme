{%- liquid
  assign s = section.settings
-%}
<div {% render 'anvil-section-attrs', section: section, type: 'main-customers-addresses' %}>
  <div class="av-section__inner">
    {% render 'anvil-section-head', section: section %}
    <div class="av-customers-addresses">
      <div class="av-customers-addresses__head">
        <h1 class="av-customers-addresses__title">{{ s.heading | escape }}</h1>
        <a class="av-customers-addresses__link" href="{{ routes.account_url }}">&larr; Back to account</a>
      </div>

      <details class="av-customers-addresses__new" id="add-address">
        <summary class="av-customers-addresses__summary">Add a new address</summary>
        {%- form 'customer_address', customer.new_address, id: 'anvil-address-new', class: 'av-customers-addresses__form' -%}
          {%- if form.errors -%}
            <div class="av-customers-addresses__notice av-form-message av-form-message--error" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="av-customers-addresses__row">
            <div class="av-customers-addresses__field av-field">
              <label class="av-customers-addresses__label av-field__label" for="anvil-address-new-first">First name</label>
              <input class="av-customers-addresses__input av-field__input" id="anvil-address-new-first" type="text" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name">
            </div>
            <div class="av-customers-addresses__field av-field">
              <label class="av-customers-addresses__label av-field__label" for="anvil-address-new-last">Last name</label>
              <input class="av-customers-addresses__input av-field__input" id="anvil-address-new-last" type="text" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name">
            </div>
          </div>
          <div class="av-customers-addresses__field av-field">
            <label class="av-customers-addresses__label av-field__label" for="anvil-address-new-company">Company</label>
            <input class="av-customers-addresses__input av-field__input" id="anvil-address-new-company" type="text" name="address[company]" value="{{ form.company }}" autocomplete="organization">
          </div>
          <div class="av-customers-addresses__field av-field">
            <label class="av-customers-addresses__label av-field__label" for="anvil-address-new-address1">Address</label>
            <input class="av-customers-addresses__input av-field__input" id="anvil-address-new-address1" type="text" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1">
          </div>
          <div class="av-customers-addresses__field av-field">
            <label class="av-customers-addresses__label av-field__label" for="anvil-address-new-address2">Apartment, suite, etc.</label>
            <input class="av-customers-addresses__input av-field__input" id="anvil-address-new-address2" type="text" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2">
          </div>
          <div class="av-customers-addresses__row">
            <div class="av-customers-addresses__field av-field">
              <label class="av-customers-addresses__label av-field__label" for="anvil-address-new-city">City</label>
              <input class="av-customers-addresses__input av-field__input" id="anvil-address-new-city" type="text" name="address[city]" value="{{ form.city }}" autocomplete="address-level2">
            </div>
            <div class="av-customers-addresses__field av-field">
              <label class="av-customers-addresses__label av-field__label" for="anvil-address-new-zip">Postal/ZIP code</label>
              <input class="av-customers-addresses__input av-field__input" id="anvil-address-new-zip" type="text" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code" autocapitalize="characters">
            </div>
          </div>
          <div class="av-customers-addresses__row">
            <div class="av-customers-addresses__field av-field">
              <label class="av-customers-addresses__label av-field__label" for="anvil-address-new-country">Country/region</label>
              <select class="av-customers-addresses__input av-field__input" id="anvil-address-new-country" name="address[country]" autocomplete="country-name" data-anvil-country data-default="{{ form.country }}">
                {{ all_country_option_tags }}
              </select>
            </div>
            <div class="av-customers-addresses__field av-field">
              <label class="av-customers-addresses__label av-field__label" for="anvil-address-new-province">Province/state</label>
              <input class="av-customers-addresses__input av-field__input" id="anvil-address-new-province" type="text" name="address[province]" value="{{ form.province }}" autocomplete="address-level1" data-anvil-province>
            </div>
          </div>
          <div class="av-customers-addresses__field av-field">
            <label class="av-customers-addresses__label av-field__label" for="anvil-address-new-phone">Phone</label>
            <input class="av-customers-addresses__input av-field__input" id="anvil-address-new-phone" type="tel" name="address[phone]" value="{{ form.phone }}" autocomplete="tel">
          </div>
          <label class="av-customers-addresses__check av-check">
            {{ form.set_as_default_checkbox }}
            <span>Set as default address</span>
          </label>
          <div class="av-customers-addresses__actions">
            {% render 'anvil-button', label: 'Add address', style: 'primary', size: 'md', type: 'submit' %}
          </div>
        {%- endform -%}
      </details>

      {%- if customer.addresses_count > 0 -%}
        <ul class="av-customers-addresses__list">
          {%- for address in customer.addresses -%}
            {%- assign addr_id = 'anvil-address-' | append: address.id -%}
            <li class="av-customers-addresses__item">
              <div class="av-customers-addresses__card">
                {%- if address == customer.default_address -%}
                  <p class="av-customers-addresses__default">Default address</p>
                {%- endif -%}
                <address class="av-customers-addresses__address">{{ address | format_address }}</address>
                <div class="av-customers-addresses__card-actions">
                  <details class="av-customers-addresses__edit">
                    <summary class="av-customers-addresses__summary av-customers-addresses__summary--small">Edit</summary>
                    {%- form 'customer_address', address, id: addr_id, class: 'av-customers-addresses__form' -%}
                      <div class="av-customers-addresses__row">
                        <div class="av-customers-addresses__field av-field">
                          <label class="av-customers-addresses__label av-field__label" for="{{ addr_id }}-first">First name</label>
                          <input class="av-customers-addresses__input av-field__input" id="{{ addr_id }}-first" type="text" name="address[first_name]" value="{{ address.first_name }}" autocomplete="given-name">
                        </div>
                        <div class="av-customers-addresses__field av-field">
                          <label class="av-customers-addresses__label av-field__label" for="{{ addr_id }}-last">Last name</label>
                          <input class="av-customers-addresses__input av-field__input" id="{{ addr_id }}-last" type="text" name="address[last_name]" value="{{ address.last_name }}" autocomplete="family-name">
                        </div>
                      </div>
                      <div class="av-customers-addresses__field av-field">
                        <label class="av-customers-addresses__label av-field__label" for="{{ addr_id }}-company">Company</label>
                        <input class="av-customers-addresses__input av-field__input" id="{{ addr_id }}-company" type="text" name="address[company]" value="{{ address.company }}" autocomplete="organization">
                      </div>
                      <div class="av-customers-addresses__field av-field">
                        <label class="av-customers-addresses__label av-field__label" for="{{ addr_id }}-address1">Address</label>
                        <input class="av-customers-addresses__input av-field__input" id="{{ addr_id }}-address1" type="text" name="address[address1]" value="{{ address.address1 }}" autocomplete="address-line1">
                      </div>
                      <div class="av-customers-addresses__field av-field">
                        <label class="av-customers-addresses__label av-field__label" for="{{ addr_id }}-address2">Apartment, suite, etc.</label>
                        <input class="av-customers-addresses__input av-field__input" id="{{ addr_id }}-address2" type="text" name="address[address2]" value="{{ address.address2 }}" autocomplete="address-line2">
                      </div>
                      <div class="av-customers-addresses__row">
                        <div class="av-customers-addresses__field av-field">
                          <label class="av-customers-addresses__label av-field__label" for="{{ addr_id }}-city">City</label>
                          <input class="av-customers-addresses__input av-field__input" id="{{ addr_id }}-city" type="text" name="address[city]" value="{{ address.city }}" autocomplete="address-level2">
                        </div>
                        <div class="av-customers-addresses__field av-field">
                          <label class="av-customers-addresses__label av-field__label" for="{{ addr_id }}-zip">Postal/ZIP code</label>
                          <input class="av-customers-addresses__input av-field__input" id="{{ addr_id }}-zip" type="text" name="address[zip]" value="{{ address.zip }}" autocomplete="postal-code" autocapitalize="characters">
                        </div>
                      </div>
                      <div class="av-customers-addresses__row">
                        <div class="av-customers-addresses__field av-field">
                          <label class="av-customers-addresses__label av-field__label" for="{{ addr_id }}-country">Country/region</label>
                          <select class="av-customers-addresses__input av-field__input" id="{{ addr_id }}-country" name="address[country]" autocomplete="country-name" data-anvil-country data-default="{{ address.country }}">
                            {{ all_country_option_tags }}
                          </select>
                        </div>
                        <div class="av-customers-addresses__field av-field">
                          <label class="av-customers-addresses__label av-field__label" for="{{ addr_id }}-province">Province/state</label>
                          <input class="av-customers-addresses__input av-field__input" id="{{ addr_id }}-province" type="text" name="address[province]" value="{{ address.province }}" autocomplete="address-level1" data-anvil-province>
                        </div>
                      </div>
                      <div class="av-customers-addresses__field av-field">
                        <label class="av-customers-addresses__label av-field__label" for="{{ addr_id }}-phone">Phone</label>
                        <input class="av-customers-addresses__input av-field__input" id="{{ addr_id }}-phone" type="tel" name="address[phone]" value="{{ address.phone }}" autocomplete="tel">
                      </div>
                      <label class="av-customers-addresses__check av-check">
                        {{ form.set_as_default_checkbox }}
                        <span>Set as default address</span>
                      </label>
                      <div class="av-customers-addresses__actions">
                        {% render 'anvil-button', label: 'Save address', style: 'primary', size: 'md', type: 'submit' %}
                      </div>
                    {%- endform -%}
                  </details>
                  <form method="post" action="{{ address.url }}" class="av-customers-addresses__delete" data-anvil-confirm="Delete this address?">
                    <input type="hidden" name="_method" value="delete">
                    {% render 'anvil-button', label: 'Delete', style: 'link', size: 'sm', type: 'submit' %}
                  </form>
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class="av-customers-addresses__empty">No saved addresses yet.</p>
      {%- endif -%}
    </div>
  </div>
</div>
{% stylesheet %}
  .av-customers-addresses {
    max-width: 900px;
    margin: 0 auto;
  }
  .av-customers-addresses__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--av-space-3);
    margin-bottom: var(--av-space-5);
  }
  .av-customers-addresses__title {
    margin: 0;
    font-size: var(--av-text-3xl);
  }
  .av-customers-addresses__link {
    color: inherit;
    text-underline-offset: 0.2em;
  }
  .av-customers-addresses__new {
    margin-bottom: var(--av-space-6);
    padding: var(--av-space-4);
    border: var(--av-border-w-card) solid var(--av-border);
    border-radius: var(--av-radius-card);
  }
  .av-customers-addresses__summary {
    font-weight: 600;
    cursor: pointer;
    min-height: 24px;
  }
  .av-customers-addresses__summary--small {
    font-size: var(--av-text-sm);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    list-style: none;
  }
  .av-customers-addresses__summary--small::-webkit-details-marker {
    display: none;
  }
  .av-customers-addresses__form {
    display: flex;
    flex-direction: column;
    gap: var(--av-space-3);
    margin-top: var(--av-space-4);
  }
  .av-customers-addresses__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--av-space-3);
  }
  
  
  
  
  
  .av-customers-addresses__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--av-space-4);
  }
  .av-customers-addresses__card {
    padding: var(--av-space-4);
    border: var(--av-border-w-card) solid var(--av-border);
    border-radius: var(--av-radius-card);
  }
  .av-customers-addresses__default {
    margin: 0 0 var(--av-space-2);
    font-size: var(--av-text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--av-fg-muted);
  }
  .av-customers-addresses__address {
    font-style: normal;
    margin: 0 0 var(--av-space-3);
  }
  .av-customers-addresses__card-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--av-space-4);
  }
  .av-customers-addresses__edit {
    flex: 1 1 100%;
  }
  .av-customers-addresses__edit[open] {
    order: 2;
  }
  .av-customers-addresses__empty {
    color: var(--av-fg-muted);
  }
  @media (min-width: 480px) {
    .av-customers-addresses__row {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 750px) {
    .av-customers-addresses__list {
      grid-template-columns: 1fr 1fr;
    }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Customer addresses",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "select", "id": "width", "label": "Width", "options": [ {"value":"page","label":"Page width"}, {"value":"narrow","label":"Narrow"}, {"value":"full","label":"Full width"} ], "default": "page" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "select", "id": "pad_mobile", "label": "Padding on phones", "options": [ {"value":"same","label":"Same as desktop"}, {"value":"compact","label":"Compact"}, {"value":"none","label":"None"} ], "default": "compact" },
    { "type": "header", "content": "Customer addresses" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Addresses"
    }
  ]
}
{% endschema %}
