{{ 'anvil-sec-logo-list.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign total = section.blocks.size

  assign is_marquee = false
  if s.layout == 'marquee'
    assign is_marquee = true
  endif

  assign h_d = s.logo_height | default: 40
  assign h_m = s.logo_height_mobile | default: 32
  # One width cap for both sizes, but never wider than 200 px on phones, so a
  # logo on a tile still fits a 320 px screen.
  assign max_w_d = s.logo_max_width | default: 160
  assign max_w_m = max_w_d | at_most: 200
  assign gap = 48
  if s.gap != nil
    assign gap = s.gap
  endif
  assign opacity = s.logo_opacity | default: 100
  assign opacity_css = opacity | divided_by: 100.0
  assign speed = s.speed | default: 40
  assign direction = s.direction | default: 'left'

  # The logo row lines up with the heading.
  case s.head_align
    when 'left'
      assign justify = 'flex-start'
    when 'right'
      assign justify = 'flex-end'
    else
      assign justify = 'center'
  endcase

  assign root_class = 'av-logo-list'
  assign root_style = '--av-logo-list-h-d: ' | append: h_d | append: 'px; --av-logo-list-h-m: ' | append: h_m | append: 'px; --av-logo-list-max-w-d: ' | append: max_w_d | append: 'px; --av-logo-list-max-w-m: ' | append: max_w_m | append: 'px; --av-logo-list-gap: ' | append: gap | append: 'px; --av-logo-list-opacity: ' | append: opacity_css | append: '; --av-logo-list-justify: ' | append: justify | append: ';'

  if is_marquee
    assign root_class = root_class | append: ' av-logo-list--marquee'
    # Full width lets the moving strip run edge to edge. A static strip (animations off in Theme settings, reduced
    # motion, no JavaScript) keeps the gutter: the stylesheet takes the bleed back then, so one render serves all.
    if s.width == 'full'
      assign root_class = root_class | append: ' av-logo-list--bleed'
    endif
  else
    # Fixed columns use a grid; "fit" is a wrapping row that fits the width. Tablets follow the shared grid rule
    # (up to 3, 4 become 2, 8 become 4).
    assign cols_m = s.cols_mobile | default: 'fit'
    assign cols_d = s.cols_desktop | default: 'fit'
    if cols_m != 'fit'
      assign root_class = root_class | append: ' av-logo-list--gm'
      assign root_style = root_style | append: ' --av-logo-list-cm: ' | append: cols_m | append: ';'
    endif
    if cols_d != 'fit'
      assign cols_dn = cols_d | plus: 0
      assign cols_t = cols_dn | at_most: 3
      if cols_dn == 4
        assign cols_t = 2
      elsif cols_dn == 8
        assign cols_t = 4
      endif
      assign root_class = root_class | append: ' av-logo-list--gd'
      assign root_style = root_style | append: ' --av-logo-list-ct: ' | append: cols_t | append: '; --av-logo-list-cd: ' | append: cols_d | append: ';'
      # 6 or 8 columns: narrower tile padding on desktop, so the logo keeps its room.
      if cols_d == '6' or cols_d == '8'
        assign root_class = root_class | append: ' av-logo-list--dense'
      endif
    elsif cols_m != 'fit'
      assign root_class = root_class | append: ' av-logo-list--fd'
    endif
  endif

  if s.tiles
    assign root_class = root_class | append: ' av-logo-list--tiles'
  endif
  if s.greyscale
    assign root_class = root_class | append: ' av-logo-list--grey'
  endif
  if s.colour_hover
    if s.greyscale or opacity < 100
      assign root_class = root_class | append: ' av-logo-list--hover'
    endif
  endif
  # The first eight logos load eagerly only in the first two template sections (snippets/anvil-above-fold).
  capture fold
    render 'anvil-above-fold', section: section
  endcapture
  assign eager_ok = true
  if fold contains 'lazy'
    assign eager_ok = false
  endif

  assign new_tab_label = 'anvil.a11y.new_window' | t
  assign has_placeholder = false
  assign has_unlinked = false
-%}
{%- if total > 0 or request.design_mode -%}
<div {% render 'anvil-section-attrs', section: section, type: 'anvil-logo-list' %}>
  <div class="av-section__inner">
    {% render 'anvil-section-head', section: section %}
    {%- if total > 0 -%}
      {%- capture items -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings

            assign alt = b.alt | strip
            if alt == blank and b.image != blank
              assign alt = b.image.alt | strip
            endif

            # A link needs a name, so the logo becomes a link only when it has alt text.
            assign tag = 'div'
            if b.link != blank and b.image != blank
              if alt != blank
                assign tag = 'a'
              else
                assign has_unlinked = true
              endif
            endif

            if b.image != blank
              # Display width = height x aspect ratio, capped by the width setting.
              # The srcset holds the phone width, the desktop width and twice the
              # desktop width (sharp on high-density screens), never above the original.
              assign ar = b.image.aspect_ratio | default: 1
              assign w_d = h_d | times: ar | ceil | at_most: max_w_d
              assign w_m = h_m | times: ar | ceil | at_most: max_w_m
              assign w_2 = w_d | times: 2
              if b.image.width != blank
                assign w_2 = w_2 | at_most: b.image.width
              endif
              assign widths = ''
              if w_m < w_2
                assign widths = w_m | append: ', '
              endif
              if w_d > w_m and w_d < w_2
                assign widths = widths | append: w_d | append: ', '
              endif
              assign widths = widths | append: w_2
              assign sizes = '(min-width: 750px) ' | append: w_d | append: 'px, ' | append: w_m | append: 'px'

              assign img_loading = 'lazy'
              if eager_ok and forloop.index <= 8
                assign img_loading = 'eager'
              endif
            else
              assign has_placeholder = true
            endif
          -%}
          {%- comment -%} A placeholder stays visible but is hidden from screen readers, so the list never announces empty items. {%- endcomment -%}
          <li class="av-logo-list__item{% if s.tiles %} av-surface av-surface--outlined av-surface--tinted{% endif %}"{% if b.image == blank %} aria-hidden="true"{% endif %} {{ block.shopify_attributes }}>
            {%- if b.image != blank -%}
              <{{ tag }} class="av-logo-list__logo"{% if tag == 'a' %} href="{{ b.link }}"{% if b.new_tab %} target="_blank" rel="noopener"{% endif %}{% endif %}>
                {{- b.image | image_url: width: w_2 | image_tag: widths: widths, sizes: sizes, loading: img_loading, alt: alt, class: 'av-logo-list__img' -}}
                {%- if tag == 'a' and b.new_tab -%}
                  <span class="av-visually-hidden"> {{ new_tab_label }}</span>
                {%- endif -%}
              </{{ tag }}>
            {%- else -%}
              <div class="av-logo-list__logo">
                {{- 'image' | placeholder_svg_tag: 'av-logo-list__ph' -}}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      {%- endcapture -%}
      <div class="{{ root_class }}" style="{{ root_style }}">
        {%- if is_marquee -%}
          {{ 'anvil-marquee.css' | asset_url | stylesheet_tag }}
          <anvil-marquee class="av-logo-list__strip" speed="{{ speed }}" direction="{{ direction }}"{% if s.pause_hover %} pause-on-hover{% endif %} style="--av-marquee-gap: {{ gap }}px;">
            <ul class="av-logo-list__track" role="list" data-marquee-track>
              {{- items -}}
            </ul>
          </anvil-marquee>
          <script type="module" src="{{ 'anvil-marquee.js' | asset_url }}"></script>
        {%- else -%}
          <ul class="av-logo-list__grid" role="list">
            {{- items -}}
          </ul>
        {%- endif -%}
      </div>
      {%- if has_placeholder and request.design_mode -%}
        <p class="av-logo-list__note av-example-note">{{ 'anvil.editor.example_content' | t }}</p>
      {%- endif -%}
      {%- if has_unlinked and request.design_mode -%}
        <p class="av-logo-list__note av-example-note">{{ 'anvil.editor.logo_link_needs_alt' | t }}</p>
      {%- endif -%}
    {%- else -%}
      {% render 'anvil-editor-empty' %}
    {%- endif -%}
  </div>
</div>
{%- endif -%}
{% schema %}
{
  "name": "Logo list",
  "max_blocks": 16,
  "disabled_on": { "groups": ["header", "custom.overlay"] },
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Bold a word to colour it with the accent" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "text_alignment", "id": "head_align", "label": "Heading alignment", "default": "center" },
    { "type": "select", "id": "head_size", "label": "Heading size", "options": [ {"value":"xs","label":"Extra small"}, {"value":"sm","label":"Small"}, {"value":"md","label":"Medium"}, {"value":"lg","label":"Large"}, {"value":"xl","label":"Extra large"} ], "default": "lg" },
    { "type": "select", "id": "accent_style", "label": "Accent style for bold words", "options": [ {"value":"color","label":"Accent colour"}, {"value":"underline","label":"Underline"}, {"value":"highlight","label":"Highlight"}, {"value":"gradient","label":"Gradient"} ], "default": "color" },
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "select", "id": "width", "label": "Width", "options": [ {"value":"page","label":"Page width"}, {"value":"narrow","label":"Narrow"}, {"value":"full","label":"Full width"} ], "default": "page" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "select", "id": "pad_mobile", "label": "Padding on phones", "options": [ {"value":"same","label":"Same as desktop"}, {"value":"compact","label":"Compact"}, {"value":"none","label":"None"} ], "default": "compact" },
    { "type": "select", "id": "reveal", "label": "Animate on scroll", "options": [ {"value":"none","label":"Off"}, {"value":"fade-up","label":"Fade up"}, {"value":"fade","label":"Fade"}, {"value":"zoom","label":"Zoom"} ], "default": "none" },
    { "type": "select", "id": "show_on", "label": "Show on", "options": [ {"value":"all","label":"All devices"}, {"value":"mobile","label":"Phones only"}, {"value":"desktop","label":"Desktop only"} ], "default": "all" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "info": "Letters, numbers and hyphens. Link to this section with #your-id" },
    { "type": "header", "content": "Logo list" },
    { "type": "paragraph", "content": "Show a logo only where it is true: the outlet really featured you, the store really stocks you or the partner really works with you, and you have permission to display their logo. A heading such as \"As featured in\" is a claim too." },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Row or grid" },
        { "value": "marquee", "label": "Scrolling strip" }
      ],
      "default": "grid",
      "info": "The strip always has a pause button, and it stands still for shoppers whose device asks for less motion or when animations are off in Theme settings."
    },
    {
      "type": "select",
      "id": "cols_mobile",
      "label": "Columns on phones",
      "options": [
        { "value": "fit", "label": "Fit to width" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "fit",
      "visible_if": "{{ section.settings.layout == 'grid' }}"
    },
    {
      "type": "select",
      "id": "cols_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "fit", "label": "Fit to width" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" },
        { "value": "8", "label": "8" }
      ],
      "default": "fit",
      "info": "Fit to width wraps the logos onto more lines when they do not fit on one. Tablets show up to 3; 4 columns become 2 and 8 become 4.",
      "visible_if": "{{ section.settings.layout == 'grid' }}"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Speed",
      "min": 10,
      "max": 150,
      "step": 10,
      "unit": "px",
      "default": 40,
      "info": "Pixels per second.",
      "visible_if": "{{ section.settings.layout == 'marquee' }}"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        { "value": "left", "label": "Right to left" },
        { "value": "right", "label": "Left to right" }
      ],
      "default": "left",
      "visible_if": "{{ section.settings.layout == 'marquee' }}"
    },
    {
      "type": "checkbox",
      "id": "pause_hover",
      "label": "Pause on hover",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'marquee' }}"
    },
    { "type": "header", "content": "Logos" },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "label": "Logo height on phones",
      "min": 16,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "label": "Maximum logo width",
      "min": 60,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 160,
      "info": "Fits wide wordmarks inside this width so every logo carries a similar weight. Phones cap it at 200 px."
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between logos",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 48,
      "info": "Phones use half of it in a row or grid."
    },
    {
      "type": "checkbox",
      "id": "greyscale",
      "label": "Show logos in greyscale",
      "default": true
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "label": "Logo opacity",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "colour_hover",
      "label": "Show full colour on hover",
      "default": true,
      "info": "Removes the greyscale and the fade on devices with a mouse, and on a linked logo while it has keyboard focus.",
      "visible_if": "{{ section.settings.greyscale == true or section.settings.logo_opacity < 100 }}"
    },
    {
      "type": "checkbox",
      "id": "tiles",
      "label": "Show each logo on a tile",
      "default": false,
      "info": "Uses the card border and corner radius from Theme settings."
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "limit": 16,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo",
          "info": "Upload only a logo you are entitled to show, from an outlet, store or partner that really featured, stocks or works with you. A transparent background works best."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text",
          "info": "The brand's name. Screen readers read it, and a linked logo uses it as the link's name. Leave blank to use the alt text saved with the image."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional. Link the article, listing or page that backs the mention so shoppers can check it. The logo becomes a link only when it has alt text."
        },
        {
          "type": "checkbox",
          "id": "new_tab",
          "label": "Open the link in a new tab",
          "default": false,
          "visible_if": "{{ block.settings.link != blank }}"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo list",
      "settings": {
        "heading": "Example: as <strong>featured in</strong>",
        "head_size": "sm",
        "pad_top": 32,
        "pad_bottom": 32
      },
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    },
    {
      "name": "Scrolling logos",
      "settings": {
        "heading": "Example: as <strong>featured in</strong>",
        "head_size": "sm",
        "layout": "marquee",
        "width": "full",
        "pad_top": 32,
        "pad_bottom": 32
      },
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
