{% render 'anvil-stylesheet', file: 'anvil-sec-main-customers-order.css', section: section %}
{%- liquid
  assign s = section.settings
-%}
<div {% render 'anvil-section-attrs', section: section, type: 'main-customers-order' %}>
  <div class="av-section__inner">
    {% render 'anvil-section-head', section: section %}
    <div class="av-customers-order">
      <div class="av-customers-order__head">
        <div>
          <h1 class="av-customers-order__title">{{ s.heading_prefix | escape }} {{ order.name }}</h1>
          <p class="av-customers-order__meta">
            {%- capture placed_date -%}{{ order.created_at | time_tag: format: 'anvil_date' }}{%- endcapture -%}
            {{ 'anvil.customer.order.placed_html' | t: date: placed_date }}
            {%- if order.cancelled -%}
              {%- capture cancelled_date -%}{{ order.cancelled_at | time_tag: format: 'anvil_date' }}{%- endcapture %}
              &middot; {{ 'anvil.customer.order.cancelled_html' | t: date: cancelled_date }}
              {%- if order.cancel_reason_label != blank %} ({{ order.cancel_reason_label }}){% endif -%}
            {%- endif -%}
          </p>
        </div>
        <div class="av-customers-order__links">
          {%- if order.order_status_url != blank -%}
            <a class="av-customers-order__link" href="{{ order.order_status_url }}">{{ 'anvil.customer.order.track' | t }}</a>
          {%- endif -%}
          <a class="av-customers-order__link" href="{{ routes.account_url }}"><span aria-hidden="true">&larr;</span> {{ 'anvil.customer.back_to_account' | t }}</a>
        </div>
      </div>

      <div class="av-customers-order__layout">
        <div class="av-customers-order__items">
          <table class="av-customers-order__table" role="table">
            <caption class="av-visually-hidden">{{ 'anvil.customer.order.items_caption' | t: order: order.name }}</caption>
            <thead class="av-customers-order__thead" role="rowgroup">
              <tr role="row">
                <th scope="col" role="columnheader">{{ 'anvil.customer.order.product' | t }}</th>
                <th scope="col" role="columnheader">{{ 'anvil.customer.order.sku' | t }}</th>
                <th scope="col" role="columnheader">{{ 'anvil.customer.order.price' | t }}</th>
                <th scope="col" role="columnheader">{{ 'anvil.customer.order.quantity' | t }}</th>
                <th scope="col" role="columnheader" class="av-customers-order__num">{{ 'anvil.customer.order.total' | t }}</th>
              </tr>
            </thead>
            <tbody role="rowgroup">
              {%- for line_item in order.line_items -%}
                <tr role="row">
                  <td role="cell">
                    <span class="av-customers-order__cell-label" aria-hidden="true">{{ 'anvil.customer.order.product' | t }}</span>
                    {%- if line_item.product.url != blank -%}
                      <a class="av-customers-order__link" href="{{ line_item.product.url }}">{{ line_item.title | escape }}</a>
                    {%- else -%}
                      {{ line_item.title | escape }}
                    {%- endif -%}
                    {%- for property in line_item.properties -%}
                      {%- assign prop_first = property.first | slice: 0 -%}
                      {%- if property.last != blank and prop_first != '_' -%}
                        <p class="av-customers-order__small">{{ property.first | escape }}: {{ property.last | escape }}</p>
                      {%- endif -%}
                    {%- endfor -%}
                    {%- if line_item.fulfillment -%}
                      <p class="av-customers-order__small">
                        {{ 'anvil.customer.order.shipped' | t }}
                        {%- if line_item.fulfillment.tracking_number != blank %} &middot; {{ line_item.fulfillment.tracking_company }}
                          {%- if line_item.fulfillment.tracking_url != blank %} <a class="av-customers-order__link" href="{{ line_item.fulfillment.tracking_url }}">{{ line_item.fulfillment.tracking_number }}</a>{% else %} {{ line_item.fulfillment.tracking_number }}{% endif -%}
                        {%- endif -%}
                      </p>
                    {%- endif -%}
                  </td>
                  <td role="cell"><span class="av-customers-order__cell-label" aria-hidden="true">{{ 'anvil.customer.order.sku' | t }}</span>{{ line_item.sku }}</td>
                  <td role="cell">
                    <span class="av-customers-order__cell-label" aria-hidden="true">{{ 'anvil.customer.order.price' | t }}</span>
                    {%- if line_item.original_price != line_item.final_price -%}<s><span class="av-visually-hidden">{{ 'anvil.price.regular_price' | t }}</span> {% render 'anvil-money', amount: line_item.original_price %}</s> <span class="av-visually-hidden">{{ 'anvil.price.sale_price' | t }}</span> {% endif -%}
                    {% render 'anvil-money', amount: line_item.final_price %}
                  </td>
                  <td role="cell"><span class="av-customers-order__cell-label" aria-hidden="true">{{ 'anvil.customer.order.quantity' | t }}</span>{{ line_item.quantity }}</td>
                  <td role="cell" class="av-customers-order__num"><span class="av-customers-order__cell-label" aria-hidden="true">{{ 'anvil.customer.order.total' | t }}</span>{% render 'anvil-money', amount: line_item.final_line_price %}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>

          <dl class="av-customers-order__totals">
            <div class="av-customers-order__total-row">
              <dt>{{ 'anvil.customer.order.subtotal' | t }}</dt>
              <dd>{% render 'anvil-money', amount: order.line_items_subtotal_price %}</dd>
            </div>
            {%- if order.total_discounts > 0 -%}
              <div class="av-customers-order__total-row">
                <dt>{{ 'anvil.customer.order.discounts' | t }}</dt>
                <dd>&minus;{% render 'anvil-money', amount: order.total_discounts %}</dd>
              </div>
            {%- endif -%}
            {%- for shipping_method in order.shipping_methods -%}
              <div class="av-customers-order__total-row">
                <dt>{{ 'anvil.customer.order.shipping_method' | t: method: shipping_method.title }}</dt>
                <dd>{% render 'anvil-money', amount: shipping_method.price %}</dd>
              </div>
            {%- endfor -%}
            {%- for tax_line in order.tax_lines -%}
              <div class="av-customers-order__total-row">
                <dt>{{ tax_line.title | escape }} ({{ tax_line.rate_percentage }}%)</dt>
                <dd>{% render 'anvil-money', amount: tax_line.price %}</dd>
              </div>
            {%- endfor -%}
            {%- if order.total_duties > 0 -%}
              <div class="av-customers-order__total-row">
                <dt>{{ 'anvil.customer.order.duties' | t }}</dt>
                <dd>{% render 'anvil-money', amount: order.total_duties %}</dd>
              </div>
            {%- endif -%}
            <div class="av-customers-order__total-row av-customers-order__total-row--grand">
              <dt>{{ 'anvil.customer.order.total' | t }}</dt>
              <dd>{{ order.total_price | money_with_currency }}</dd>
            </div>
            {%- if order.total_refunded_amount > 0 -%}
              <div class="av-customers-order__total-row">
                <dt>{{ 'anvil.customer.order.refunded' | t }}</dt>
                <dd>&minus;{% render 'anvil-money', amount: order.total_refunded_amount %}</dd>
              </div>
            {%- endif -%}
          </dl>
        </div>

        <aside class="av-customers-order__aside">
          <section class="av-customers-order__block" aria-labelledby="anvil-order-payment">
            <h2 class="av-customers-order__subtitle" id="anvil-order-payment">{{ 'anvil.customer.order.payment' | t }}</h2>
            <p class="av-customers-order__status">{{ order.financial_status_label }}</p>
            {%- if order.billing_address -%}
              <address class="av-customers-order__address">{{ order.billing_address | format_address }}</address>
            {%- endif -%}
          </section>
          <section class="av-customers-order__block" aria-labelledby="anvil-order-shipping">
            <h2 class="av-customers-order__subtitle" id="anvil-order-shipping">{{ 'anvil.customer.order.shipping' | t }}</h2>
            <p class="av-customers-order__status">{{ order.fulfillment_status_label }}</p>
            {%- if order.shipping_address -%}
              <address class="av-customers-order__address">{{ order.shipping_address | format_address }}</address>
            {%- endif -%}
          </section>
          {%- if order.note != blank -%}
            <section class="av-customers-order__block" aria-labelledby="anvil-order-note">
              <h2 class="av-customers-order__subtitle" id="anvil-order-note">{{ 'anvil.customer.order.note' | t }}</h2>
              <p class="av-customers-order__status">{{ order.note | escape }}</p>
            </section>
          {%- endif -%}
        </aside>
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Customer order",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "select", "id": "width", "label": "Width", "options": [ {"value":"page","label":"Page width"}, {"value":"narrow","label":"Narrow"}, {"value":"full","label":"Full width"} ], "default": "page" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "select", "id": "pad_mobile", "label": "Padding on phones", "options": [ {"value":"same","label":"Same as desktop"}, {"value":"compact","label":"Compact"}, {"value":"none","label":"None"} ], "default": "compact" },
    { "type": "header", "content": "Customer order" },
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Heading prefix",
      "info": "Shown before the order number.",
      "default": "Order"
    }
  ]
}
{% endschema %}
