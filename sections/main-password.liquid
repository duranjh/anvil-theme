{%- liquid
  assign s = section.settings
  assign logo = settings.logo
-%}
<div {% render 'anvil-section-attrs', section: section, type: 'main-password' %}>
  <div class="av-section__inner">
    {% render 'anvil-section-head', section: section %}
    <div class="av-password">
      <div class="av-password__brand">
        {%- if logo != blank -%}
          {%- assign pw_logo_height = 200 | divided_by: logo.aspect_ratio | round -%}
          {{ logo | image_url: width: 400 | image_tag: widths: '200, 400', sizes: '200px', width: 200, height: pw_logo_height, loading: 'eager', alt: shop.name }}
        {%- else -%}
          <p class="av-password__shop">{{ shop.name }}</p>
        {%- endif -%}
      </div>
      <h1 class="av-password__title">{{ s.heading | escape }}</h1>
      {%- if shop.password_message != blank -%}
        <div class="av-password__message">{{ shop.password_message }}</div>
      {%- elsif s.text != blank -%}
        <div class="av-password__message">{{ s.text }}</div>
      {%- endif -%}

      <details class="av-password__gate" id="password-form">
        <summary class="av-password__gate-summary">{{ s.enter_label | escape }}</summary>
        {%- form 'storefront_password', class: 'av-password__form' -%}
          {%- if form.errors -%}
            <div class="av-password__errors av-form-message av-form-message--error" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <label class="av-visually-hidden" for="anvil-password-input">Password</label>
          <div class="av-password__row">
            <input class="av-password__input av-field__input" id="anvil-password-input" type="password" name="password" placeholder="Password" autocomplete="current-password" required>
            {% render 'anvil-button', label: 'Enter', style: 'primary', size: 'md', type: 'submit' %}
          </div>
        {%- endform -%}
      </details>

      <p class="av-password__owner">Are you the store owner? <a class="av-password__owner-link" href="{{ shop.url }}/admin">Log in here</a></p>
    </div>
  </div>
</div>
{% stylesheet %}
  .av-password {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--av-space-4);
    min-height: 60vh;
    justify-content: center;
    text-align: center;
  }
  .av-password__brand img {
    display: block;
    width: 200px;
    height: auto;
    margin: 0 auto;
  }
  .av-password__shop {
    margin: 0;
    font-family: var(--av-font-heading);
    font-size: var(--av-text-xl);
    font-weight: var(--av-heading-weight);
  }
  .av-password__title {
    margin: 0;
    font-size: var(--av-text-3xl);
  }
  .av-password__message {
    max-width: 55ch;
    color: var(--av-fg-muted);
  }
  .av-password__gate {
    margin-top: var(--av-space-3);
  }
  .av-password__gate-summary {
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    list-style: none;
    display: inline-block;
    padding: var(--av-space-2) var(--av-space-3);
  }
  .av-password__gate-summary::-webkit-details-marker {
    display: none;
  }
  .av-password__form {
    margin-top: var(--av-space-3);
  }
  .av-password__row {
    display: flex;
    gap: var(--av-space-2);
    justify-content: center;
  }
  
  
  .av-password__owner {
    margin: var(--av-space-6) 0 0;
    font-size: var(--av-text-xs);
    color: var(--av-fg-muted);
  }
  .av-password__owner-link {
    color: inherit;
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "select", "id": "width", "label": "Width", "options": [ {"value":"page","label":"Page width"}, {"value":"narrow","label":"Narrow"}, {"value":"full","label":"Full width"} ], "default": "page" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "select", "id": "pad_mobile", "label": "Padding on phones", "options": [ {"value":"same","label":"Same as desktop"}, {"value":"compact","label":"Compact"}, {"value":"none","label":"None"} ], "default": "compact" },
    { "type": "header", "content": "Password page" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Opening soon"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Fallback text",
      "info": "Shown only when no password message is set under Online Store > Preferences.",
      "default": "<p>Example text — we are putting the finishing touches on the store.</p>"
    },
    {
      "type": "text",
      "id": "enter_label",
      "label": "Password link label",
      "default": "Enter using password"
    }
  ]
}
{% endschema %}
