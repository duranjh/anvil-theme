{% render 'anvil-stylesheet', file: 'anvil-sec-main-password.css', section: section %}
{%- liquid
  assign s = section.settings
  assign logo = settings.logo
  assign enter_label = 'anvil.password.submit' | t
  comment
    Shopify has no route object for the admin; the store owner's login lives under the shop's own domain.
  endcomment
  assign admin_url = shop.url | append: '/admin'
  capture password_form
    form 'storefront_password', class: 'av-password__form'
      if form.errors
        echo '<div class="av-password__errors av-form-message av-form-message--error" id="anvil-password-errors" role="alert">'
        echo form.errors | default_errors
        echo '</div>'
      endif
      echo '<label class="av-visually-hidden" for="anvil-password-input">'
      echo 'anvil.password.label' | t
      echo '</label><div class="av-password__row"><input class="av-password__input av-field__input" id="anvil-password-input" type="password" name="password" placeholder="'
      echo 'anvil.password.placeholder' | t
      echo '" autocomplete="current-password" required'
      if form.errors
        echo ' aria-invalid="true" aria-describedby="anvil-password-errors"'
      endif
      echo '>'
      render 'anvil-button', label: enter_label, style: 'primary', size: 'md', type: 'submit'
      echo '</div>'
    endform
  endcapture
-%}
<div {% render 'anvil-section-attrs', section: section, type: 'main-password' %}>
  <div class="av-section__inner">
    {% render 'anvil-section-head', section: section %}
    <div class="av-password">
      <div class="av-password__brand">
        {%- if logo != blank -%}
          {%- assign pw_logo_height = 200 | divided_by: logo.aspect_ratio | round -%}
          {{ logo | image_url: width: 400 | image_tag: widths: '200, 400', sizes: '200px', width: 200, height: pw_logo_height, loading: 'eager', alt: shop.name }}
        {%- else -%}
          <p class="av-password__shop">{{ shop.name }}</p>
        {%- endif -%}
      </div>
      <h1 class="av-password__title">{{ s.title | escape }}</h1>
      {%- if shop.password_message != blank -%}
        <div class="av-password__message">{{ shop.password_message }}</div>
      {%- elsif s.text != blank -%}
        <div class="av-password__message">{{ s.text }}</div>
      {%- endif -%}

      {%- comment -%} After a wrong password the disclosure opens itself so the error is seen. {%- endcomment -%}
      <details class="av-password__gate" id="anvil-password-form"{% if password_form contains 'av-password__errors' %} open{% endif %}>
        <summary class="av-password__gate-summary">{{ s.enter_label | escape }}</summary>
        {{ password_form }}
      </details>

      <p class="av-password__owner">{{ 'anvil.password.owner' | t }} <a class="av-password__owner-link" href="{{ admin_url }}">{{ 'anvil.password.owner_link' | t }}</a></p>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "select", "id": "width", "label": "Width", "options": [ {"value":"page","label":"Page width"}, {"value":"narrow","label":"Narrow"}, {"value":"full","label":"Full width"} ], "default": "page" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "select", "id": "pad_mobile", "label": "Padding on phones", "options": [ {"value":"same","label":"Same as desktop"}, {"value":"compact","label":"Compact"}, {"value":"none","label":"None"} ], "default": "compact" },
    { "type": "header", "content": "Password page" },
    {
      "type": "text",
      "id": "title",
      "label": "Page title",
      "default": "Opening soon"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Fallback text",
      "info": "Shown only when no password message is set under Online Store > Preferences.",
      "default": "<p>Example: we are putting the finishing touches on the store.</p>"
    },
    {
      "type": "text",
      "id": "enter_label",
      "label": "Password link label",
      "default": "Enter using password"
    }
  ]
}
{% endschema %}
