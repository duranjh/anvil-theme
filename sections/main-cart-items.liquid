{%- comment -%}
  Cart page lines. Each line is snippets/anvil-cart-line.liquid, the same markup the cart drawer uses, inside a plain
  <form> that posts updates[<line key>] to the cart, so the page works without JavaScript; <anvil-cart-form
  cart-id="page"> (assets/anvil-cart.js) adds steppers, typed quantities, removal without a reload and gift-line
  handling. Line styles come from assets/anvil-cart-drawer.css (shared with the drawer).
  The summary section (main-cart-footer) points its note, policies checkbox and checkout button at this form with
  form="anvil-cart-form"; Update skips validation (formnovalidate), so an unticked required policies box blocks only checkout.
  When a line carries the _anvil_gift property, the gift engine (assets/anvil-gifts.js) loads here too: with
  Theme settings > Cart type "Page" no drawer exists to load it, and a gift whose condition fails on this page
  (the shopper lowers the trigger quantity) must still be removed; its key alone tells the engine the condition.
{%- endcomment -%}
{%- liquid
  assign continue_label = 'anvil.cart.continue_shopping' | t
  assign continue_url = settings.cart_empty_link | default: routes.all_products_collection_url
  assign update_label = 'anvil.cart.update' | t
  assign has_gift_line = false
  for item in cart.items
    if item.properties['_anvil_gift'] != blank
      assign has_gift_line = true
      break
    endif
  endfor
-%}
{{ 'anvil-cart-drawer.css' | asset_url | stylesheet_tag }}
<div {% render 'anvil-section-attrs', section: section, type: 'main-cart-items' %}>
  <div class="av-section__inner" data-anvil-cart-render="{{ section.id }}">
    {% render 'anvil-section-head', section: section %}
    <div class="av-cart-items">
      <div class="av-cart-items__head">
        <h1 class="av-cart-items__title" tabindex="-1" data-anvil-focus-fallback>{{ 'anvil.cart.title' | t }}</h1>
        {%- unless cart.empty? -%}
          <a class="av-cart-items__continue av-link" href="{{ continue_url }}">{{ continue_label }}</a>
        {%- endunless -%}
      </div>
      {%- if cart.empty? -%}
        <div class="av-cart-items__empty">
          <p class="av-cart-items__empty-text">{{ 'anvil.cart.empty' | t }}</p>
          {% render 'anvil-button', label: continue_label, url: continue_url, style: 'primary', size: 'lg' %}
        </div>
      {%- else -%}
        <anvil-cart-form class="av-enhance" cart-id="page">
          <form action="{{ routes.cart_url }}" method="post" id="anvil-cart-form" class="av-cart-items__form" data-anvil-cart-form>
            <ul class="av-cart-items__lines av-list-reset" role="list">
              {%- for item in cart.items -%}
                {% render 'anvil-cart-line', item: item, form_id: 'anvil-cart-form', show_unit_price: true, show_compare_at: settings.cart_show_savings, size: 'md' %}
              {%- endfor -%}
            </ul>
            <p class="av-cart-items__error av-form-message av-form-message--error" role="alert" data-anvil-cart-error hidden></p>
            <div class="av-cart-items__update av-fallback-only">
              {% render 'anvil-button', label: update_label, style: 'secondary', size: 'md', type: 'submit', attrs: 'formnovalidate' %}
            </div>
          </form>
        </anvil-cart-form>
        <script type="module" src="{{ 'anvil-cart.js' | asset_url }}"></script>
        {%- if has_gift_line -%}
          <script type="module" src="{{ 'anvil-gifts.js' | asset_url }}"></script>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</div>
{% stylesheet %}
.av-cart-items__head{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:var(--av-space-3);margin-bottom:var(--av-space-5)}
.av-cart-items__title{font-size:var(--av-text-3xl)}
.av-cart-items__empty{display:flex;flex-direction:column;align-items:center;gap:var(--av-space-4);padding:var(--av-space-9) 0;text-align:center}
.av-cart-items__empty-text{font-size:var(--av-text-lg)}
.av-cart-items__lines{margin:0;border-top:1px solid var(--av-border)}
.av-cart-items__lines>*{padding:var(--av-space-4) 0;border-bottom:1px solid var(--av-border)}
.av-cart-items__error{margin-top:var(--av-space-4)}
.av-cart-items__update{display:flex;justify-content:flex-end;margin-top:var(--av-space-4)}
@media (min-width: 750px){
.av-cart-items__lines>*{padding:var(--av-space-5) 0}
}
{% endstylesheet %}
{% schema %}
{
  "name": "Cart items",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "select", "id": "width", "label": "Width", "options": [ {"value":"page","label":"Page width"}, {"value":"narrow","label":"Narrow"}, {"value":"full","label":"Full width"} ], "default": "page" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "select", "id": "pad_mobile", "label": "Padding on phones", "options": [ {"value":"same","label":"Same as desktop"}, {"value":"compact","label":"Compact"}, {"value":"none","label":"None"} ], "default": "compact" },
    { "type": "header", "content": "Cart items" },
    {
      "type": "paragraph",
      "content": "Vendors, the order note, the discount field and the savings line are switched on under Theme settings > Cart. With the savings line on, lines strike through compare-at prices; only enter a compare-at price the product really sold for."
    }
  ]
}
{% endschema %}
