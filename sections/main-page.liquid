{%- liquid
  assign s = section.settings
  assign table_label = 'anvil.a11y.scroll_table' | t
  assign table_open = '<div class="av-prose__table" tabindex="0" role="region" aria-label="' | append: table_label | append: '"><table'
-%}
{{ 'anvil-prose.css' | asset_url | stylesheet_tag }}
<div {% render 'anvil-section-attrs', section: section, type: 'main-page' %}>
  <div class="av-section__inner">
    {% render 'anvil-section-head', section: section %}
    <article class="av-page av-page--{{ s.text_align }}">
      {%- if s.show_title -%}
        <h1 class="av-page__title">{{ page.title | escape }}</h1>
      {%- endif -%}
      {%- if page.content != blank -%}
        <div class="av-page__content av-prose">{{ page.content | replace: '<table', table_open | replace: '</table>', '</table></div>' }}</div>
      {%- endif -%}
    </article>
  </div>
</div>
{% stylesheet %}
.av-page{max-width:var(--av-narrow-width, 72ch);margin:0 auto}
.av-page--left{margin-left:0;text-align:left}
.av-page--center{text-align:center}
.av-page__title{margin:0 0 var(--av-space-5);font-size:var(--av-text-3xl)}
.av-page--center .av-page__content{text-align:left}
{% endstylesheet %}
{% schema %}
{
  "name": "Page",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "select", "id": "width", "label": "Width", "options": [ {"value":"page","label":"Page width"}, {"value":"narrow","label":"Narrow"}, {"value":"full","label":"Full width"} ], "default": "page" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "select", "id": "pad_mobile", "label": "Padding on phones", "options": [ {"value":"same","label":"Same as desktop"}, {"value":"compact","label":"Compact"}, {"value":"none","label":"None"} ], "default": "compact" },
    { "type": "header", "content": "Page" },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show page title",
      "default": true
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Title alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "left"
    }
  ]
}
{% endschema %}
