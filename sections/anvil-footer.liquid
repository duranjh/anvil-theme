{%- liquid
  assign s = section.settings
  assign show_country = false
  if s.show_country and localization.available_countries.size > 1
    assign show_country = true
  endif
  assign show_language = false
  if s.show_language and localization.available_languages.size > 1
    assign show_language = true
  endif
  assign current_year = 'now' | date: '%Y'
  assign nl_submit = 'anvil.newsletter.submit' | t
  assign update_label = 'anvil.localization.update' | t

  comment
    The theme's light logo replaces the logo when the footer scheme is dark.
  endcomment
  assign logo = settings.logo
  assign scheme_bg = s.color_scheme.settings.background | default: '#ffffff'
  assign brightness = scheme_bg | color_brightness
  if brightness < 128 and settings.logo_light != blank
    assign logo = settings.logo_light
  endif
  assign logo_w = settings.logo_width
  assign logo_w2 = logo_w | times: 2
  assign logo_widths = settings.logo_width_mobile | append: ', ' | append: logo_w | append: ', ' | append: logo_w2
  assign logo_sizes = '(min-width: 750px) ' | append: logo_w | append: 'px, ' | append: settings.logo_width_mobile | append: 'px'

  comment
    Payment icons: Shopify's enabled methods, optionally narrowed to the merchant's list, in the order typed.
  endcomment
  assign payment_types = shop.enabled_payment_types
  if s.payment_filter != blank
    assign wanted = s.payment_filter | downcase | remove: ' ' | split: ','
    assign kept = ''
    for want in wanted
      if shop.enabled_payment_types contains want
        assign kept = kept | append: want | append: ','
      endif
    endfor
    assign payment_types = kept | split: ','
  endif

  assign has_cards = false
  for block in section.blocks
    if block.type == 'product'
      assign has_cards = true
    endif
  endfor
-%}
{%- if has_cards -%}
  {{ 'anvil-card.css' | asset_url | stylesheet_tag }}
{%- endif -%}
<div {% render 'anvil-section-attrs', section: section, type: 'anvil-footer' %}>
  <div class="av-section__inner">
    <footer class="av-footer">
      {%- if section.blocks.size > 0 -%}
        <div class="av-footer__grid">
          {%- for block in section.blocks -%}
            <div class="av-footer__col av-footer__col--{{ block.type }}" {{ block.shopify_attributes }}>
              {%- case block.type -%}
                {%- when 'link_list' -%}
                  {%- if block.settings.heading != blank -%}
                    <h2 class="av-footer__heading">{{ block.settings.heading | escape }}</h2>
                  {%- endif -%}
                  {%- if block.settings.menu.links.size > 0 -%}
                    <ul class="av-footer__links av-list-reset">
                      {%- for link in block.settings.menu.links -%}
                        <li><a class="av-footer__link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                {%- when 'text' -%}
                  {%- if block.settings.heading != blank -%}
                    <h2 class="av-footer__heading">{{ block.settings.heading | escape }}</h2>
                  {%- endif -%}
                  <div class="av-footer__text av-rte">{{ block.settings.text }}</div>
                {%- when 'brand' -%}
                  {%- if block.settings.show_logo and logo != blank -%}
                    {%- assign brand_logo_height = logo_w | divided_by: logo.aspect_ratio | round -%}
                    <a class="av-footer__brand-logo" href="{{ routes.root_url }}">
                      {{ logo | image_url: width: logo_w2 | image_tag: widths: logo_widths, sizes: logo_sizes, width: logo_w, height: brand_logo_height, loading: 'lazy', alt: shop.name }}
                    </a>
                  {%- elsif block.settings.show_logo -%}
                    <p class="av-footer__heading">{{ shop.name }}</p>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="av-footer__text av-rte">{{ block.settings.text }}</div>
                  {%- endif -%}
                  {%- if block.settings.show_socials -%}
                    {% render 'anvil-social-links', class: 'av-footer__socials' %}
                  {%- endif -%}
                {%- when 'newsletter' -%}
                  {%- assign nl_id = 'anvil-newsletter-' | append: block.id -%}
                  {%- if block.settings.heading != blank -%}
                    <h2 class="av-footer__heading">{{ block.settings.heading | escape }}</h2>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="av-footer__text av-rte">{{ block.settings.text }}</div>
                  {%- endif -%}
                  {%- form 'customer', id: nl_id, class: 'av-footer__newsletter av-field' -%}
                    {%- liquid
                      assign nl_invalid = false
                      if form.errors and form.errors contains 'email'
                        assign nl_invalid = true
                      endif
                    -%}
                    <input type="hidden" name="contact[tags]" value="newsletter">
                    <label class="av-visually-hidden" for="{{ nl_id }}-email">{{ 'anvil.newsletter.label' | t }}</label>
                    <div class="av-field--inline">
                      <input class="av-field__input" id="{{ nl_id }}-email" type="email" name="contact[email]" value="{{ form.email }}" placeholder="{{ 'anvil.newsletter.placeholder' | t }}" autocomplete="email" required aria-required="true"{% if nl_invalid %} aria-invalid="true" aria-describedby="{{ nl_id }}-errors"{% endif %}>
                      {% render 'anvil-button', label: nl_submit, style: 'primary', size: 'md', type: 'submit' %}
                    </div>
                    {%- if form.posted_successfully? -%}
                      <p class="av-form-message av-form-message--success" role="status" tabindex="-1" autofocus>{{ 'anvil.newsletter.success' | t }}</p>
                    {%- elsif form.errors -%}
                      <div class="av-form-message av-form-message--error" id="{{ nl_id }}-errors" role="alert">{{ form.errors | default_errors }}</div>
                    {%- endif -%}
                  {%- endform -%}
                {%- when 'image' -%}
                  {%- if block.settings.image != blank -%}
                    {%- liquid
                      assign img_w = block.settings.image_width
                      assign img_w2 = img_w | times: 2
                      assign img_h = img_w | divided_by: block.settings.image.aspect_ratio | round
                      assign img_sizes = img_w | append: 'px'
                      assign img_widths = img_w | append: ', ' | append: img_w2
                      assign img_alt = block.settings.image.alt
                      if block.settings.link != blank
                        assign img_alt = block.settings.link_label | default: block.settings.image.alt | default: shop.name
                      endif
                    -%}
                    {%- if block.settings.link != blank -%}
                      <a class="av-footer__image" href="{{ block.settings.link }}">
                        {{ block.settings.image | image_url: width: img_w2 | image_tag: widths: img_widths, sizes: img_sizes, width: img_w, height: img_h, loading: 'lazy', alt: img_alt }}
                      </a>
                    {%- else -%}
                      <div class="av-footer__image">
                        {{ block.settings.image | image_url: width: img_w2 | image_tag: widths: img_widths, sizes: img_sizes, width: img_w, height: img_h, loading: 'lazy', alt: img_alt }}
                      </div>
                    {%- endif -%}
                  {%- else -%}
                    <div class="av-footer__image av-footer__image--placeholder">{{ 'image' | placeholder_svg_tag: 'av-footer__placeholder' }}</div>
                  {%- endif -%}
                {%- when 'product' -%}
                  {%- if block.settings.heading != blank -%}
                    <h2 class="av-footer__heading">{{ block.settings.heading | escape }}</h2>
                  {%- endif -%}
                  <div class="av-footer__card">
                    {% render 'anvil-product-card', product: block.settings.product, quick_add: block.settings.quick_add, sizes: '(min-width: 990px) 220px, (min-width: 750px) 45vw, 90vw', uid: block.id, heading_tag: 'h3' %}
                  </div>
                {%- when 'collection' -%}
                  {%- if block.settings.heading != blank -%}
                    <h2 class="av-footer__heading">{{ block.settings.heading | escape }}</h2>
                  {%- endif -%}
                  {%- assign fc = block.settings.collection -%}
                  {%- if fc != blank -%}
                    <a class="av-footer__collection" href="{{ fc.url }}">
                      {% render 'anvil-media', image: fc.featured_image, ratio: '4:5', widths: '300, 450, 600', sizes: '(min-width: 990px) 220px, (min-width: 750px) 45vw, 90vw', loading: 'lazy', alt: '', placeholder: 'collection-1' %}
                      <span class="av-footer__collection-title">{{ fc.title | escape }}</span>
                    </a>
                  {%- else -%}
                    <div class="av-footer__collection">
                      {% render 'anvil-media', ratio: '4:5', placeholder: 'collection-1' %}
                      <span class="av-footer__collection-title">{{ 'anvil.footer.example_collection' | t }}</span>
                    </div>
                  {%- endif -%}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="av-footer__bottom">
        {%- if show_country or show_language -%}
          <div class="av-footer__loc-group">
            {%- if show_country -%}
              {%- form 'localization', id: 'anvil-footer-country', class: 'av-footer__loc av-field' -%}
                <label class="av-field__label" for="anvil-footer-country-select">{{ 'anvil.localization.country' | t }}</label>
                <div class="av-footer__loc-row">
                  <div class="av-field__select">
                    <select class="av-field__input" id="anvil-footer-country-select" name="country_code">
                      {%- for country in localization.available_countries -%}
                        <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</option>
                      {%- endfor -%}
                    </select>
                  </div>
                  <button type="submit" class="av-btn av-btn--secondary av-btn--md">{{ update_label }}</button>
                </div>
              {%- endform -%}
            {%- endif -%}
            {%- if show_language -%}
              {%- form 'localization', id: 'anvil-footer-language', class: 'av-footer__loc av-field' -%}
                <label class="av-field__label" for="anvil-footer-language-select">{{ 'anvil.localization.language' | t }}</label>
                <div class="av-footer__loc-row">
                  <div class="av-field__select">
                    <select class="av-field__input" id="anvil-footer-language-select" name="language_code">
                      {%- for language in localization.available_languages -%}
                        <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name }}</option>
                      {%- endfor -%}
                    </select>
                  </div>
                  <button type="submit" class="av-btn av-btn--secondary av-btn--md">{{ update_label }}</button>
                </div>
              {%- endform -%}
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if s.show_payment_icons and payment_types.size > 0 -%}
          <ul class="av-footer__payments av-list-reset{% if s.payment_filter != blank %} av-footer__payments--row{% endif %}" aria-label="{{ 'anvil.footer.payment_methods' | t }}">
            {%- for type in payment_types -%}
              {%- comment -%} The icons' fixed title ids get a footer prefix, so product page and drawer icons never repeat them. {%- endcomment -%}
              <li class="av-footer__payment">{{ type | payment_type_svg_tag: class: 'av-footer__payment-icon' | replace: '"pi-', '"pi-footer-' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="av-footer__legal">
          <p class="av-footer__copyright">
            &copy; {{ current_year }} <a class="av-footer__link" href="{{ routes.root_url }}">{{ shop.name }}</a>
            {%- if s.copyright_text != blank %} &middot; {{ s.copyright_text | escape }}{% endif -%}
          </p>
          {%- if s.show_policies -%}
            <ul class="av-footer__policies av-list-reset">
              {%- for policy in shop.policies -%}
                {%- if policy.body != blank -%}
                  <li><a class="av-footer__link" href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </div>
    </footer>
  </div>
</div>
{% stylesheet %}
  .av-footer {
    display: block;
    font-size: var(--av-text-sm);
  }
  .av-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--av-space-6);
    padding-bottom: var(--av-space-6);
  }
  .av-footer__heading {
    margin: 0 0 var(--av-space-3);
    font-size: var(--av-text-md);
    font-weight: 700;
  }
  .av-footer__links li + li {
    margin-top: var(--av-space-2);
  }
  .av-footer__link {
    text-decoration: none;
  }
  .av-footer__link:hover {
    text-decoration: underline;
  }
  .av-footer__text {
    font-size: inherit;
  }
  .av-footer__brand-logo {
    display: inline-block;
    margin-bottom: var(--av-space-3);
  }
  .av-footer__brand-logo img {
    width: var(--av-logo-w);
    max-width: 100%;
    height: auto;
  }
  .av-footer__socials {
    margin-top: var(--av-space-3);
  }
  .av-footer__newsletter {
    margin-top: var(--av-space-3);
  }
  .av-footer__image img,
  .av-footer__placeholder {
    max-width: 100%;
    height: auto;
    border-radius: var(--av-radius-media);
  }
  .av-footer__image--placeholder {
    max-width: 240px;
    aspect-ratio: 4 / 3;
    background: rgb(var(--av-fg-rgb) / 0.06);
  }
  .av-footer__card,
  .av-footer__collection {
    max-width: 260px;
  }
  .av-footer__collection {
    display: grid;
    gap: var(--av-space-2);
    text-decoration: none;
  }
  .av-footer__collection-title {
    font-weight: 600;
  }
  .av-footer__collection:hover .av-footer__collection-title {
    text-decoration: underline;
  }
  .av-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: var(--av-space-4);
    padding-top: var(--av-space-5);
    border-top: 1px solid var(--av-border);
  }
  .av-footer__loc-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--av-space-4);
  }
  .av-footer__loc-row {
    display: flex;
    gap: var(--av-space-2);
  }
  .av-footer__loc-row .av-field__select {
    min-width: 200px;
  }
  .av-footer__payments {
    display: flex;
    flex-wrap: wrap;
    gap: var(--av-space-2);
  }
  .av-footer__payments--row {
    flex-wrap: nowrap;
    overflow-x: auto;
  }
  .av-footer__payment-icon {
    width: 38px;
    height: 24px;
  }
  .av-footer__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--av-space-2) var(--av-space-4);
    color: var(--av-fg-muted);
    font-size: var(--av-text-xs);
  }
  .av-footer__policies {
    display: flex;
    flex-wrap: wrap;
    gap: var(--av-space-2) var(--av-space-4);
  }
  @media (min-width: 750px) {
    .av-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .av-footer__legal {
      justify-content: space-between;
    }
  }
  @media (min-width: 990px) {
    .av-footer__grid {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
    .av-footer__bottom {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
    }
    .av-footer__legal {
      flex-basis: 100%;
    }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "select", "id": "pad_mobile", "label": "Padding on phones", "options": [ {"value":"same","label":"Same as desktop"}, {"value":"compact","label":"Compact"}, {"value":"none","label":"None"} ], "default": "compact" },
    { "type": "select", "id": "show_on", "label": "Show on", "options": [ {"value":"all","label":"All devices"}, {"value":"mobile","label":"Phones only"}, {"value":"desktop","label":"Desktop only"} ], "default": "all" },
    { "type": "header", "content": "Footer" },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "info": "Icons come from the payment methods enabled in your admin.",
      "default": true
    },
    {
      "type": "text",
      "id": "payment_filter",
      "label": "Only these payment icons",
      "placeholder": "visa, master, american_express, paypal",
      "info": "Optional. Payment type names separated by commas, in the order to show them, kept on one line. Only methods enabled in your admin appear."
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Show policy links",
      "info": "Only policies with content in Settings > Policies are listed.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_country",
      "label": "Country/region selector",
      "info": "Shows when more than one country is enabled in Markets.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_language",
      "label": "Language selector",
      "info": "Shows when more than one language is published.",
      "default": false
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Extra copyright text",
      "info": "Shown after the year and store name."
    }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "About"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Example footer text — replace this with a short note about your store.</p>"
        }
      ]
    },
    {
      "type": "brand",
      "name": "Brand information",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_logo",
          "label": "Show logo",
          "info": "Uses the logo from Theme settings (the light logo on a dark scheme), or the store name.",
          "default": true
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Example brand description — replace this with a sentence about your store.</p>"
        },
        {
          "type": "checkbox",
          "id": "show_socials",
          "label": "Show social links",
          "info": "Links come from Theme settings > Social links.",
          "default": true
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Email signup",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Stay in the loop"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "info": "Say what subscribers will receive and how often. Promise only what you will send.",
          "default": "<p>Example newsletter text — tell people what they will receive.</p>"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Upload only badges or logos you are entitled to use; Anvil ships none."
        },
        {
          "type": "range",
          "id": "image_width",
          "label": "Width",
          "min": 60,
          "max": 400,
          "step": 10,
          "unit": "px",
          "default": 200
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link description",
          "info": "Read out by screen readers when the image links somewhere, for example \"Our returns policy\". Defaults to the image's alt text."
        }
      ]
    },
    {
      "type": "product",
      "name": "Featured product",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "checkbox",
          "id": "quick_add",
          "label": "Add-to-cart button",
          "default": false
        }
      ]
    },
    {
      "type": "collection",
      "name": "Featured collection",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  },
  "presets": [
    {
      "name": "Footer",
      "settings": {
        "pad_top": 48,
        "pad_bottom": 24
      },
      "blocks": [
        { "type": "brand" },
        { "type": "link_list" },
        { "type": "newsletter" }
      ]
    }
  ]
}
{% endschema %}
