{%- comment -%}
  Cart page summary: order note, discount field (enhanced only, DECISIONS 37), the shared totals
  (snippets/anvil-cart-totals.liquid: subtotal, order discounts, savings from Shopify discounts and compare-at prices,
  estimated total, taxes note), the optional policies checkbox and the checkout button. Fields point at the cart form
  in the items section with form="anvil-cart-form", so the note, the box and checkout post with the line quantities
  without JavaScript. The box is `required`, so checkout waits for the tick (the items section's Update button skips
  validation); it is the cart attribute anvil_terms_accepted, the same one the cart drawer's Policies checkbox block
  writes, and assets/anvil-cart.js saves it on change so a re-render keeps the tick. Totals styles come from
  assets/anvil-cart-drawer.css (shared with the drawer).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign checkout_label = 'anvil.cart.checkout' | t
  assign apply_label = 'anvil.cart.apply' | t
  assign terms_default = 'anvil.cart.terms_default' | t
-%}
{{ 'anvil-cart-drawer.css' | asset_url | stylesheet_tag }}
<div {% render 'anvil-section-attrs', section: section, type: 'main-cart-footer' %}>
  <div class="av-section__inner" data-anvil-cart-render="{{ section.id }}">
    {%- comment -%}
      The root always renders so a re-render after the last item is removed has a target; the summary itself
      only shows while the cart has items.
    {%- endcomment -%}
    {%- unless cart.empty? -%}
      {% render 'anvil-section-head', section: section %}
      <anvil-cart-form class="av-cart-footer av-enhance" cart-id="page-summary">
        <div class="av-cart-footer__note">
          {%- if settings.cart_show_note -%}
            <div class="av-field">
              <label class="av-field__label" for="anvil-cart-note">{{ 'anvil.cart.note' | t }}</label>
              <textarea class="av-field__input av-cart-footer__textarea" id="anvil-cart-note" name="note" form="anvil-cart-form" rows="3" data-anvil-note data-anvil-focus-key="note">{{ cart.note | escape }}</textarea>
            </div>
          {%- endif -%}
        </div>
        <div class="av-cart-footer__summary">
          <p class="av-form-message av-form-message--error" role="alert" data-anvil-cart-error hidden></p>
          {%- if settings.cart_show_discount_field -%}
            <div class="av-cart-footer__discount av-field av-enhanced-only">
              <label class="av-field__label" for="anvil-cart-code">{{ 'anvil.cart.discount_code' | t }}</label>
              <div class="av-field--inline">
                <input class="av-field__input" id="anvil-cart-code" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" data-anvil-discount-input data-anvil-focus-key="code">
                {% render 'anvil-button', label: apply_label, style: 'secondary', size: 'md', attrs: 'data-anvil-discount-apply data-anvil-focus-key="code-apply"' %}
              </div>
              {%- capture codes -%}
                {%- for application in cart.discount_applications -%}
                  {%- if application.type == 'discount_code' -%}
                    <li class="av-cart-footer__code" data-anvil-code="{{ application.title | escape }}">
                      {%- render 'anvil-icon', name: 'tag', size: 14 -%}
                      <span>{{ application.title | escape }}</span>
                      <button type="button" class="av-cart-footer__code-remove" data-anvil-remove-code="{{ application.title | escape }}" data-anvil-focus-key="code-rm-{{ forloop.index }}" aria-label="{{ 'anvil.cart.remove_code' | t: code: application.title }}">
                        {%- render 'anvil-icon', name: 'x', size: 16 -%}
                      </button>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              {%- endcapture -%}
              {%- if codes != blank -%}
                <ul class="av-cart-footer__codes av-list-reset" role="list" aria-label="{{ 'anvil.cart.applied_codes' | t }}">{{ codes }}</ul>
              {%- endif -%}
            </div>
          {%- endif -%}
          {% render 'anvil-cart-totals', show_compare_savings: settings.cart_show_savings, show_tax_note: s.show_tax_note %}
          {%- if s.show_terms -%}
            <div class="av-cart-footer__terms">
              <div class="av-check">
                <input type="checkbox" id="anvil-cart-terms" name="attributes[anvil_terms_accepted]" value="yes" form="anvil-cart-form" required{% if cart.attributes['anvil_terms_accepted'] != blank %} checked{% endif %} data-anvil-cart-terms data-anvil-focus-key="terms">
                <label for="anvil-cart-terms">{{ s.terms_text | default: terms_default }}</label>
              </div>
              {%- if s.show_policy_links and shop.policies.size > 0 -%}
                <ul class="av-cart-footer__policies av-list-reset" role="list">
                  {%- for policy in shop.policies -%}
                    <li><a class="av-link" href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- endif -%}
          <div class="av-cart-footer__checkout">
            {% render 'anvil-button', label: checkout_label, style: 'primary', size: 'lg', full: true, type: 'submit', attrs: 'name="checkout" form="anvil-cart-form"' %}
          </div>
        </div>
      </anvil-cart-form>
      <script type="module" src="{{ 'anvil-cart.js' | asset_url }}"></script>
    {%- endunless -%}
  </div>
</div>
{% stylesheet %}
.av-s-main-cart-footer:not(:has(.av-cart-footer)){padding-block:0}
.av-cart-footer{display:grid;grid-template-columns:1fr;gap:var(--av-space-5)}
.av-cart-footer__note .av-field{max-width:480px}
.av-cart-footer__summary{display:flex;flex-direction:column;gap:var(--av-space-3)}
.av-cart-footer__codes{display:flex;flex-wrap:wrap;gap:var(--av-space-2);margin:0}
.av-cart-footer__code{display:inline-flex;align-items:center;gap:var(--av-space-1);padding-inline-start:var(--av-space-3);font-size:var(--av-text-xs);font-weight:600;border:1px solid var(--av-border);border-radius:var(--av-radius-pill)}
.av-cart-footer__code-remove{display:grid;place-items:center;width:28px;height:28px;color:inherit}
.av-cart-footer .av-cart-totals__row--total{font-size:var(--av-text-lg)}
.av-cart-footer__terms{display:grid;gap:var(--av-space-2);font-size:var(--av-text-sm)}
.av-cart-footer__terms a{color:inherit;text-decoration:underline}
.av-cart-footer__policies{display:flex;flex-wrap:wrap;gap:var(--av-space-1) var(--av-space-3);margin:0}
.av-cart-footer__checkout{margin-top:var(--av-space-2)}
@media (min-width: 750px){
.av-cart-footer{grid-template-columns:minmax(0, 1fr) 360px;justify-content:space-between;align-items:start}
}
{% endstylesheet %}
{% schema %}
{
  "name": "Cart summary",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "select", "id": "width", "label": "Width", "options": [ {"value":"page","label":"Page width"}, {"value":"narrow","label":"Narrow"}, {"value":"full","label":"Full width"} ], "default": "page" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "select", "id": "pad_mobile", "label": "Padding on phones", "options": [ {"value":"same","label":"Same as desktop"}, {"value":"compact","label":"Compact"}, {"value":"none","label":"None"} ], "default": "compact" },
    { "type": "header", "content": "Cart summary" },
    {
      "type": "paragraph",
      "content": "The order note, the discount field and the savings line are switched on under Theme settings > Cart. Savings come from Shopify discounts and compare-at prices only."
    },
    {
      "type": "checkbox",
      "id": "show_tax_note",
      "label": "Show shipping and taxes note",
      "default": true
    },
    { "type": "header", "content": "Policies checkbox" },
    {
      "type": "checkbox",
      "id": "show_terms",
      "label": "Show policies checkbox",
      "info": "Checkout waits until the box is ticked. The answer is saved on the order as the cart attribute anvil_terms_accepted. The cart drawer has its own Policies checkbox block.",
      "default": false
    },
    {
      "type": "inline_richtext",
      "id": "terms_text",
      "label": "Checkbox text",
      "default": "I have read and agree to the store policies",
      "visible_if": "{{ section.settings.show_terms }}"
    },
    {
      "type": "checkbox",
      "id": "show_policy_links",
      "label": "Link the store policies",
      "info": "Lists the policies written under Settings > Policies.",
      "default": true,
      "visible_if": "{{ section.settings.show_terms }}"
    }
  ]
}
{% endschema %}
