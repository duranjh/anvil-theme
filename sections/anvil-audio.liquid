{%- liquid
  assign s = section.settings

  # Overlay section (overlay group, reduced chassis). The root takes no room in the page: the stylesheet zeroes its
  # padding and background, and the padding custom properties that anvil-section-attrs writes inline become the
  # player's distance from the bottom of the screen (pad_bottom, times the phone multiplier from pad_mobile). The
  # colour scheme colours the player. Music never starts by itself: the audio element has no autoplay attribute,
  # loads nothing before the first press of Play (preload none), and assets/anvil-audio.js calls play() only from
  # that button. The player stays hidden until the module defines anvil-audio, so a page without JavaScript never
  # shows buttons that cannot work; those shoppers get the browser's own audio controls from the noscript copy.
  # Play/Pause always shows; folding hides only the title, the credit and Mute. DOM order is visual order: the fold
  # button sits on the edge the player folds to (first for left, last for right and centre).
  # Theme editor: the player loads folded and silent; selecting the section opens it (anvil-editor.js). Editor hints
  # (no link, or a link that is not an audio file) sit outside the foldable panel so they show on load.
  assign src = s.audio_url | strip
  assign title = s.track_title | strip
  assign artist = s.artist | strip
  assign position = s.position | default: 'left'
  assign volume = s.volume | default: 60

  assign show_player = true
  if src == blank and request.design_mode == false
    assign show_player = false
  endif

  assign folded = s.start_collapsed
  if request.design_mode
    assign folded = true
  endif

  # Editor hint only: a link whose path does not end in a common audio file type (a page or product picked by
  # mistake) probably will not play. Streams without an extension still render; the player reports a failed load.
  assign hint = ''
  if request.design_mode
    if src == blank
      assign hint = 'anvil.editor.audio_no_file' | t
    else
      assign src_ext = src | split: '?' | first | split: '#' | first | downcase | split: '.' | last
      assign audio_types = 'mp3,m4a,aac,mp4,ogg,oga,opus,wav,webm,flac' | split: ','
      unless audio_types contains src_ext
        assign hint = 'anvil.editor.audio_not_file' | t
      endunless
    endif
  endif

  assign uid = 'AnvilAudio-' | append: section.id
  assign region_label = 'anvil.audio.label' | t
-%}
{%- capture toggle_btn -%}
  <button type="button" class="av-audio__btn av-audio__toggle" aria-expanded="{% if folded %}false{% else %}true{% endif %}" aria-controls="{{ uid }}-panel" aria-label="{{ 'anvil.audio.controls' | t }}" data-anvil-toggle>
    <span class="av-audio__eq" aria-hidden="true"><span></span><span></span><span></span></span>
    {%- render 'anvil-icon', name: 'music', size: 20, class: 'av-audio__i-music' -%}
    {%- render 'anvil-icon', name: 'chevron-down', size: 20, class: 'av-audio__i-fold' -%}
  </button>
{%- endcapture -%}
<div {% render 'anvil-section-attrs', section: section, type: 'anvil-audio' %}>
  <div class="av-section__inner">
    {%- if show_player -%}
      <anvil-audio class="av-audio av-audio--{{ position }}" role="region" aria-label="{{ region_label }}" volume="{{ volume }}" data-anvil-editor-open>
        {%- if src != blank -%}
          <audio src="{{ src | escape }}" preload="none"{% if s.start_muted %} muted{% endif %}{% if s.loop %} loop{% endif %}></audio>
        {%- endif -%}
        {%- if position == 'left' -%}{{ toggle_btn }}{%- endif -%}
        <button type="button" class="av-btn av-btn--primary av-btn--icon av-audio__btn av-audio__play" aria-pressed="false" aria-label="{{ 'anvil.a11y.play' | t }}"{% if title != blank %} aria-describedby="{{ uid }}-title"{% endif %}{% if src == blank %} disabled{% endif %} data-anvil-play>
          {%- render 'anvil-icon', name: 'play', size: 20, class: 'av-audio__i-play' -%}
          {%- render 'anvil-icon', name: 'pause', size: 20, class: 'av-audio__i-pause' -%}
        </button>
        {%- if hint != blank -%}
          <p class="av-audio__hint">{{ hint }}</p>
        {%- endif -%}
        <div class="av-audio__panel" id="{{ uid }}-panel"{% if folded %} hidden{% endif %} data-anvil-panel>
          <div class="av-audio__meta">
            {%- if title != blank -%}
              <p class="av-audio__title" id="{{ uid }}-title">{{ title | escape }}</p>
            {%- endif -%}
            {%- if artist != blank -%}
              <p class="av-audio__artist">{{ artist | escape }}</p>
            {%- endif -%}
            <p class="av-audio__status" role="status" data-anvil-status data-anvil-error="{{ 'anvil.audio.error' | t }}"></p>
          </div>
          <button type="button" class="av-audio__btn av-audio__mute" aria-pressed="{% if s.start_muted %}true{% else %}false{% endif %}" aria-label="{{ 'anvil.media.mute' | t }}"{% if src == blank %} disabled{% endif %} data-anvil-mute>
            {%- render 'anvil-icon', name: 'volume-2', size: 20, class: 'av-audio__i-sound' -%}
            {%- render 'anvil-icon', name: 'volume-x', size: 20, class: 'av-audio__i-muted' -%}
          </button>
        </div>
        {%- if position != 'left' -%}{{ toggle_btn }}{%- endif -%}
      </anvil-audio>
      {%- if src != blank -%}
        <noscript>
          <div class="av-audio av-audio--{{ position }} av-audio--native" role="region" aria-label="{{ region_label }}">
            {%- if title != blank -%}
              <p class="av-audio__title">{{ title | escape }}</p>
            {%- endif -%}
            {%- if artist != blank -%}
              <p class="av-audio__artist">{{ artist | escape }}</p>
            {%- endif -%}
            <audio src="{{ src | escape }}" controls preload="none"{% if s.start_muted %} muted{% endif %}{% if s.loop %} loop{% endif %}></audio>
          </div>
        </noscript>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>
{%- if show_player -%}
  <script type="module" src="{{ 'anvil-audio.js' | asset_url }}"></script>
{%- endif -%}
{% stylesheet %}
/* The section root takes no height; only the player is drawn, fixed to the viewport. */
.av-section.av-s-anvil-audio{padding:0;background:none}
.av-audio{position:fixed;z-index:50;left:max(var(--av-gutter),env(safe-area-inset-left,0px));bottom:calc(var(--av-pad-bottom,48px) * var(--av-pad-mobile,1) + var(--av-sticky-bar-h,0px) + env(safe-area-inset-bottom,0px));display:flex;align-items:center;gap:var(--av-space-1);max-width:calc(100vw - 2 * var(--av-gutter));padding:var(--av-space-1);color:var(--av-fg);background-color:var(--av-bg);background-image:var(--av-bg-gradient);border:1px solid var(--av-border);border-radius:var(--av-radius-popup);box-shadow:var(--av-shadow-lg)}
.av-audio:not(:defined){display:none}
/* In the editor the player shows even before its module runs, so the setup hint is never hidden. */
.av-design-mode .av-audio:not(:defined){display:flex}
.av-audio--right{left:auto;right:max(var(--av-gutter),env(safe-area-inset-right,0px))}
.av-audio--center{right:var(--av-gutter);left:var(--av-gutter);width:fit-content;margin-inline:auto}
/* The page keeps room at its foot for the player (--av-audio-space, written by anvil-audio.js) on top of the sticky
   add-to-cart bar's room, so the footer stays reachable and focus never hides under the player (WCAG 2.4.11). These
   selectors outrank html.av-is-sticky-shown (anvil-sticky-bar.css), so the two add up instead of replacing each other. */
html:has(anvil-audio:defined) body{padding-bottom:calc(var(--av-audio-space,0px) + var(--av-sticky-bar-h,0px))}
html:has(anvil-audio:defined){scroll-padding-bottom:calc(var(--av-audio-space,0px) + var(--av-sticky-bar-h,0px))}
.av-audio__panel{display:flex;align-items:center;gap:var(--av-space-1);min-width:0}
.av-audio__panel[hidden]{display:none}
/* Sizing for every control; Play takes its look from .av-btn--primary, the others are plain icon buttons. */
.av-audio__btn{flex:none;display:inline-grid;place-items:center;width:44px;height:44px;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
.av-audio__btn > *{grid-area:1 / 1}
.av-audio__btn:not(.av-btn){color:inherit;background:none;border:0;border-radius:var(--av-radius-button);cursor:pointer}
.av-audio__btn:not(.av-btn):hover{background:rgb(var(--av-fg-rgb) / 0.08)}
.av-audio__btn:not(.av-btn):disabled{opacity:0.5;cursor:not-allowed}
.av-audio__play[aria-pressed="true"] .av-audio__i-play,.av-audio__play:not([aria-pressed="true"]) .av-audio__i-pause,.av-audio__mute[aria-pressed="true"] .av-audio__i-sound,.av-audio__mute:not([aria-pressed="true"]) .av-audio__i-muted,.av-audio__toggle[aria-expanded="true"] .av-audio__i-music,.av-audio__toggle[aria-expanded="true"] .av-audio__eq,.av-audio__toggle[aria-expanded="false"] .av-audio__i-fold,.av-audio:not(.av-is-playing) .av-audio__eq,.av-audio.av-is-playing .av-audio__i-music{display:none}
.av-audio--left .av-audio__i-fold{transform:rotate(90deg)}
.av-audio--right .av-audio__i-fold{transform:rotate(-90deg)}
.av-audio__meta,.av-audio__hint{flex:1 1 auto;min-width:0;max-width:14rem;padding-inline:var(--av-space-2);line-height:1.3}
.av-audio__title,.av-audio__artist,.av-audio__hint,.av-audio__status{margin:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.av-audio__title{font-size:var(--av-text-sm);font-weight:600}
.av-audio__artist,.av-audio__hint,.av-audio__status{font-size:var(--av-text-xs);color:var(--av-fg-muted)}
.av-audio__hint,.av-audio__status{white-space:normal}
/* The error line uses the scheme's own text colour, so it keeps the scheme's contrast on any player background. */
.av-audio__status{color:var(--av-fg);font-weight:600}
/* Three bars that tell a folded player is playing; they stand still unless motion is allowed. */
.av-audio__eq{display:inline-flex;align-items:flex-end;gap:2px;width:16px;height:16px}
.av-audio__eq > span{flex:1;height:100%;border-radius:1px;background:currentColor;transform-origin:50% 100%;transform:scaleY(0.55)}
.av-audio__eq > span:nth-child(2){transform:scaleY(1)}
.av-audio__eq > span:nth-child(3){transform:scaleY(0.75)}
.av-audio--native{flex-direction:column;align-items:stretch;gap:var(--av-space-2);padding:var(--av-space-2)}
.av-audio--native .av-audio__title,.av-audio--native .av-audio__artist{padding-inline:var(--av-space-2)}
.av-audio--native audio{display:block;width:min(300px, calc(100vw - 2 * var(--av-gutter) - 2 * var(--av-space-2)))}
@media (min-width: 750px){
.av-audio{bottom:calc(var(--av-pad-bottom,48px) + var(--av-sticky-bar-h,0px) + env(safe-area-inset-bottom,0px))}
.av-audio__meta,.av-audio__hint{max-width:16rem}
}
@media (prefers-reduced-motion: no-preference){
html:not([data-animations="off"]) .av-audio__eq > span{animation:av-audio-eq 0.9s var(--av-ease) infinite alternate}
html:not([data-animations="off"]) .av-audio__eq > span:nth-child(2){animation-delay:-0.3s}
html:not([data-animations="off"]) .av-audio__eq > span:nth-child(3){animation-delay:-0.6s}
}
@keyframes av-audio-eq{from{transform:scaleY(0.25)}to{transform:scaleY(1)}}
@media (forced-colors: active){
.av-audio{border-color:CanvasText}
.av-audio__btn{border:1px solid ButtonText}
.av-audio__eq > span{forced-color-adjust:none;background:ButtonText}
}
@media print{
.av-audio{display:none}
}
{% endstylesheet %}
{% schema %}
{
  "name": "Music player",
  "limit": 1,
  "enabled_on": { "groups": ["custom.overlay"] },
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1", "info": "The player takes the scheme's background and text colours; the play button takes its primary button style." },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48, "info": "Not used: the player floats over the page and takes no room in it." },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48, "info": "Distance between the player and the bottom of the screen. It moves up by itself while a sticky add-to-cart bar shows." },
    { "type": "select", "id": "pad_mobile", "label": "Padding on phones", "options": [ {"value":"same","label":"Same as desktop"}, {"value":"compact","label":"Compact"}, {"value":"none","label":"None"} ], "default": "compact", "info": "Compact keeps 60 % of the bottom distance on phones." },
    { "type": "select", "id": "show_on", "label": "Show on", "options": [ {"value":"all","label":"All devices"}, {"value":"mobile","label":"Phones only"}, {"value":"desktop","label":"Desktop only"} ], "default": "all" },
    { "type": "header", "content": "Music player" },
    {
      "type": "url",
      "id": "audio_url",
      "label": "Audio file link",
      "info": "Upload an MP3 or M4A file under Content > Files and paste its link. Play only music you hold a licence to use in your store. Shoppers see nothing until a link is set."
    },
    {
      "type": "text",
      "id": "track_title",
      "label": "Track title",
      "default": "Example: replace with your own"
    },
    {
      "type": "text",
      "id": "artist",
      "label": "Artist or credit line",
      "info": "Optional. Credit the artist the way your music licence asks."
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "options": [
        { "value": "left", "label": "Bottom left" },
        { "value": "right", "label": "Bottom right" },
        { "value": "center", "label": "Bottom centre" }
      ],
      "default": "left",
      "info": "Bottom left keeps the player clear of the scroll-to-top button, which sits bottom right by default."
    },
    {
      "type": "checkbox",
      "id": "start_collapsed",
      "label": "Start folded",
      "default": false,
      "info": "Folded, the player shows only its play button and a button that opens the track title and the mute control. In the editor it always loads folded; select this section to open it."
    },
    {
      "type": "checkbox",
      "id": "start_muted",
      "label": "Start muted",
      "default": false,
      "info": "Pressing play then starts the track with the sound off until the shopper turns it on with the speaker button. Music never starts by itself."
    },
    {
      "type": "range",
      "id": "volume",
      "label": "Starting volume",
      "min": 10,
      "max": 100,
      "step": 10,
      "unit": "%",
      "default": 60,
      "info": "Phones and tablets usually play at the device volume instead."
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Repeat the track",
      "default": true
    }
  ],
  "presets": [
    { "name": "Music player" }
  ]
}
{% endschema %}
