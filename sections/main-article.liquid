{{ 'anvil-sec-main-article.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign comment_count = article.comments_count
  assign comment_form_id = 'anvil-comment-form'
  assign post_label = 'anvil.article.post' | t
  assign table_label = 'anvil.a11y.scroll_table' | t
  assign table_open = '<div class="av-prose__table" tabindex="0" role="region" aria-label="' | append: table_label | append: '"><table'
  assign comment_invalid = false
-%}
{{ 'anvil-prose.css' | asset_url | stylesheet_tag }}
<div {% render 'anvil-section-attrs', section: section, type: 'main-article' %}>
  <div class="av-section__inner">
    {% render 'anvil-section-head', section: section %}
    <article class="av-article">
      <header class="av-article__header">
        {%- if s.show_date or s.show_author -%}
          <p class="av-article__meta">
            {%- if s.show_date -%}{{ article.published_at | time_tag: format: 'anvil_date' }}{%- endif -%}
            {%- if s.show_date and s.show_author %} &middot; {% endif -%}
            {%- if s.show_author -%}{{ article.author | escape }}{%- endif -%}
          </p>
        {%- endif -%}
        <h1 class="av-article__title">{{ article.title | escape }}</h1>
      </header>
      {%- if s.show_image and article.image -%}
        <div class="av-article__media">
          {% render 'anvil-media', image: article.image, ratio: 'adapt', widths: '600, 900, 1100, 1600', sizes: '(min-width: 990px) 900px, 100vw', loading: 'eager', priority: true, alt: article.image.alt, class: 'av-article__img' %}
        </div>
      {%- endif -%}
      <div class="av-article__content av-prose">{{ article.content | replace: '<table', table_open | replace: '</table>', '</table></div>' }}</div>
      <footer class="av-article__footer">
        <a class="av-article__back" href="{{ blog.url }}"><span aria-hidden="true">&larr;</span> {{ 'anvil.article.back_to' | t: blog: blog.title }}</a>
      </footer>
    </article>

    {%- if blog.comments_enabled? -%}
      <section class="av-article__comments" id="comments" aria-labelledby="anvil-comments-title">
        <h2 class="av-article__comments-title" id="anvil-comments-title">
          {{ 'anvil.article.comments' | t: count: comment_count }}
        </h2>
        {%- if comment_count > 0 -%}
          {%- paginate article.comments by 20 -%}
            <ol class="av-article__comment-list av-list-reset">
              {%- for comment in article.comments -%}
                <li class="av-article__comment" id="{{ comment.id }}">
                  <p class="av-article__comment-meta">
                    <strong>{{ comment.author | escape }}</strong>
                    &middot; {{ comment.created_at | time_tag: format: 'anvil_date' }}
                  </p>
                  <div class="av-article__comment-body av-rte">{{ comment.content }}</div>
                </li>
              {%- endfor -%}
            </ol>
            {% render 'anvil-pagination', paginate: paginate %}
          {%- endpaginate -%}
        {%- endif -%}

        {%- form 'new_comment', article, id: comment_form_id, class: 'av-article__form' -%}
          <h3 class="av-article__form-title">{{ 'anvil.article.comment_form_title' | t }}</h3>
          {%- if form.posted_successfully? -%}
            <p class="av-article__notice av-form-message av-form-message--success" role="status" tabindex="-1" autofocus>
              {%- if blog.moderated? -%}
                {{ 'anvil.article.success_moderated' | t }}
              {%- else -%}
                {{ 'anvil.article.success' | t }}
              {%- endif -%}
            </p>
          {%- elsif form.errors -%}
            {%- assign comment_invalid = true -%}
            <div class="av-article__notice av-form-message av-form-message--error" id="{{ comment_form_id }}-errors" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="av-article__fields">
            <div class="av-article__field av-field">
              <label class="av-article__label av-field__label" for="{{ comment_form_id }}-author">{{ 'anvil.article.name' | t }} <span aria-hidden="true">*</span></label>
              <input class="av-article__input av-field__input" id="{{ comment_form_id }}-author" type="text" name="comment[author]" value="{{ form.author }}" autocomplete="name" required aria-required="true"{% if comment_invalid and form.errors contains 'author' %} aria-invalid="true" aria-describedby="{{ comment_form_id }}-errors"{% endif %}>
            </div>
            <div class="av-article__field av-field">
              <label class="av-article__label av-field__label" for="{{ comment_form_id }}-email">{{ 'anvil.article.email' | t }} <span aria-hidden="true">*</span></label>
              <input class="av-article__input av-field__input" id="{{ comment_form_id }}-email" type="email" name="comment[email]" value="{{ form.email }}" autocomplete="email" required aria-required="true"{% if comment_invalid and form.errors contains 'email' %} aria-invalid="true" aria-describedby="{{ comment_form_id }}-errors"{% endif %}>
            </div>
            <div class="av-article__field av-article__field--full av-field">
              <label class="av-article__label av-field__label" for="{{ comment_form_id }}-body">{{ 'anvil.article.comment' | t }} <span aria-hidden="true">*</span></label>
              <textarea class="av-article__input av-field__input" id="{{ comment_form_id }}-body" name="comment[body]" rows="5" required aria-required="true"{% if comment_invalid and form.errors contains 'body' %} aria-invalid="true" aria-describedby="{{ comment_form_id }}-errors"{% endif %}>{{ form.body }}</textarea>
            </div>
          </div>
          {%- if blog.moderated? -%}
            <p class="av-article__hint">{{ 'anvil.article.moderated' | t }}</p>
          {%- endif -%}
          {% render 'anvil-button', label: post_label, style: 'primary', size: 'md', type: 'submit' %}
        {%- endform -%}
      </section>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Article",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "select", "id": "width", "label": "Width", "options": [ {"value":"page","label":"Page width"}, {"value":"narrow","label":"Narrow"}, {"value":"full","label":"Full width"} ], "default": "page" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "select", "id": "pad_mobile", "label": "Padding on phones", "options": [ {"value":"same","label":"Same as desktop"}, {"value":"compact","label":"Compact"}, {"value":"none","label":"None"} ], "default": "compact" },
    { "type": "header", "content": "Article" },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show featured image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": false
    }
  ]
}
{% endschema %}
