{%- liquid
  assign s = section.settings
  assign form_id = 'anvil-cart-drawer-form'
  assign checkout_label = 'anvil.cart.checkout' | t
  assign update_label = 'anvil.cart.update' | t
  assign continue_label = 'anvil.cart.continue_shopping' | t
  assign continue_url = settings.cart_empty_link | default: routes.all_products_collection_url
  assign apply_label = 'anvil.cart.apply' | t

  assign savings = 0
  if settings.cart_show_savings
    for item in cart.items
      if item.variant.compare_at_price > item.original_price
        assign line_saving = item.variant.compare_at_price | minus: item.original_price | times: item.quantity
        assign savings = savings | plus: line_saving
      endif
    endfor
    assign savings = savings | plus: cart.total_discount
  endif
-%}
<anvil-cart-drawer
  id="anvil-cart-drawer"
  class="av-cart-drawer"
  data-section-id="{{ section.id }}"
  {%- if request.design_mode and s.drawer_preview_open %} data-anvil-preview-open{% endif %}
>
  <dialog class="av-cart-drawer__dialog av-scheme av-scheme--{{ s.color_scheme.id }}" aria-labelledby="anvil-cart-drawer-title">
    <div class="av-cart-drawer__frame" data-anvil-section="anvil-cart-drawer" data-anvil-cart-render="anvil-cart-drawer">
      <div class="av-cart-drawer__head">
        <h2 class="av-cart-drawer__title" id="anvil-cart-drawer-title" tabindex="-1" data-anvil-focus-fallback>
          {%- if s.drawer_title != blank -%}{{ s.drawer_title | escape }}{%- else -%}{{ 'anvil.cart.title' | t }}{%- endif -%}
        </h2>
        <span class="av-cart-drawer__count av-muted">{{ 'anvil.cart.item_count' | t: count: cart.item_count }}</span>
        <button type="button" class="av-cart-drawer__close" data-anvil-close aria-label="{{ 'anvil.a11y.close' | t }}">
          {% render 'anvil-icon', name: 'x', size: 24 %}
        </button>
      </div>
      <anvil-cart-form class="av-cart-drawer__enhance av-enhance" cart-id="drawer">
        <form action="{{ routes.cart_url }}" method="post" id="{{ form_id }}" class="av-cart-drawer__form" data-anvil-cart-form>
          <div class="av-cart-drawer__body" data-anvil-scroll="drawer-body">
            {%- if cart.empty? -%}
              <div class="av-cart-drawer__empty">
                <p class="av-cart-drawer__empty-text">{{ 'anvil.cart.empty' | t }}</p>
                {% render 'anvil-button', label: continue_label, url: continue_url, style: 'secondary', size: 'md' %}
              </div>
            {%- else -%}
              <ul class="av-cart-drawer__lines av-list-reset">
                {%- for item in cart.items -%}
                  {%- assign item_title = item.product.title | escape -%}
                  <li class="av-cart-drawer__line" data-anvil-line="{{ item.key }}">
                    {%- if item.image -%}
                      <a class="av-cart-drawer__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                        {{ item.image | image_url: width: 240 | image_tag: widths: '120, 240', sizes: '80px', loading: 'lazy', alt: '', class: 'av-cart-drawer__img' }}
                      </a>
                    {%- endif -%}
                    <div class="av-cart-drawer__info">
                      <a class="av-cart-drawer__name" href="{{ item.url }}">{{ item_title }}</a>
                      {%- if settings.cart_show_vendor and item.vendor != blank -%}
                        <p class="av-cart-drawer__meta">{{ item.vendor | escape }}</p>
                      {%- endif -%}
                      {%- unless item.product.has_only_default_variant -%}
                        <p class="av-cart-drawer__meta">{{ item.variant.title | escape }}</p>
                      {%- endunless -%}
                      {%- for property in item.properties -%}
                        {%- assign prop_first = property.first | slice: 0 -%}
                        {%- if property.last != blank and prop_first != '_' -%}
                          <p class="av-cart-drawer__meta">{{ property.first | escape }}: {{ property.last | escape }}</p>
                        {%- endif -%}
                      {%- endfor -%}
                      {%- if item.selling_plan_allocation -%}
                        <p class="av-cart-drawer__meta">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
                      {%- endif -%}
                      {%- for allocation in item.line_level_discount_allocations -%}
                        <p class="av-cart-drawer__meta av-cart-drawer__meta--discount">{{ allocation.discount_application.title | escape }} (&minus;{% render 'anvil-money', amount: allocation.amount %})</p>
                      {%- endfor -%}
                      <div class="av-cart-drawer__controls">
                        <div class="av-qty av-cart-drawer__qty">
                          <button type="button" class="av-qty__btn av-cart-drawer__step av-enhanced-only" data-anvil-step="-1" data-anvil-focus-key="dec-{{ item.key }}" aria-label="{{ 'anvil.cart.decrease_for' | t: title: item.product.title }}">&minus;</button>
                          <input class="av-qty__input" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric" aria-label="{{ 'anvil.cart.quantity_for' | t: title: item.product.title }}" data-anvil-quantity data-anvil-focus-key="qty-{{ item.key }}">
                          <button type="button" class="av-qty__btn av-cart-drawer__step av-enhanced-only" data-anvil-step="1" data-anvil-focus-key="inc-{{ item.key }}" aria-label="{{ 'anvil.cart.increase_for' | t: title: item.product.title }}">+</button>
                        </div>
                        <a class="av-cart-drawer__remove" href="{{ item.url_to_remove }}" data-anvil-remove data-anvil-focus-key="rm-{{ item.key }}" aria-label="{{ 'anvil.cart.remove' | t }}: {{ item_title }}">{{ 'anvil.cart.remove' | t }}</a>
                      </div>
                    </div>
                    <div class="av-cart-drawer__price">
                      {%- if item.original_line_price != item.final_line_price -%}
                        <s class="av-cart-drawer__was av-muted"><span class="av-visually-hidden">{{ 'anvil.price.regular_price' | t }}</span> {% render 'anvil-money', amount: item.original_line_price %}</s>
                      {%- endif -%}
                      <span class="av-cart-drawer__now">
                        {%- if item.original_line_price != item.final_line_price -%}<span class="av-visually-hidden">{{ 'anvil.price.sale_price' | t }} </span>{%- endif -%}
                        {%- if item.final_line_price == 0 -%}{{ 'anvil.cart.free' | t }}{%- else -%}{% render 'anvil-money', amount: item.final_line_price %}{%- endif -%}
                      </span>
                    </div>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
          {%- unless cart.empty? -%}
            <div class="av-cart-drawer__foot">
              <p class="av-cart-drawer__error av-form-message av-form-message--error" role="alert" data-anvil-cart-error hidden></p>
              {%- if settings.cart_show_note -%}
                <div class="av-cart-drawer__note av-field">
                  <label class="av-field__label" for="anvil-cart-drawer-note">{{ 'anvil.cart.note' | t }}</label>
                  <textarea class="av-field__input av-cart-drawer__textarea" id="anvil-cart-drawer-note" name="note" rows="2" data-anvil-note data-anvil-focus-key="note">{{ cart.note }}</textarea>
                </div>
              {%- endif -%}
              {%- if settings.cart_show_discount_field -%}
                <div class="av-cart-drawer__discount av-field av-enhanced-only">
                  <label class="av-field__label" for="anvil-cart-drawer-code">{{ 'anvil.cart.discount_code' | t }}</label>
                  <div class="av-field--inline">
                    <input class="av-field__input" id="anvil-cart-drawer-code" type="text" autocomplete="off" autocapitalize="characters" data-anvil-discount-input data-anvil-focus-key="code">
                    {% render 'anvil-button', label: apply_label, style: 'secondary', size: 'md', attrs: 'data-anvil-discount-apply data-anvil-focus-key="code-apply"' %}
                  </div>
                  {%- assign has_codes = false -%}
                  {%- for application in cart.discount_applications -%}
                    {%- if application.type == 'discount_code' -%}{%- assign has_codes = true -%}{%- endif -%}
                  {%- endfor -%}
                  {%- if has_codes -%}
                    <ul class="av-cart-drawer__codes av-list-reset" aria-label="{{ 'anvil.cart.applied_codes' | t }}">
                      {%- for application in cart.discount_applications -%}
                        {%- if application.type == 'discount_code' -%}
                          <li class="av-cart-drawer__code" data-anvil-code="{{ application.title | escape }}">
                            <span>{{ application.title | escape }}</span>
                            <button type="button" class="av-cart-drawer__code-remove" data-anvil-remove-code="{{ application.title | escape }}" aria-label="{{ 'anvil.cart.remove_code' | t: code: application.title }}">
                              {% render 'anvil-icon', name: 'x', size: 16 %}
                            </button>
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>
              {%- endif -%}
              {%- for discount in cart.cart_level_discount_applications -%}
                <div class="av-cart-drawer__row av-cart-drawer__row--discount">
                  <span>{{ discount.title | escape }}</span>
                  <span>&minus;{% render 'anvil-money', amount: discount.total_allocated_amount %}</span>
                </div>
              {%- endfor -%}
              {%- if savings > 0 -%}
                {%- capture savings_money -%}{% render 'anvil-money', amount: savings %}{%- endcapture -%}
                <p class="av-cart-drawer__row av-cart-drawer__row--savings">{{ 'anvil.cart.you_save_html' | t: amount: savings_money }}</p>
              {%- endif -%}
              <div class="av-cart-drawer__row av-cart-drawer__row--total">
                <span>{{ 'anvil.cart.subtotal' | t }}</span>
                <span>{% render 'anvil-money', amount: cart.total_price %}</span>
              </div>
              <p class="av-cart-drawer__tax av-muted">
                {%- if cart.taxes_included -%}{{ 'anvil.cart.taxes_included_note' | t }}{%- else -%}{{ 'anvil.cart.taxes_note' | t }}{%- endif -%}
              </p>
              <div class="av-cart-drawer__actions">
                {% render 'anvil-button', label: checkout_label, style: 'primary', size: 'lg', full: true, type: 'submit', attrs: 'name="checkout"' %}
                <div class="av-fallback-only">
                  {% render 'anvil-button', label: update_label, style: 'secondary', size: 'md', full: true, type: 'submit' %}
                </div>
              </div>
            </div>
          {%- endunless -%}
        </form>
      </anvil-cart-form>
    </div>
    <div class="av-visually-hidden" role="status" aria-live="polite" data-anvil-live></div>
  </dialog>
</anvil-cart-drawer>
<script type="module" src="{{ 'anvil-cart-drawer.js' | asset_url }}"></script>
<script type="module" src="{{ 'anvil-cart.js' | asset_url }}"></script>
{% stylesheet %}
  .av-cart-drawer {
    display: contents;
  }
  .av-cart-drawer__dialog {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(100%, var(--av-drawer-width, 420px));
    height: 100dvh;
    max-height: none;
    max-width: none;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: var(--av-radius-drawer) 0 0 var(--av-radius-drawer);
    background: var(--av-bg);
    color: var(--av-fg);
    box-shadow: var(--av-shadow-drawer);
  }
  .av-cart-drawer__dialog[open],
  .av-cart-drawer__frame,
  .av-cart-drawer__enhance {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .av-cart-drawer__frame,
  .av-cart-drawer__enhance {
    flex: 1 1 auto;
  }
  .av-cart-drawer__dialog::backdrop {
    background: rgb(var(--av-overlay-rgb, 0 0 0) / var(--av-overlay-a, 0.45));
  }
  .av-cart-drawer__head {
    display: flex;
    align-items: center;
    gap: var(--av-space-3);
    padding: var(--av-space-4);
    border-bottom: 1px solid var(--av-border);
  }
  .av-cart-drawer__title {
    margin: 0;
    font-size: var(--av-text-lg);
  }
  .av-cart-drawer__count {
    font-size: var(--av-text-sm);
  }
  .av-cart-drawer__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-left: auto;
    color: inherit;
    border-radius: var(--av-radius-button);
  }
  .av-cart-drawer__form {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
  }
  .av-cart-drawer__body {
    flex: 1 1 auto;
    overflow-y: auto;
    padding: var(--av-space-4);
  }
  .av-cart-drawer__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--av-space-4);
    padding: var(--av-space-8) 0;
    text-align: center;
  }
  .av-cart-drawer__empty-text {
    font-size: var(--av-text-md);
  }
  .av-cart-drawer__lines {
    display: flex;
    flex-direction: column;
    gap: var(--av-space-4);
  }
  .av-cart-drawer__line {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    gap: var(--av-space-3);
    align-items: start;
  }
  .av-cart-drawer__line[aria-busy="true"] {
    opacity: 0.6;
  }
  .av-cart-drawer__media {
    display: block;
    width: 80px;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--av-radius-media);
    background: rgb(var(--av-fg-rgb) / 0.05);
  }
  .av-cart-drawer__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .av-cart-drawer__name {
    text-decoration: none;
    font-weight: 600;
  }
  .av-cart-drawer__name:hover {
    text-decoration: underline;
  }
  .av-cart-drawer__meta {
    margin-top: var(--av-space-1);
    font-size: var(--av-text-xs);
    color: var(--av-fg-muted);
  }
  .av-cart-drawer__meta--discount {
    color: var(--av-fg);
  }
  .av-cart-drawer__controls {
    display: flex;
    align-items: center;
    gap: var(--av-space-3);
    margin-top: var(--av-space-2);
  }
  .av-cart-drawer__remove {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    font-size: var(--av-text-xs);
    color: var(--av-fg-muted);
  }
  .av-cart-drawer__price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--av-space-1);
    font-size: var(--av-text-sm);
  }
  .av-cart-drawer__foot {
    display: grid;
    gap: var(--av-space-2);
    padding: var(--av-space-4);
    border-top: 1px solid var(--av-border);
    background: var(--av-bg);
  }
  .av-cart-drawer__textarea {
    min-height: 0;
  }
  .av-cart-drawer__codes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--av-space-2);
  }
  .av-cart-drawer__code {
    display: inline-flex;
    align-items: center;
    gap: var(--av-space-1);
    padding-inline-start: var(--av-space-3);
    font-size: var(--av-text-xs);
    font-weight: 600;
    border: 1px solid var(--av-border);
    border-radius: var(--av-radius-pill);
  }
  .av-cart-drawer__code-remove {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
  }
  .av-cart-drawer__row {
    display: flex;
    justify-content: space-between;
    gap: var(--av-space-3);
    font-size: var(--av-text-sm);
  }
  .av-cart-drawer__row--savings {
    justify-content: flex-start;
    color: var(--av-success);
  }
  .av-cart-drawer__row--total {
    font-size: var(--av-text-md);
    font-weight: 700;
  }
  .av-cart-drawer__tax {
    font-size: var(--av-text-xs);
  }
  .av-cart-drawer__actions {
    display: flex;
    flex-direction: column;
    gap: var(--av-space-2);
    margin-top: var(--av-space-1);
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "paragraph",
      "content": "Width, open-after-add, the order note, the discount field, vendors and the savings line are set under Theme settings > Cart and Drawers."
    },
    {
      "type": "text",
      "id": "drawer_title",
      "label": "Heading",
      "default": "Your cart"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "drawer_preview_open",
      "label": "Keep open while editing",
      "info": "Only affects the theme editor so you can style the drawer.",
      "default": false
    }
  ],
  "blocks": []
}
{% endschema %}
