{%- liquid
  assign s = section.settings
  assign form_id = 'anvil-cart-drawer-form'
  assign checkout_label = 'anvil.cart.checkout' | t
  assign update_label = 'anvil.cart.update' | t
  assign continue_label = 'anvil.cart.continue_shopping' | t
  assign continue_url = settings.cart_empty_link | default: routes.all_products_collection_url
-%}
<anvil-cart-drawer
  id="anvil-cart-drawer"
  class="av-cart-drawer"
  data-anvil-section="anvil-cart-drawer"
  data-section-id="{{ section.id }}"
  {%- if request.design_mode and s.drawer_preview_open %} data-anvil-preview-open{% endif %}
>
  <dialog class="av-cart-drawer__dialog av-scheme av-scheme--{{ s.color_scheme.id }}" aria-labelledby="anvil-cart-drawer-title">
    <div class="av-cart-drawer__head">
      <h2 class="av-cart-drawer__title" id="anvil-cart-drawer-title">
        {%- if s.heading != blank -%}{{ s.heading | escape }}{%- else -%}{{ 'anvil.cart.title' | t }}{%- endif -%}
      </h2>
      <span class="av-cart-drawer__count av-muted" data-anvil-drawer-count>{{ 'anvil.cart.item_count' | t: count: cart.item_count }}</span>
      <button type="button" class="av-cart-drawer__close" data-anvil-close aria-label="{{ 'anvil.a11y.close' | t }}">
        {% render 'anvil-icon', name: 'x', size: 24 %}
      </button>
    </div>
    <form action="{{ routes.cart_url }}" method="post" id="{{ form_id }}" class="av-cart-drawer__form" data-anvil-cart-form>
      <div class="av-cart-drawer__body" data-anvil-drawer-body>
        {%- if cart.empty? -%}
          <div class="av-cart-drawer__empty">
            <p class="av-cart-drawer__empty-text">{{ 'anvil.cart.empty' | t }}</p>
            {% render 'anvil-button', label: continue_label, url: continue_url, style: 'secondary', size: 'md', attrs: 'data-anvil-close' %}
          </div>
        {%- else -%}
          <ul class="av-cart-drawer__lines av-list-reset">
            {%- for item in cart.items -%}
              <li class="av-cart-drawer__line" data-anvil-line="{{ item.key }}">
                {%- if item.image -%}
                  <a class="av-cart-drawer__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                    {{ item.image | image_url: width: 240 | image_tag: widths: '120, 240', sizes: '80px', loading: 'lazy', class: 'av-cart-drawer__img' }}
                  </a>
                {%- endif -%}
                <div class="av-cart-drawer__info">
                  <a class="av-cart-drawer__name" href="{{ item.url }}">{{ item.product.title | escape }}</a>
                  {%- unless item.product.has_only_default_variant -%}
                    <p class="av-cart-drawer__meta">{{ item.variant.title | escape }}</p>
                  {%- endunless -%}
                  {%- for property in item.properties -%}
                    {%- assign prop_first = property.first | slice: 0 -%}
                    {%- if property.last != blank and prop_first != '_' -%}
                      <p class="av-cart-drawer__meta">{{ property.first | escape }}: {{ property.last | escape }}</p>
                    {%- endif -%}
                  {%- endfor -%}
                  {%- if item.selling_plan_allocation -%}
                    <p class="av-cart-drawer__meta">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
                  {%- endif -%}
                  {%- for allocation in item.line_level_discount_allocations -%}
                    <p class="av-cart-drawer__meta av-cart-drawer__meta--discount">{{ allocation.discount_application.title | escape }} (&minus;{{ allocation.amount | money }})</p>
                  {%- endfor -%}
                  <div class="av-cart-drawer__controls">
                    <div class="av-qty av-cart-drawer__qty">
                      <button type="button" class="av-qty__btn av-cart-drawer__step av-js-only" data-anvil-step="-1" data-anvil-focus-key="dec-{{ item.key }}" aria-label="{{ 'anvil.cart.decrease' | t }}">&minus;</button>
                      <input class="av-qty__input" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric" aria-label="{{ 'anvil.cart.quantity' | t }}" data-anvil-quantity data-anvil-focus-key="qty-{{ item.key }}">
                      <button type="button" class="av-qty__btn av-cart-drawer__step av-js-only" data-anvil-step="1" data-anvil-focus-key="inc-{{ item.key }}" aria-label="{{ 'anvil.cart.increase' | t }}">+</button>
                    </div>
                    <a class="av-cart-drawer__remove" href="{{ item.url_to_remove }}" data-anvil-remove data-anvil-focus-key="rm-{{ item.key }}" aria-label="{{ 'anvil.cart.remove' | t }}: {{ item.product.title | escape }}">{{ 'anvil.cart.remove' | t }}</a>
                  </div>
                </div>
                <div class="av-cart-drawer__price">
                  {%- if item.original_line_price != item.final_line_price -%}
                    <s class="av-cart-drawer__was av-muted">{{ item.original_line_price | money }}</s>
                  {%- endif -%}
                  <span class="av-cart-drawer__now">
                    {%- if item.final_line_price == 0 -%}{{ 'anvil.cart.free' | t }}{%- else -%}{{ item.final_line_price | money }}{%- endif -%}
                  </span>
                </div>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
      <div class="av-cart-drawer__foot" data-anvil-drawer-footer>
        {%- unless cart.empty? -%}
          {%- if settings.cart_show_note -%}
            <div class="av-cart-drawer__note av-field">
              <label class="av-field__label" for="anvil-cart-drawer-note">{{ 'anvil.cart.note' | t }}</label>
              <textarea class="av-field__input av-cart-drawer__textarea" id="anvil-cart-drawer-note" name="note" rows="2" data-anvil-note>{{ cart.note }}</textarea>
            </div>
          {%- endif -%}
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="av-cart-drawer__row av-cart-drawer__row--discount">
              <span>{{ discount.title | escape }}</span>
              <span>&minus;{{ discount.total_allocated_amount | money }}</span>
            </div>
          {%- endfor -%}
          <div class="av-cart-drawer__row av-cart-drawer__row--total">
            <span>{{ 'anvil.cart.subtotal' | t }}</span>
            <span data-anvil-subtotal>
              {%- if settings.show_currency_code -%}{{ cart.total_price | money_with_currency }}{%- else -%}{{ cart.total_price | money }}{%- endif -%}
            </span>
          </div>
          <p class="av-cart-drawer__tax av-muted">
            {%- if cart.taxes_included -%}{{ 'anvil.cart.taxes_included_note' | t }}{%- else -%}{{ 'anvil.cart.taxes_note' | t }}{%- endif -%}
          </p>
          <div class="av-cart-drawer__actions">
            {% render 'anvil-button', label: checkout_label, style: 'primary', size: 'lg', full: true, type: 'submit', attrs: 'name="checkout"' %}
            <div class="av-no-js-only">
              {% render 'anvil-button', label: update_label, style: 'secondary', size: 'md', full: true, type: 'submit' %}
            </div>
          </div>
        {%- endunless -%}
      </div>
    </form>
    <div class="av-visually-hidden" role="status" aria-live="polite" data-anvil-live></div>
  </dialog>
</anvil-cart-drawer>
{% javascript %}
  if (!customElements.get('anvil-cart-drawer')) {
    customElements.define('anvil-cart-drawer', class extends HTMLElement {
      connectedCallback() {
        this.dialog = this.querySelector('dialog');
        if (!this.dialog) return;
        this.dialog.addEventListener('close', this.onClose);
        const events = window.Anvil && window.Anvil.events;
        if (events && typeof events.on === 'function') {
          this.offCart = events.on('anvil:cart:updated', (detail) => {
            const settings = (window.Anvil && window.Anvil.settings) || {};
            if (detail && detail.source === 'add' && settings.openCartOnAdd) this.open();
          });
        }
        if (this.hasAttribute('data-anvil-preview-open')) this.open();
      }
      disconnectedCallback() {
        if (this.dialog) this.dialog.removeEventListener('close', this.onClose);
        if (typeof this.offCart === 'function') this.offCart();
      }
      get isOpen() {
        return Boolean(this.dialog && this.dialog.open);
      }
      open(opener) {
        if (!this.dialog || this.dialog.open) return;
        this.opener = opener instanceof Element ? opener : document.activeElement;
        this.dialog.showModal();
        const dom = window.Anvil && window.Anvil.dom;
        if (dom && typeof dom.lockScroll === 'function') dom.lockScroll();
        if (this.opener) this.opener.setAttribute('aria-expanded', 'true');
      }
      close() {
        if (this.dialog && this.dialog.open) this.dialog.close();
      }
      onClose = () => {
        const dom = window.Anvil && window.Anvil.dom;
        if (dom && typeof dom.unlockScroll === 'function') dom.unlockScroll();
        if (this.opener) {
          this.opener.setAttribute('aria-expanded', 'false');
          if (typeof this.opener.focus === 'function') this.opener.focus();
        }
        this.opener = null;
      };
    });
  }
{% endjavascript %}
{% stylesheet %}
  .av-cart-drawer {
    display: contents;
  }
  .av-cart-drawer__dialog {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(100%, var(--av-drawer-width, 420px));
    height: 100dvh;
    max-height: none;
    max-width: none;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: var(--av-radius-drawer) 0 0 var(--av-radius-drawer);
    background: var(--av-bg);
    color: var(--av-fg);
    box-shadow: var(--av-shadow-drawer);
  }
  .av-cart-drawer__dialog[open] {
    display: flex;
    flex-direction: column;
  }
  .av-cart-drawer__dialog::backdrop {
    background: rgb(0 0 0 / 0.45);
  }
  .av-cart-drawer__head {
    display: flex;
    align-items: center;
    gap: var(--av-space-3);
    padding: var(--av-space-4);
    border-bottom: 1px solid var(--av-border);
  }
  .av-cart-drawer__title {
    margin: 0;
    font-size: var(--av-text-lg);
  }
  .av-cart-drawer__count {
    font-size: var(--av-text-sm);
  }
  .av-cart-drawer__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-left: auto;
    color: inherit;
    background: none;
    border: 0;
    border-radius: var(--av-radius-button);
    cursor: pointer;
  }
  .av-cart-drawer__form {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
  }
  .av-cart-drawer__body {
    flex: 1 1 auto;
    overflow-y: auto;
    padding: var(--av-space-4);
  }
  .av-cart-drawer__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--av-space-4);
    padding: var(--av-space-8) 0;
    text-align: center;
  }
  .av-cart-drawer__empty-text {
    margin: 0;
    font-size: var(--av-text-md);
  }
  .av-cart-drawer__lines {
    display: flex;
    flex-direction: column;
    gap: var(--av-space-4);
  }
  .av-cart-drawer__line {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    gap: var(--av-space-3);
    align-items: start;
  }
  .av-cart-drawer__line[aria-busy="true"] {
    opacity: 0.6;
  }
  .av-cart-drawer__media {
    display: block;
    width: 80px;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--av-radius-media);
    background: rgb(var(--av-fg-rgb) / 0.05);
  }
  .av-cart-drawer__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .av-cart-drawer__name {
    color: inherit;
    text-decoration: none;
    font-weight: 600;
  }
  .av-cart-drawer__name:hover {
    text-decoration: underline;
  }
  .av-cart-drawer__meta {
    margin: var(--av-space-1) 0 0;
    font-size: var(--av-text-xs);
    color: var(--av-fg-muted);
  }
  .av-cart-drawer__meta--discount {
    color: var(--av-fg);
  }
  .av-cart-drawer__controls {
    display: flex;
    align-items: center;
    gap: var(--av-space-3);
    margin-top: var(--av-space-2);
  }
  .av-cart-drawer__step {
    font: inherit;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .av-cart-drawer__remove {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    font-size: var(--av-text-xs);
    color: var(--av-fg-muted);
    text-underline-offset: 0.15em;
  }
  .av-cart-drawer__price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--av-space-1);
    font-size: var(--av-text-sm);
  }
  .av-cart-drawer__foot {
    padding: var(--av-space-4);
    border-top: 1px solid var(--av-border);
    background: var(--av-bg);
  }
  .av-cart-drawer__foot:empty {
    display: none;
  }
  .av-cart-drawer__note {
    margin-bottom: var(--av-space-3);
  }
  .av-cart-drawer__textarea {
    min-height: 0;
    resize: vertical;
  }
  .av-cart-drawer__row {
    display: flex;
    justify-content: space-between;
    gap: var(--av-space-3);
    margin-top: var(--av-space-1);
    font-size: var(--av-text-sm);
  }
  .av-cart-drawer__row--total {
    font-size: var(--av-text-md);
    font-weight: 700;
  }
  .av-cart-drawer__tax {
    margin: var(--av-space-1) 0 var(--av-space-3);
    font-size: var(--av-text-xs);
  }
  .av-cart-drawer__actions {
    display: flex;
    flex-direction: column;
    gap: var(--av-space-2);
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "paragraph",
      "content": "Width, open-after-add and the order note are set under Theme settings > Cart and Drawers."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your cart"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "drawer_preview_open",
      "label": "Keep open while editing",
      "info": "Only affects the theme editor so you can style the drawer.",
      "default": false
    }
  ],
  "blocks": []
}
{% endschema %}
