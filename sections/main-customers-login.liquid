{{ 'anvil-sec-main-customers-login.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign login_label = 'anvil.customer.login.submit' | t
  assign reset_label = 'anvil.customer.login.reset_submit' | t
-%}
<div {% render 'anvil-section-attrs', section: section, type: 'main-customers-login' %}>
  <div class="av-section__inner">
    {% render 'anvil-section-head', section: section %}
    <div class="av-customers-login">
      <div class="av-customers-login__panel">
        <h1 class="av-customers-login__title">{{ s.title | escape }}</h1>
        {%- form 'customer_login', id: 'anvil-login-form', class: 'av-customers-login__form' -%}
          {%- if form.errors -%}
            <div class="av-customers-login__notice av-form-message av-form-message--error" id="anvil-login-form-errors" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="av-customers-login__field av-field">
            <label class="av-customers-login__label av-field__label" for="anvil-login-email">{{ 'anvil.customer.email' | t }}</label>
            <input class="av-customers-login__input av-field__input" id="anvil-login-email" type="email" name="customer[email]" autocomplete="email" autocorrect="off" autocapitalize="off" required aria-required="true"{% if form.errors %} aria-invalid="true" aria-describedby="anvil-login-form-errors"{% endif %}>
          </div>
          {%- if form.password_needed -%}
            <div class="av-customers-login__field av-field">
              <label class="av-customers-login__label av-field__label" for="anvil-login-password">{{ 'anvil.customer.password' | t }}</label>
              <input class="av-customers-login__input av-field__input" id="anvil-login-password" type="password" name="customer[password]" autocomplete="current-password" required aria-required="true"{% if form.errors %} aria-invalid="true" aria-describedby="anvil-login-form-errors"{% endif %}>
            </div>
            <a class="av-customers-login__link" href="#recover">{{ 'anvil.customer.login.forgot' | t }}</a>
          {%- endif -%}
          <div class="av-customers-login__actions">
            {% render 'anvil-button', label: login_label, style: 'primary', size: 'lg', full: true, type: 'submit' %}
          </div>
        {%- endform -%}
        <p class="av-customers-login__alt">{{ 'anvil.customer.login.new_here' | t }} <a class="av-customers-login__link" href="{{ routes.account_register_url }}">{{ 'anvil.customer.login.create' | t }}</a></p>
      </div>

      <div class="av-customers-login__panel av-customers-login__panel--recover" id="recover">
        <h2 class="av-customers-login__subtitle">{{ 'anvil.customer.login.reset_title' | t }}</h2>
        {%- form 'recover_customer_password', id: 'anvil-recover-form', class: 'av-customers-login__form' -%}
          {%- if form.posted_successfully? -%}
            <p class="av-customers-login__notice av-form-message av-form-message--success" role="status" tabindex="-1" autofocus>{{ 'anvil.customer.login.reset_success' | t }}</p>
          {%- elsif form.errors -%}
            <div class="av-customers-login__notice av-form-message av-form-message--error" id="anvil-recover-form-errors" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <p class="av-customers-login__hint">{{ 'anvil.customer.login.reset_hint' | t }}</p>
          <div class="av-customers-login__field av-field">
            <label class="av-customers-login__label av-field__label" for="anvil-recover-email">{{ 'anvil.customer.email' | t }}</label>
            <input class="av-customers-login__input av-field__input" id="anvil-recover-email" type="email" name="email" value="{{ form.email }}" autocomplete="email" autocorrect="off" autocapitalize="off" required aria-required="true"{% if form.errors %} aria-invalid="true" aria-describedby="anvil-recover-form-errors"{% endif %}>
          </div>
          <div class="av-customers-login__actions">
            {% render 'anvil-button', label: reset_label, style: 'secondary', size: 'md', type: 'submit' %}
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer login",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "select", "id": "width", "label": "Width", "options": [ {"value":"page","label":"Page width"}, {"value":"narrow","label":"Narrow"}, {"value":"full","label":"Full width"} ], "default": "page" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "select", "id": "pad_mobile", "label": "Padding on phones", "options": [ {"value":"same","label":"Same as desktop"}, {"value":"compact","label":"Compact"}, {"value":"none","label":"None"} ], "default": "compact" },
    { "type": "header", "content": "Customer login" },
    {
      "type": "text",
      "id": "title",
      "label": "Page title",
      "default": "Log in"
    }
  ]
}
{% endschema %}
