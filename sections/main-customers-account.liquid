{%- liquid
  assign s = section.settings
-%}
<div {% render 'anvil-section-attrs', section: section, type: 'main-customers-account' %}>
  <div class="av-section__inner">
    {% render 'anvil-section-head', section: section %}
    <div class="av-customers-account">
      <div class="av-customers-account__head">
        <h1 class="av-customers-account__title">{{ s.title | escape }}</h1>
        <a class="av-customers-account__logout" href="{{ routes.account_logout_url }}">{{ 'anvil.customer.account.logout' | t }}</a>
      </div>
      <div class="av-customers-account__layout">
        <section class="av-customers-account__orders" aria-labelledby="anvil-orders-title">
          <h2 class="av-customers-account__subtitle" id="anvil-orders-title">{{ 'anvil.customer.account.order_history' | t }}</h2>
          {%- paginate customer.orders by 20 -%}
            {%- if customer.orders.size > 0 -%}
              {%- comment -%}
                Explicit table roles keep the table, rows and headers announced when the rows become grids on
                phones; the per-cell labels shown there are aria-hidden copies of the column headers.
              {%- endcomment -%}
              <table class="av-customers-account__table" role="table">
                <caption class="av-visually-hidden">{{ 'anvil.customer.account.order_history' | t }}</caption>
                <thead class="av-customers-account__thead" role="rowgroup">
                  <tr role="row">
                    <th scope="col" role="columnheader">{{ 'anvil.customer.orders.order' | t }}</th>
                    <th scope="col" role="columnheader">{{ 'anvil.customer.orders.date' | t }}</th>
                    <th scope="col" role="columnheader">{{ 'anvil.customer.orders.payment' | t }}</th>
                    <th scope="col" role="columnheader">{{ 'anvil.customer.orders.fulfilment' | t }}</th>
                    <th scope="col" role="columnheader" class="av-customers-account__num">{{ 'anvil.customer.orders.total' | t }}</th>
                  </tr>
                </thead>
                <tbody role="rowgroup">
                  {%- for order in customer.orders -%}
                    <tr role="row">
                      <td role="cell"><span class="av-customers-account__cell-label" aria-hidden="true">{{ 'anvil.customer.orders.order' | t }}</span><a class="av-customers-account__link" href="{{ order.customer_url }}">{{ order.name }}</a></td>
                      <td role="cell"><span class="av-customers-account__cell-label" aria-hidden="true">{{ 'anvil.customer.orders.date' | t }}</span>{{ order.created_at | time_tag: format: 'anvil_date' }}</td>
                      <td role="cell"><span class="av-customers-account__cell-label" aria-hidden="true">{{ 'anvil.customer.orders.payment' | t }}</span>{{ order.financial_status_label }}</td>
                      <td role="cell"><span class="av-customers-account__cell-label" aria-hidden="true">{{ 'anvil.customer.orders.fulfilment' | t }}</span>{{ order.fulfillment_status_label }}</td>
                      <td role="cell" class="av-customers-account__num"><span class="av-customers-account__cell-label" aria-hidden="true">{{ 'anvil.customer.orders.total' | t }}</span>{% render 'anvil-money', amount: order.total_price %}</td>
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
              {% render 'anvil-pagination', paginate: paginate %}
            {%- else -%}
              <p class="av-customers-account__empty">{{ 'anvil.customer.account.no_orders' | t }}</p>
            {%- endif -%}
          {%- endpaginate -%}
        </section>
        <aside class="av-customers-account__details" aria-labelledby="anvil-details-title">
          <h2 class="av-customers-account__subtitle" id="anvil-details-title">{{ 'anvil.customer.account.details' | t }}</h2>
          <p class="av-customers-account__name">{{ customer.name | escape }}</p>
          <p class="av-customers-account__email">{{ customer.email }}</p>
          {%- if customer.default_address -%}
            <address class="av-customers-account__address">{{ customer.default_address | format_address }}</address>
          {%- endif -%}
          <a class="av-customers-account__link" href="{{ routes.account_addresses_url }}">{{ 'anvil.customer.account.view_addresses' | t: count: customer.addresses_count }}</a>
        </aside>
      </div>
    </div>
  </div>
</div>
{% stylesheet %}
.av-customers-account__head{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:var(--av-space-3);margin-bottom:var(--av-space-6)}
.av-customers-account__title{margin:0;font-size:var(--av-text-3xl)}
.av-customers-account__logout,.av-customers-account__link{color:inherit;text-underline-offset:0.2em}
.av-customers-account__layout{display:grid;grid-template-columns:1fr;gap:var(--av-space-6)}
.av-customers-account__subtitle{margin:0 0 var(--av-space-3);font-size:var(--av-text-lg)}
.av-customers-account__table{width:100%;border-collapse:collapse;font-size:var(--av-text-sm)}
.av-customers-account__thead{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
.av-customers-account__table tr{display:grid;grid-template-columns:1fr 1fr;gap:var(--av-space-1) var(--av-space-3);padding:var(--av-space-3) 0;border-bottom:1px solid var(--av-border)}
.av-customers-account__table td{padding:0}
.av-customers-account__cell-label{display:block;font-size:var(--av-text-xs);color:var(--av-fg-muted)}
.av-customers-account__empty{color:var(--av-fg-muted)}
.av-customers-account__name,.av-customers-account__email{margin:0 0 var(--av-space-1)}
.av-customers-account__address{font-style:normal;margin:var(--av-space-3) 0;color:var(--av-fg-muted)}
@media (min-width: 750px){
.av-customers-account__thead{position:static;width:auto;height:auto;overflow:visible;clip-path:none;white-space:normal}
.av-customers-account__table th{text-align:left;font-size:var(--av-text-xs);text-transform:uppercase;letter-spacing:0.08em;color:var(--av-fg-muted);padding:0 var(--av-space-3) var(--av-space-2) 0;border-bottom:1px solid var(--av-border)}
.av-customers-account__table tr{display:table-row}
.av-customers-account__table td{padding:var(--av-space-3) var(--av-space-3) var(--av-space-3) 0;border-bottom:1px solid var(--av-border)}
.av-customers-account__cell-label{display:none}
.av-customers-account__num{text-align:right;padding-right:0}
}
@media (min-width: 990px){
.av-customers-account__layout{grid-template-columns:minmax(0, 2fr) minmax(0, 1fr)}
}
{% endstylesheet %}
{% schema %}
{
  "name": "Customer account",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "select", "id": "width", "label": "Width", "options": [ {"value":"page","label":"Page width"}, {"value":"narrow","label":"Narrow"}, {"value":"full","label":"Full width"} ], "default": "page" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "select", "id": "pad_mobile", "label": "Padding on phones", "options": [ {"value":"same","label":"Same as desktop"}, {"value":"compact","label":"Compact"}, {"value":"none","label":"None"} ], "default": "compact" },
    { "type": "header", "content": "Customer account" },
    {
      "type": "text",
      "id": "title",
      "label": "Page title",
      "default": "My account"
    }
  ]
}
{% endschema %}
