{%- liquid
  assign s = section.settings
-%}
<div {% render 'anvil-section-attrs', section: section, type: 'main-customers-activate' %}>
  <div class="av-section__inner">
    {% render 'anvil-section-head', section: section %}
    <div class="av-customers-activate">
      <h1 class="av-customers-activate__title">{{ s.heading | escape }}</h1>
      <p class="av-customers-activate__hint">Create a password to activate your account.</p>
      {%- form 'activate_customer_password', id: 'anvil-activate-form', class: 'av-customers-activate__form' -%}
        {%- if form.errors -%}
          <div class="av-customers-activate__notice av-form-message av-form-message--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="av-customers-activate__field av-field">
          <label class="av-customers-activate__label av-field__label" for="anvil-activate-password">Password</label>
          <input class="av-customers-activate__input av-field__input" id="anvil-activate-password" type="password" name="customer[password]" autocomplete="new-password" required aria-required="true">
        </div>
        <div class="av-customers-activate__field av-field">
          <label class="av-customers-activate__label av-field__label" for="anvil-activate-confirm">Confirm password</label>
          <input class="av-customers-activate__input av-field__input" id="anvil-activate-confirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required aria-required="true">
        </div>
        <div class="av-customers-activate__actions">
          {% render 'anvil-button', label: 'Activate account', style: 'primary', size: 'lg', full: true, type: 'submit' %}
          {% render 'anvil-button', label: 'Decline invitation', style: 'link', size: 'md', type: 'submit', attrs: 'name="decline"' %}
        </div>
      {%- endform -%}
    </div>
  </div>
</div>
{% stylesheet %}
  .av-customers-activate {
    max-width: 480px;
    margin: 0 auto;
  }
  .av-customers-activate__title {
    margin: 0 0 var(--av-space-2);
    font-size: var(--av-text-2xl);
  }
  .av-customers-activate__hint {
    margin: 0 0 var(--av-space-4);
    color: var(--av-fg-muted);
  }
  .av-customers-activate__form {
    display: flex;
    flex-direction: column;
    gap: var(--av-space-3);
  }
  
  
  
  
  .av-customers-activate__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--av-space-3);
    margin-top: var(--av-space-2);
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Activate account",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "select", "id": "width", "label": "Width", "options": [ {"value":"page","label":"Page width"}, {"value":"narrow","label":"Narrow"}, {"value":"full","label":"Full width"} ], "default": "page" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "select", "id": "pad_mobile", "label": "Padding on phones", "options": [ {"value":"same","label":"Same as desktop"}, {"value":"compact","label":"Compact"}, {"value":"none","label":"None"} ], "default": "compact" },
    { "type": "header", "content": "Activate account" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Activate your account"
    }
  ]
}
{% endschema %}
