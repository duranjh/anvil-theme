<anvil-cart-bubble class="av-cart-bubble" data-anvil-section="anvil-cart-bubble" data-section-id="{{ section.id }}"{% if cart.item_count == 0 %} hidden{% endif %}>
  <span class="av-cart-bubble__count" data-anvil-count="{{ cart.item_count }}" aria-hidden="true">{{ cart.item_count }}</span>
  <span class="av-visually-hidden">{{ 'anvil.cart.item_count' | t: count: cart.item_count }}</span>
</anvil-cart-bubble>
{% stylesheet %}
  .av-cart-bubble__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    font-size: var(--av-text-xs);
    font-weight: 700;
    line-height: 1;
    color: var(--av-on-accent);
    background: var(--av-accent);
    border-radius: var(--av-radius-pill);
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Cart bubble",
  "settings": []
}
{% endschema %}
