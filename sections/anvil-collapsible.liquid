{%- liquid
  assign s = section.settings
  assign untitled_label = 'anvil.collapsible.untitled_row' | t
  assign no_content_label = 'anvil.collapsible.no_content' | t

  # Layout: rows only, or an image beside the rows from 750 px (stacked above or below them on phones).
  assign layout = s.layout | default: 'rows'
  assign side = s.image_side | default: 'left'
  assign side_mobile = s.image_side_mobile | default: 'top'
  assign media_w = s.image_width | default: 50

  assign wrap_class = 'av-collapsible av-collapsible--' | append: layout
  if layout == 'image'
    assign wrap_class = wrap_class | append: ' av-collapsible--' | append: side | append: ' av-collapsible--m-' | append: side_mobile
  endif

  # Rows use the shared accordion (assets/anvil-accordion.css): item_style lines | cards, toggle_icon chevron | plus.
  assign item_style = s.item_style | default: 'lines'
  assign toggle_pos = s.icon_position | default: 'end'
  assign icon_color = s.icon_color | default: 'accent'
  assign rows_class = 'av-collapsible__rows av-accordion av-accordion--' | append: item_style
  assign rows_class = rows_class | append: ' av-collapsible__rows--toggle-' | append: toggle_pos
  assign rows_class = rows_class | append: ' av-collapsible__rows--icon-' | append: icon_color
  assign icon_px = s.icon_size | default: 24
  assign icon_img_px = icon_px | times: 2
  assign icon_img_widths = icon_px | append: ', ' | append: icon_img_px
  assign icon_img_sizes = icon_px | append: 'px'

  # Row titles are h3 under the section's h2; with no section heading a visually hidden h2 takes its place
  # (anvil-section-head fallback), so the outline never jumps from the page's h1 to an h3.

  # The open and close icon is rendered once here and printed per row.
  capture toggle_html
    if s.toggle_icon == 'plus'
      echo '<span class="av-accordion__open">'
      render 'anvil-icon', name: 'plus', size: 20
      echo '</span><span class="av-accordion__close">'
      render 'anvil-icon', name: 'minus', size: 20
      echo '</span>'
    else
      render 'anvil-icon', name: 'chevron-down', size: 20
    endif
  endcapture

  # One pass over the rows: long-form page content needs the prose stylesheet (loaded only when a row
  # shows a page), and the storefront draws the rows wrapper only when at least one row has a name and a body.
  assign has_page = false
  assign row_count = 0
  for block in section.blocks
    assign pre_name = block.settings.heading | strip
    if block.settings.page != blank
      assign has_page = true
      if pre_name == blank
        assign pre_name = block.settings.page.title | strip
      endif
    endif
    if pre_name != blank
      if block.settings.content != blank or block.settings.page != blank
        assign row_count = row_count | plus: 1
      endif
    endif
  endfor
  if request.design_mode
    assign row_count = section.blocks.size
  endif
  assign solo = false
  if layout == 'image' and row_count == 0
    assign solo = true
    assign wrap_class = wrap_class | append: ' av-collapsible--solo'
  endif

  # The storefront hides the whole section (head and padding too) when the Rows only layout has no row to show.
  assign show = true
  if layout == 'rows' and row_count == 0
    assign show = false
  endif
  if request.design_mode
    assign show = true
  endif

  # Output of t is already HTML-escaped (keys without _html), so it is printed as is.
  assign table_label = 'anvil.a11y.scroll_table' | t
  assign table_open = '<div class="av-prose__table" tabindex="0" role="region" aria-label="' | append: table_label | append: '"><table'

  # A chosen page's headings sit one level below the h3 row heading: h1-h3 become h4, so page content never adds
  # a second h1 or jumps back above the row title.
  assign page_h = 'h4'
  assign page_h_open = '<' | append: page_h
  assign page_h_close = '</' | append: page_h | append: '>'

  # Image sizes. From 750 px the media column is media_w % of the inner width, but the CSS keeps at least 20rem
  # (320 px) plus the 48 px gap for the rows, and never less than 30 %. sizes mirrors that with upper bounds:
  # media_w vw from clamp_bp (where media_w % becomes the smaller value), calc(100vw - 368px) below it, and the page
  # or narrow width as the cap. With no rows (--solo) the image fills the inner width.
  assign max_inner = settings.page_width | default: 1400
  if s.width == 'narrow'
    assign max_inner = settings.narrow_width | default: 800
  endif
  assign cap_bp = max_inner | at_least: 750
  if solo
    if s.width == 'full'
      assign img_widths = '375, 550, 750, 1100, 1500, 2200'
      assign img_sizes = '100vw'
    else
      assign img_widths = '375, 550, 750, 1100, 1500'
      assign img_sizes = '(min-width: ' | append: cap_bp | append: 'px) ' | append: max_inner | append: 'px, 100vw'
    endif
  else
    assign media_rest = 100 | minus: media_w | at_least: 1
    assign clamp_bp = 36800 | divided_by: media_rest
    assign img_sizes_desk = '(min-width: 750px) ' | append: media_w | append: 'vw'
    if clamp_bp > 750
      assign img_sizes_desk = '(min-width: ' | append: clamp_bp | append: 'px) ' | append: media_w | append: 'vw, (min-width: 750px) calc(100vw - 368px)'
    endif
    if s.width == 'full'
      assign img_widths = '375, 550, 750, 900, 1100, 1500'
      assign img_sizes = img_sizes_desk | append: ', 100vw'
    else
      assign img_widths = '375, 550, 750, 900, 1100'
      assign media_floor = max_inner | times: 30 | divided_by: 100
      assign media_max = max_inner | minus: 368 | at_least: media_floor
      assign media_px = max_inner | times: media_w | divided_by: 100 | at_most: media_max
      if clamp_bp >= cap_bp
        assign img_sizes_desk = '(min-width: 750px) calc(100vw - 368px)'
      endif
      assign img_sizes = '(min-width: ' | append: cap_bp | append: 'px) ' | append: media_px | append: 'px, '
      if cap_bp > 750
        assign img_sizes = img_sizes | append: img_sizes_desk | append: ', '
      endif
      assign img_sizes = img_sizes | append: '100vw'
    endif
  endif

  # Media in the first two template sections (snippets/anvil-above-fold) loads eagerly; in the first section it is
  # the likely LCP image.
  capture fold
    render 'anvil-above-fold', section: section
  endcapture
  assign fold = fold | strip
  assign media_loading = 'eager'
  assign media_priority = false
  if fold == 'lazy'
    assign media_loading = 'lazy'
  elsif fold == 'lcp'
    assign media_priority = true
  endif

  assign opened = false
-%}
{%- if show -%}
<div {% render 'anvil-section-attrs', section: section, type: 'anvil-collapsible' %}>
  <div class="av-section__inner">
    {%- liquid
      assign fallback = ''
      if row_count > 0
        assign fallback = 'anvil.collapsible.heading' | t
      endif
    -%}
    {% render 'anvil-section-head', section: section, fallback: fallback %}
    {{ 'anvil-accordion.css' | asset_url | stylesheet_tag }}
    {%- if has_page -%}
      {{ 'anvil-prose.css' | asset_url | stylesheet_tag }}
    {%- endif -%}
    <div class="{{ wrap_class }}" style="--av-collapsible-media: {{ media_w }}%; --av-collapsible-icon: {{ icon_px }}px;">
      {%- if layout == 'image' -%}
        <div class="av-collapsible__media{% if s.image_sticky %} av-collapsible__media--sticky{% endif %}">
          {%- render 'anvil-media',
            image: s.image,
            ratio: s.image_ratio,
            widths: img_widths,
            sizes: img_sizes,
            loading: media_loading,
            priority: media_priority,
            placeholder: 'lifestyle-2'
          -%}
        </div>
      {%- endif -%}
      {%- if row_count > 0 -%}
        <anvil-collapsible class="{{ rows_class }}"{% if s.single_open %} single{% endif %}>
          {%- for block in section.blocks -%}
            {%- liquid
              assign b = block.settings

              # The row's name: its heading, else the page title. A disclosure without a name, or one
              # that opens onto nothing, is skipped on the storefront; the editor keeps it with a note.
              # Merchant text is escaped here; the untitled label comes from t, which is already escaped.
              assign row_name = b.heading | strip | escape
              if row_name == blank and b.page != blank
                assign row_name = b.page.title | strip | escape
              endif
              assign has_body = false
              if b.content != blank or b.page != blank
                assign has_body = true
              endif
              unless request.design_mode
                if row_name == blank or has_body == false
                  continue
                endif
              endunless
              if row_name == blank
                assign row_name = untitled_label
              endif

              assign open_attr = ''
              if s.open_first and opened == false
                assign open_attr = ' open'
                assign opened = true
              endif

              assign page_body = ''
              if b.page != blank
                assign page_body = b.page.content | replace: '<table', table_open | replace: '</table>', '</table></div>'
                assign page_body = page_body | replace: '<h1', page_h_open | replace: '</h1>', page_h_close | replace: '<h2', page_h_open | replace: '</h2>', page_h_close | replace: '<h3', page_h_open | replace: '</h3>', page_h_close
              endif
            -%}
            <details class="av-accordion__item"{{ open_attr }} {{ block.shopify_attributes }}>
              <summary class="av-accordion__summary">
                {%- if toggle_pos == 'start' -%}
                  <span class="av-accordion__toggle" aria-hidden="true">{{ toggle_html }}</span>
                {%- endif -%}
                {%- if b.icon_image != blank -%}
                  <span class="av-collapsible__icon">
                    {{- b.icon_image | image_url: width: icon_img_px | image_tag: widths: icon_img_widths, sizes: icon_img_sizes, loading: media_loading, alt: '' -}}
                  </span>
                {%- elsif b.icon != blank and b.icon != 'none' -%}
                  <span class="av-collapsible__icon">{% render 'anvil-icon', name: b.icon, size: icon_px %}</span>
                {%- endif -%}
                <h3 class="av-accordion__title">{{ row_name }}</h3>
                {%- if toggle_pos != 'start' -%}
                  <span class="av-accordion__toggle" aria-hidden="true">{{ toggle_html }}</span>
                {%- endif -%}
              </summary>
              <div class="av-collapsible__body">
                <div class="av-accordion__body av-collapsible__content">
                  {%- if b.content != blank -%}
                    <div class="av-collapsible__text av-rte">{{ b.content }}</div>
                  {%- endif -%}
                  {%- if page_body != blank -%}
                    <div class="av-collapsible__page av-prose">{{ page_body }}</div>
                  {%- endif -%}
                  {%- unless has_body -%}
                    <p class="av-collapsible__note av-example-note">{{ no_content_label }}</p>
                  {%- endunless -%}
                </div>
              </div>
            </details>
          {%- endfor -%}
        </anvil-collapsible>
      {%- else -%}
        {% render 'anvil-editor-empty' %}
      {%- endif -%}
    </div>
  </div>
</div>
{%- endif -%}
{% stylesheet %}
/* Rows, toggle and cards come from the shared accordion (assets/anvil-accordion.css); the image layout is here. */
.av-collapsible{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--av-space-6);align-items:start}
.av-collapsible--m-bottom .av-collapsible__media{order:1}
.av-collapsible__icon{flex:none;display:inline-flex;width:var(--av-collapsible-icon,24px);height:var(--av-collapsible-icon,24px);color:var(--av-accent)}
.av-collapsible__rows--icon-text .av-collapsible__icon{color:inherit}
.av-collapsible__icon > svg,.av-collapsible__icon > img{display:block;width:100%;height:100%;object-fit:contain}
.av-collapsible__content > * + *{margin-top:var(--av-space-4)}
.av-collapsible__text > :first-child,.av-collapsible__page > :first-child{margin-top:0}
.av-collapsible__text > :last-child,.av-collapsible__page > :last-child{margin-bottom:0}
@media (min-width: 750px){
.av-collapsible--image{--av-collapsible-gap:var(--av-space-7);--av-collapsible-col:max(30%,min(var(--av-collapsible-media,50%),calc(100% - 20rem - var(--av-collapsible-gap))));grid-template-columns:var(--av-collapsible-col) minmax(0,1fr);gap:var(--av-collapsible-gap)}
.av-collapsible--image.av-collapsible--right{grid-template-columns:minmax(0,1fr) var(--av-collapsible-col)}
.av-collapsible--image .av-collapsible__media{order:0}
.av-collapsible--right .av-collapsible__media{order:1}
.av-collapsible--image.av-collapsible--solo{grid-template-columns:minmax(0,1fr)}
.av-collapsible__media--sticky{position:sticky;top:calc(var(--av-header-h, 0px) + var(--av-space-5))}
}
@media (min-width: 990px){
.av-collapsible--image{--av-collapsible-gap:var(--av-space-8)}
}
{% endstylesheet %}
{% schema %}
{
  "name": "Collapsible content",
  "max_blocks": 20,
  "disabled_on": { "groups": ["header", "custom.overlay"] },
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Bold a word to colour it with the accent" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "text_alignment", "id": "head_align", "label": "Heading alignment", "default": "center" },
    { "type": "select", "id": "head_size", "label": "Heading size", "options": [ {"value":"xs","label":"Extra small"}, {"value":"sm","label":"Small"}, {"value":"md","label":"Medium"}, {"value":"lg","label":"Large"}, {"value":"xl","label":"Extra large"} ], "default": "lg" },
    { "type": "select", "id": "accent_style", "label": "Accent style for bold words", "options": [ {"value":"color","label":"Accent colour"}, {"value":"underline","label":"Underline"}, {"value":"highlight","label":"Highlight"}, {"value":"gradient","label":"Gradient"} ], "default": "color" },
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "select", "id": "width", "label": "Width", "options": [ {"value":"page","label":"Page width"}, {"value":"narrow","label":"Narrow"}, {"value":"full","label":"Full width"} ], "default": "page" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "select", "id": "pad_mobile", "label": "Padding on phones", "options": [ {"value":"same","label":"Same as desktop"}, {"value":"compact","label":"Compact"}, {"value":"none","label":"None"} ], "default": "compact" },
    { "type": "select", "id": "reveal", "label": "Animate on scroll", "options": [ {"value":"none","label":"Off"}, {"value":"fade-up","label":"Fade up"}, {"value":"fade","label":"Fade"}, {"value":"zoom","label":"Zoom"} ], "default": "none" },
    { "type": "select", "id": "show_on", "label": "Show on", "options": [ {"value":"all","label":"All devices"}, {"value":"mobile","label":"Phones only"}, {"value":"desktop","label":"Desktop only"} ], "default": "all" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "info": "Letters, numbers and hyphens. Link to this section with #your-id" },
    { "type": "header", "content": "Collapsible content" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "rows", "label": "Rows only" },
        { "value": "image", "label": "Image and rows" }
      ],
      "default": "rows"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "A placeholder illustration shows until you pick an image.",
      "visible_if": "{{ section.settings.layout == 'image' }}"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "adapt", "label": "Original" },
        { "value": "1:1", "label": "Square (1:1)" },
        { "value": "4:5", "label": "Portrait (4:5)" },
        { "value": "3:4", "label": "Portrait (3:4)" },
        { "value": "16:9", "label": "Landscape (16:9)" }
      ],
      "default": "adapt",
      "visible_if": "{{ section.settings.layout == 'image' }}"
    },
    {
      "type": "range",
      "id": "image_width",
      "visible_if": "{{ section.settings.layout == 'image' }}",
      "label": "Image width on desktop",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 50,
      "info": "The rows keep at least 320 px where the space allows, so on smaller screens the image can be narrower than this."
    },
    {
      "type": "select",
      "id": "image_side",
      "visible_if": "{{ section.settings.layout == 'image' }}",
      "label": "Image position on desktop",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_side_mobile",
      "visible_if": "{{ section.settings.layout == 'image' }}",
      "label": "Image position on phones",
      "options": [
        { "value": "top", "label": "Above the rows" },
        { "value": "bottom", "label": "Below the rows" }
      ],
      "default": "top"
    },
    {
      "type": "checkbox",
      "id": "image_sticky",
      "visible_if": "{{ section.settings.layout == 'image' }}",
      "label": "Keep the image in view while scrolling",
      "info": "Desktop only. Helps when long rows are open.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first row",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "single_open",
      "label": "Close other rows when one opens",
      "default": false
    },
    {
      "type": "select",
      "id": "item_style",
      "label": "Item style",
      "options": [
        { "value": "lines", "label": "Divider lines" },
        { "value": "cards", "label": "Cards" }
      ],
      "default": "lines"
    },
    {
      "type": "select",
      "id": "toggle_icon",
      "label": "Open and close icon",
      "options": [
        { "value": "chevron", "label": "Chevron" },
        { "value": "plus", "label": "Plus and minus" }
      ],
      "default": "chevron"
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Open and close icon position",
      "options": [
        { "value": "end", "label": "End of the row" },
        { "value": "start", "label": "Start of the row" }
      ],
      "default": "end"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Row icon size",
      "min": 16,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "icon_color",
      "label": "Row icon colour",
      "options": [
        { "value": "accent", "label": "Accent" },
        { "value": "text", "label": "Text colour" }
      ],
      "default": "accent"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "info", "label": "Info" },
            { "value": "help-circle", "label": "Question mark" },
            { "value": "check-circle", "label": "Check in circle" },
            { "value": "badge-check", "label": "Badge check" },
            { "value": "truck", "label": "Truck" },
