{%- liquid
  assign s = section.settings
  assign menu = s.menu
  assign menu_label = 'anvil.a11y.menu' | t
  assign close_label = 'anvil.a11y.close' | t
  assign update_label = 'anvil.localization.update' | t
  if customer
    assign account_url = routes.account_url
  else
    assign account_url = routes.account_login_url
  endif
  assign show_country = false
  if s.show_country and localization.available_countries.size > 1
    assign show_country = true
  endif
  assign show_language = false
  if s.show_language and localization.available_languages.size > 1
    assign show_language = true
  endif

  assign scheme_bg = s.color_scheme.settings.background | default: '#ffffff'
  assign scheme_dark = false
  assign brightness = scheme_bg | color_brightness
  if brightness < 128
    assign scheme_dark = true
  endif

  # Transparent over the first section: on the homepage, or on the templates the merchant lists (a template is named
  # like "index", "collection" or "page.landing", the name plus any suffix).
  assign transparent = false
  assign transparent_mode = s.transparent_mode | default: 'none'
  if transparent_mode == 'home' and template.name == 'index'
    assign transparent = true
  elsif transparent_mode == 'custom'
    assign tpl_full = template.name
    if template.suffix != blank
      assign tpl_full = template.name | append: '.' | append: template.suffix
    endif
    assign tpl_list = s.transparent_templates | remove: ' ' | downcase | split: ','
    if tpl_list contains tpl_full or tpl_list contains template.name
      assign transparent = true
    endif
  endif
  assign over_dark = false
  if transparent
    assign over_bg = s.transparent_scheme.settings.background | default: '#000000'
    assign over_brightness = over_bg | color_brightness
    if over_brightness < 128
      assign over_dark = true
    endif
  endif

  comment
    Logo: the header's own image, else the theme logo. The theme's light logo replaces it on a dark header
    scheme, and swaps in while the header is transparent over a dark first section.
  endcomment
  assign logo = s.logo | default: settings.logo
  assign logo_light = settings.logo_light
  assign main_logo = logo
  if scheme_dark and logo_light != blank
    assign main_logo = logo_light
  endif
  assign over_logo = nil
  if transparent and over_dark and logo_light != blank and main_logo != logo_light
    assign over_logo = logo_light
  endif
  assign logo_w = settings.logo_width
  assign logo_w_m = settings.logo_width_mobile
  assign logo_w2 = logo_w | times: 2
  assign logo_widths = logo_w_m | append: ', ' | append: logo_w | append: ', ' | append: logo_w2
  assign logo_sizes = '(min-width: 750px) ' | append: logo_w | append: 'px, ' | append: logo_w_m | append: 'px'

  if transparent
    comment
      The header overlaps the first section by its own height. The height is computed here from the
      padding and the logo size, so nothing moves when scripts run (no layout shift).
    endcomment
    case s.pad_mobile
      when 'same'
        assign pad_scale = 1
      when 'none'
        assign pad_scale = 0
      else
        assign pad_scale = 0.6
    endcase
    assign logo_h_m = 28
    assign logo_h_d = 28
    if main_logo != blank
      assign logo_h_m = logo_w_m | divided_by: main_logo.aspect_ratio | round
      assign logo_h_d = logo_w | divided_by: main_logo.aspect_ratio | round
    endif
    assign bar_m = logo_h_m | at_least: 56
    assign bar_d = logo_h_d | at_least: 56
    assign pads = s.pad_top | plus: s.pad_bottom
    assign overlap_m = pads | times: pad_scale | plus: bar_m | round
    assign overlap_t = pads | plus: bar_d
    assign overlap_d = overlap_t
    if s.menu_position == 'below'
      assign overlap_d = overlap_t | plus: 48
    endif
  endif
-%}
{% render 'anvil-stylesheet', file: 'anvil-header.css', section: section %}
{%- if s.sticky != 'never' or transparent -%}
  {% style %}
    #shopify-section-{{ section.id }} {
      position: {% if s.sticky != 'never' %}sticky{% else %}relative{% endif %};
      top: 0;
      z-index: 40;
    }
    {%- if s.sticky == 'scroll-up' %}
    #shopify-section-{{ section.id }}:has(.av-header.av-is-hidden):not(:focus-within) {
      transform: translateY(-100%);
    }
    @media (prefers-reduced-motion: no-preference) {
      html:not([data-animations="off"]) #shopify-section-{{ section.id }} {
        transition: transform var(--av-dur) var(--av-ease);
      }
    }
    {%- endif %}
    {%- if transparent %}
    {%- comment -%} --av-header-overlap: the first section adds it to its top padding (heroes) so content clears the header. {%- endcomment %}
    :root {
      --av-header-overlap: {{ overlap_m }}px;
    }
    #shopify-section-{{ section.id }} {
      margin-bottom: -{{ overlap_m }}px;
    }
    @media (min-width: 750px) {
      :root {
        --av-header-overlap: {{ overlap_t }}px;
      }
      #shopify-section-{{ section.id }} {
        margin-bottom: -{{ overlap_t }}px;
      }
    }
    @media (min-width: 990px) {
      :root {
        --av-header-overlap: {{ overlap_d }}px;
      }
      #shopify-section-{{ section.id }} {
        margin-bottom: -{{ overlap_d }}px;
      }
    }
    #shopify-section-{{ section.id }}:has(.av-header.av-is-transparent) > .av-section {
      background: transparent;
    }
    {%- endif %}
  {% endstyle %}
{%- endif -%}
<div {% render 'anvil-section-attrs', section: section, type: 'anvil-header' %}>
  <div class="av-section__inner">
    <anvil-header
      class="av-header av-header--logo-{{ s.logo_position }} av-header--menu-{{ s.menu_position }}{% if transparent %} av-is-transparent{% endif %}"
      data-anvil-sticky="{{ s.sticky }}"
      {%- if transparent %} data-anvil-transparent style="--av-header-over-fg: {{ s.transparent_scheme.settings.text | default: '#ffffff' }};"{% endif %}
    >
      <header class="av-header__bar">
        <anvil-drawer id="anvil-menu-drawer" class="av-header__drawer" side="left" close-at="990">
          <details class="av-header__details">
            <summary class="av-header__icon av-header__burger">
              <span class="av-visually-hidden">{{ menu_label }}</span>
              {% render 'anvil-icon', name: 'menu', size: 24 %}
            </summary>
            <div class="av-header__panel av-header__panel--{{ s.drawer_layout }}" data-anvil-panel aria-label="{{ menu_label }}">
              <div class="av-header__panel-head">
                <span class="av-header__panel-title">{{ menu_label }}</span>
                <button type="button" class="av-header__icon av-js-only" data-anvil-close aria-label="{{ close_label }}">
                  {% render 'anvil-icon', name: 'x', size: 24 %}
                </button>
              </div>
              <nav class="av-header__mobile-nav" aria-label="{{ menu_label }}">
                <ul class="av-header__mobile-list av-list-reset">
                  {%- for link in menu.links -%}
                    <li class="av-header__mobile-item">
                      {%- if s.drawer_layout == 'tiles' -%}
                        <a class="av-header__tile" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
                        {%- if link.links.size > 0 -%}
                          <ul class="av-header__tile-links av-list-reset">
                            {%- for child in link.links -%}
                              <li><a class="av-header__mobile-sublink" href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a></li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      {%- elsif link.links.size > 0 -%}
                        <details class="av-header__mobile-sub"{% if link.child_active %} open{% endif %}>
                          <summary class="av-header__mobile-link">
                            <span>{{ link.title | escape }}</span>
                            {% render 'anvil-icon', name: 'chevron-down', size: 16, class: 'av-header__chevron' %}
                          </summary>
                          <ul class="av-header__mobile-sublist av-list-reset">
                            <li><a class="av-header__mobile-sublink" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ 'anvil.header.view_all' | t: title: link.title }}</a></li>
                            {%- for child in link.links -%}
                              <li>
                                <a class="av-header__mobile-sublink" href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a>
                                {%- if child.links.size > 0 -%}
                                  <ul class="av-header__mobile-sublist av-header__mobile-sublist--deep av-list-reset">
                                    {%- for grandchild in child.links -%}
                                      <li><a class="av-header__mobile-sublink" href="{{ grandchild.url }}"{% if grandchild.current %} aria-current="page"{% endif %}>{{ grandchild.title | escape }}</a></li>
                                    {%- endfor -%}
                                  </ul>
                                {%- endif -%}
                              </li>
                            {%- endfor -%}
                          </ul>
                        </details>
                      {%- else -%}
                        <a class="av-header__mobile-link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </nav>
              <div class="av-header__panel-foot">
                {%- if shop.customer_accounts_enabled -%}
                  <a class="av-header__mobile-link av-header__mobile-link--account" href="{{ account_url }}">
                    {% render 'anvil-icon', name: 'user', size: 20 %}
                    <span>{{ 'anvil.a11y.account' | t }}</span>
                  </a>
                {%- endif -%}
                {%- if s.drawer_socials -%}
                  {% render 'anvil-social-links', class: 'av-header__socials' %}
                {%- endif -%}
                {%- if show_country -%}
                  {%- form 'localization', id: 'anvil-header-country', class: 'av-header__loc av-field' -%}
                    <label class="av-field__label" for="anvil-header-country-select">{{ 'anvil.localization.country' | t }}</label>
                    <div class="av-header__loc-row">
                      <div class="av-field__select av-header__loc-select">
                        <select class="av-field__input" id="anvil-header-country-select" name="country_code">
                          {%- for country in localization.available_countries -%}
                            <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</option>
                          {%- endfor -%}
                        </select>
                      </div>
                      <button type="submit" class="av-btn av-btn--secondary av-btn--md">{{ update_label }}</button>
                    </div>
                  {%- endform -%}
                {%- endif -%}
                {%- if show_language -%}
                  {%- form 'localization', id: 'anvil-header-language', class: 'av-header__loc av-field' -%}
                    <label class="av-field__label" for="anvil-header-language-select">{{ 'anvil.localization.language' | t }}</label>
                    <div class="av-header__loc-row">
                      <div class="av-field__select av-header__loc-select">
                        <select class="av-field__input" id="anvil-header-language-select" name="language_code">
                          {%- for language in localization.available_languages -%}
                            <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name }}</option>
                          {%- endfor -%}
                        </select>
                      </div>
                      <button type="submit" class="av-btn av-btn--secondary av-btn--md">{{ update_label }}</button>
                    </div>
                  {%- endform -%}
                {%- endif -%}
              </div>
            </div>
          </details>
        </anvil-drawer>

        <a class="av-header__logo" href="{{ routes.root_url }}">
          {%- if main_logo != blank -%}
            {%- assign logo_h = logo_w | divided_by: main_logo.aspect_ratio | round -%}
            {{ main_logo | image_url: width: logo_w2 | image_tag: widths: logo_widths, sizes: logo_sizes, width: logo_w, height: logo_h, loading: 'eager', class: 'av-header__logo-img', alt: shop.name }}
            {%- if over_logo != blank -%}
              {%- assign over_h = logo_w | divided_by: over_logo.aspect_ratio | round -%}
              {{ over_logo | image_url: width: logo_w2 | image_tag: widths: logo_widths, sizes: logo_sizes, width: logo_w, height: over_h, loading: 'eager', class: 'av-header__logo-img av-header__logo-img--over', alt: shop.name }}
            {%- endif -%}
          {%- else -%}
            <span class="av-header__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>

        <nav class="av-header__nav" aria-label="{{ menu_label }}">
          <ul class="av-header__list av-list-reset">
            {%- for link in menu.links -%}
              {%- liquid
                assign mega = nil
                assign link_key = link.title | handleize
                for block in section.blocks
                  assign block_key = block.settings.menu_item | handleize
                  if block.type == 'mega' and block_key == link_key and block_key != blank
                    assign mega = block
                    break
                  endif
                endfor
              -%}
              <li class="av-header__item{% if mega %} av-header__item--mega{% endif %}">
                {%- if link.links.size > 0 -%}
                  <details class="av-header__dropdown{% if mega %} av-header__dropdown--mega{% endif %}">
                    <summary class="av-header__link{% if link.child_active %} av-header__link--active{% endif %}">
                      <span>{{ link.title | escape }}</span>
                      {% render 'anvil-icon', name: 'chevron-down', size: 16, class: 'av-header__chevron' %}
                    </summary>
                    {%- if mega -%}
                      <div class="av-header__mega" {{ mega.shopify_attributes }}>
                        <ul class="av-header__mega-cols av-list-reset">
                          {%- for child in link.links -%}
                            <li class="av-header__mega-col">
                              <a class="av-header__mega-heading" href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a>
                              {%- if child.links.size > 0 -%}
                                <ul class="av-header__mega-links av-list-reset">
                                  {%- for grandchild in child.links -%}
                                    <li><a class="av-header__mega-link" href="{{ grandchild.url }}"{% if grandchild.current %} aria-current="page"{% endif %}>{{ grandchild.title | escape }}</a></li>
                                  {%- endfor -%}
                                </ul>
                              {%- endif -%}
                            </li>
                          {%- endfor -%}
                          <li class="av-header__mega-col">
                            <a class="av-header__mega-heading" href="{{ link.url }}">{{ 'anvil.header.view_all' | t: title: link.title }}</a>
                          </li>
                        </ul>
                        {%- liquid
                          assign m = mega.settings
                          assign has_feature = false
                          if m.collection != blank or m.product != blank or m.image != blank
                            assign has_feature = true
                          endif
                        -%}
                        {%- if has_feature -%}
                          <div class="av-header__features">
                            {%- if m.collection != blank -%}
                              <a class="av-header__feature" href="{{ m.collection.url }}">
                                {% render 'anvil-media', image: m.collection.featured_image, ratio: '4:5', widths: '200, 300, 400', sizes: '200px', loading: 'lazy', alt: '', placeholder: 'collection-1' %}
                                <span class="av-header__feature-title">{{ m.collection.title | escape }}</span>
                              </a>
                            {%- endif -%}
                            {%- if m.product != blank -%}
                              <a class="av-header__feature" href="{{ m.product.url }}">
                                {% render 'anvil-media', image: m.product.featured_media.preview_image, ratio: '4:5', widths: '200, 300, 400', sizes: '200px', loading: 'lazy', alt: '', placeholder: 'product-1' %}
                                <span class="av-header__feature-title">{{ m.product.title | escape }}</span>
                                {% render 'anvil-price', product: m.product, show_badge: false, size: 'sm' %}
                              </a>
                            {%- endif -%}
                            {%- if m.image != blank -%}
                              {%- if m.image_link != blank -%}
                                <a class="av-header__feature" href="{{ m.image_link }}">
                                  {% render 'anvil-media', image: m.image, ratio: '4:5', widths: '200, 300, 400', sizes: '200px', loading: 'lazy', alt: m.image.alt %}
                                  {%- if m.image_label != blank -%}<span class="av-header__feature-title">{{ m.image_label | escape }}</span>{%- endif -%}
                                </a>
                              {%- else -%}
                                <figure class="av-header__feature">
                                  {% render 'anvil-media', image: m.image, ratio: '4:5', widths: '200, 300, 400', sizes: '200px', loading: 'lazy', alt: m.image.alt %}
                                  {%- if m.image_label != blank -%}<figcaption class="av-header__feature-title">{{ m.image_label | escape }}</figcaption>{%- endif -%}
                                </figure>
                              {%- endif -%}
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                      </div>
                    {%- else -%}
                      <ul class="av-header__sub av-list-reset">
                        <li><a class="av-header__sublink" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ 'anvil.header.view_all' | t: title: link.title }}</a></li>
                        {%- for child in link.links -%}
                          <li>
                            <a class="av-header__sublink" href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a>
                            {%- if child.links.size > 0 -%}
                              <ul class="av-header__sub-deep av-list-reset">
                                {%- for grandchild in child.links -%}
                                  <li><a class="av-header__sublink" href="{{ grandchild.url }}"{% if grandchild.current %} aria-current="page"{% endif %}>{{ grandchild.title | escape }}</a></li>
                                {%- endfor -%}
                              </ul>
                            {%- endif -%}
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </details>
                {%- else -%}
                  <a class="av-header__link{% if link.active %} av-header__link--active{% endif %}" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>

        <div class="av-header__actions">
          {%- if s.show_search and s.search_mode == 'inline' -%}
            {%- comment -%}
              Inline search: a field in the bar from 990 px with results under it while the shopper types; narrower
              screens keep the search icon, which opens the search page.
            {%- endcomment -%}
            {%- capture inline_form -%}
              <form class="av-header__search-form" action="{{ routes.search_url }}" method="get" role="search">
                <label class="av-visually-hidden" for="anvil-header-search-inline">{{ 'anvil.search.placeholder' | t }}</label>
                <input class="av-field__input" id="anvil-header-search-inline" type="search" name="q" placeholder="{{ 'anvil.search.placeholder' | t }}" autocomplete="off"{% if settings.predictive_search_enabled %} data-anvil-predictive-input aria-controls="anvil-predictive-inline" aria-expanded="false"{% endif %}>
                <input type="hidden" name="options[prefix]" value="last">
                <button type="submit" class="av-header__icon">
                  <span class="av-visually-hidden">{{ 'anvil.search.submit' | t }}</span>
                  {% render 'anvil-icon', name: 'search', size: 24 %}
                </button>
              </form>
            {%- endcapture -%}
            <div class="av-header__search-inline">
              {%- if settings.predictive_search_enabled -%}
                <anvil-predictive-search class="av-predictive av-enhance" section-url="{{ routes.predictive_search_url }}">
                  {{ inline_form }}
                  <div class="av-predictive__results av-header__search-pop" id="anvil-predictive-inline" data-anvil-predictive-results hidden></div>
                  <p class="av-visually-hidden" role="status" aria-live="polite" data-anvil-predictive-live></p>
                </anvil-predictive-search>
                <script type="module" src="{{ 'anvil-predictive-search.js' | asset_url }}"></script>
              {%- else -%}
                {{ inline_form }}
              {%- endif -%}
            </div>
          {%- endif -%}
          {%- if s.show_search -%}
            <a class="av-header__icon{% if s.search_mode == 'inline' %} av-header__search-link{% endif %}" href="{{ routes.search_url }}"{% if s.search_mode == 'modal' %} data-anvil-open="anvil-search-dialog" aria-haspopup="dialog"{% endif %}>
              <span class="av-visually-hidden">{{ 'anvil.a11y.search' | t }}</span>
              {% render 'anvil-icon', name: 'search', size: 24 %}
            </a>
          {%- endif -%}
          {%- if shop.customer_accounts_enabled and s.show_account -%}
            <a class="av-header__icon" href="{{ account_url }}">
              <span class="av-visually-hidden">{{ 'anvil.a11y.account' | t }}</span>
              {% render 'anvil-icon', name: 'user', size: 24 %}
            </a>
          {%- endif -%}
          <a class="av-header__icon av-header__cart" href="{{ routes.cart_url }}" data-anvil-cart-link{% if settings.cart_type == 'drawer' %} data-anvil-open="anvil-cart-drawer" aria-haspopup="dialog"{% endif %}>
            <span class="av-visually-hidden">{{ 'anvil.a11y.cart' | t }}</span>
            {% render 'anvil-icon', name: 'shopping-bag', size: 24 %}
            {% render 'anvil-cart-bubble' %}
          </a>
        </div>
      </header>

      {%- if s.show_search and s.search_mode == 'modal' -%}
        <anvil-dialog id="anvil-search-dialog" class="av-header__search-dialog">
          <dialog class="av-header__search-modal av-scheme av-scheme--{{ s.color_scheme.id }}" aria-label="{{ 'anvil.a11y.search' | t }}">
            {%- capture search_form -%}
              <form class="av-header__search-form" action="{{ routes.search_url }}" method="get" role="search">
                <label class="av-visually-hidden" for="anvil-header-search-q">{{ 'anvil.search.placeholder' | t }}</label>
                <input class="av-field__input" id="anvil-header-search-q" type="search" name="q" placeholder="{{ 'anvil.search.placeholder' | t }}" autocomplete="off"{% if settings.predictive_search_enabled %} data-anvil-predictive-input aria-controls="anvil-predictive-results" aria-expanded="false"{% endif %}>
                <input type="hidden" name="options[prefix]" value="last">
                <button type="submit" class="av-header__icon">
                  <span class="av-visually-hidden">{{ 'anvil.search.submit' | t }}</span>
                  {% render 'anvil-icon', name: 'search', size: 24 %}
                </button>
                <button type="button" class="av-header__icon" data-anvil-close>
                  <span class="av-visually-hidden">{{ close_label }}</span>
                  {% render 'anvil-icon', name: 'x', size: 24 %}
                </button>
              </form>
            {%- endcapture -%}
            {%- if settings.predictive_search_enabled -%}
              <anvil-predictive-search class="av-predictive av-enhance" section-url="{{ routes.predictive_search_url }}">
                {{ search_form }}
                <div class="av-predictive__results" id="anvil-predictive-results" data-anvil-predictive-results hidden></div>
                <p class="av-visually-hidden" role="status" aria-live="polite" data-anvil-predictive-live></p>
              </anvil-predictive-search>
              <script type="module" src="{{ 'anvil-predictive-search.js' | asset_url }}"></script>
            {%- else -%}
              {{ search_form }}
            {%- endif -%}
          </dialog>
        </anvil-dialog>
      {%- endif -%}

      {%- if request.design_mode -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign block_key = block.settings.menu_item | handleize
            assign matched = false
            for link in menu.links
              assign link_key = link.title | handleize
              if link_key == block_key and link.links.size > 0
                assign matched = true
              endif
            endfor
          -%}
          {%- unless matched -%}
            <p class="av-header__editor-note av-example-note" {{ block.shopify_attributes }}>{{ 'anvil.editor.mega_unmatched' | t: item: block.settings.menu_item }}</p>
          {%- endunless -%}
        {%- endfor -%}
      {%- endif -%}
    </anvil-header>
  </div>
</div>
{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "header", "content": "Layout" },
