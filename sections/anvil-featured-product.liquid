        {"type": "range", "id": "ship_cutoff_hour", "label": "Same-day cut-off hour", "min": 0, "max": 23, "step": 1, "default": 0, "info": "Orders at or after this hour (24-hour clock, store time) count from the next day. 0 means no cut-off."},
        {"type": "text", "id": "ship_timezone", "label": "Time zone note", "info": "Optional short label shown with the dates, for example \"ET\". The dates always use your store's time zone."},
        {"type": "select", "id": "ship_date_format", "label": "Date format", "options": [{"value": "short", "label": "Oct 20"}, {"value": "long", "label": "October 20"}, {"value": "weekday", "label": "Mon, Oct 20"}, {"value": "weekday_long", "label": "Monday, October 20"}], "default": "weekday"},
        {"type": "header", "content": "Steps"},
        {"type": "text", "id": "ship_step_1_label", "label": "Step 1 label", "info": "Leave blank for \"Ordered\"."},
        {"type": "select", "id": "ship_step_1_icon", "label": "Step 1 icon", "options": [{"value": "none", "label": "None"}, {"value": "truck", "label": "Truck"}, {"value": "package", "label": "Package"}, {"value": "package-check", "label": "Package checked"}, {"value": "box", "label": "Box"}, {"value": "plane", "label": "Plane"}, {"value": "ship", "label": "Ship"}, {"value": "calendar", "label": "Calendar"}, {"value": "clock", "label": "Clock"}, {"value": "map-pin", "label": "Map pin"}, {"value": "home", "label": "Home"}, {"value": "check-circle", "label": "Check in circle"}, {"value": "shopping-bag", "label": "Shopping bag"}, {"value": "shopping-cart", "label": "Shopping cart"}, {"value": "receipt", "label": "Receipt"}, {"value": "gift", "label": "Gift"}], "default": "shopping-bag"},
        {"type": "text", "id": "ship_step_2_label", "label": "Step 2 label", "info": "Leave blank for \"Shipped\"."},
        {"type": "select", "id": "ship_step_2_icon", "label": "Step 2 icon", "options": [{"value": "none", "label": "None"}, {"value": "truck", "label": "Truck"}, {"value": "package", "label": "Package"}, {"value": "package-check", "label": "Package checked"}, {"value": "box", "label": "Box"}, {"value": "plane", "label": "Plane"}, {"value": "ship", "label": "Ship"}, {"value": "calendar", "label": "Calendar"}, {"value": "clock", "label": "Clock"}, {"value": "map-pin", "label": "Map pin"}, {"value": "home", "label": "Home"}, {"value": "check-circle", "label": "Check in circle"}, {"value": "shopping-bag", "label": "Shopping bag"}, {"value": "shopping-cart", "label": "Shopping cart"}, {"value": "receipt", "label": "Receipt"}, {"value": "gift", "label": "Gift"}], "default": "truck"},
        {"type": "text", "id": "ship_step_3_label", "label": "Step 3 label", "info": "Leave blank for \"Delivered\"."},
        {"type": "select", "id": "ship_step_3_icon", "label": "Step 3 icon", "options": [{"value": "none", "label": "None"}, {"value": "truck", "label": "Truck"}, {"value": "package", "label": "Package"}, {"value": "package-check", "label": "Package checked"}, {"value": "box", "label": "Box"}, {"value": "plane", "label": "Plane"}, {"value": "ship", "label": "Ship"}, {"value": "calendar", "label": "Calendar"}, {"value": "clock", "label": "Clock"}, {"value": "map-pin", "label": "Map pin"}, {"value": "home", "label": "Home"}, {"value": "check-circle", "label": "Check in circle"}, {"value": "shopping-bag", "label": "Shopping bag"}, {"value": "shopping-cart", "label": "Shopping cart"}, {"value": "receipt", "label": "Receipt"}, {"value": "gift", "label": "Gift"}], "default": "package-check"},
        {"type": "paragraph", "content": "Hidden while the selected variant is sold out or does not ship."}
      ]
    },
    {
      "type": "custom_field",
      "name": "Custom product field",
      "settings": [
        {"type": "text", "id": "field_label", "label": "Label", "default": "Engraving text (example, rename me)", "info": "Shown to shoppers and saved on the order as the property name."},
        {"type": "select", "id": "field_type", "label": "Field type", "options": [{"value": "text", "label": "Short text"}, {"value": "textarea", "label": "Long text"}, {"value": "checkbox", "label": "Checkbox"}, {"value": "select", "label": "Drop-down"}, {"value": "date", "label": "Date"}], "default": "text"},
        {"type": "textarea", "id": "field_options", "label": "Drop-down options", "info": "One option per line.", "visible_if": "{{ block.settings.field_type == 'select' }}"},
        {"type": "text", "id": "field_placeholder", "label": "Placeholder", "visible_if": "{{ block.settings.field_type == 'text' or block.settings.field_type == 'textarea' }}"},
        {"type": "text", "id": "field_help", "label": "Help text"},
        {"type": "checkbox", "id": "field_required", "label": "Required", "default": false, "info": "Add to cart waits until the shopper fills it in, with or without JavaScript (the browser's own check)."},
        {"type": "checkbox", "id": "field_hidden", "label": "Hide at checkout", "default": false, "info": "Starts the property name with an underscore, which Shopify hides at checkout. You still see it on the order in your admin."}
      ]
    },
    {
      "type": "size_chart",
      "name": "Size chart",
      "limit": 1,
      "settings": [
        {"type": "select", "id": "chart_source", "label": "Chart source", "options": [{"value": "page", "label": "Page"}, {"value": "image", "label": "Image"}], "default": "page"},
        {"type": "page", "id": "chart_page", "label": "Page", "info": "Used when the source is Page. Tables in the page scroll sideways on phones."},
        {"type": "image_picker", "id": "chart_image", "label": "Image", "visible_if": "{{ block.settings.chart_source == 'image' }}"},
        {"type": "text", "id": "chart_link_text", "label": "Link text", "info": "Leave blank for \"Size chart\"."},
        {"type": "text", "id": "chart_title", "label": "Chart title", "info": "Heading inside the chart window. Leave blank to use the page title or the link text."},
        {"type": "select", "id": "chart_icon", "label": "Icon", "options": [{"value": "ruler", "label": "Ruler"}, {"value": "none", "label": "None"}], "default": "ruler"},
        {"type": "paragraph", "content": "The variant picker can open this chart next to the option named in its size chart setting."}
      ]
    },
    {
      "type": "discount_code",
      "name": "Discount code",
      "limit": 2,
      "settings": [
        {"type": "text", "id": "code", "label": "Code", "info": "Create the code under Discounts first. The block only shows or applies it; Shopify decides whether it is valid. Nothing shows while this is empty."},
        {"type": "text", "id": "code_text", "label": "Text", "default": "Use this code at checkout", "info": "Describe what the code really gives, for example \"10% off your first order\"."},
        {"type": "select", "id": "code_mode", "label": "When tapped", "options": [{"value": "copy", "label": "Copy the code"}, {"value": "apply", "label": "Apply it to the cart"}], "default": "copy", "info": "Apply adds the code to the cart and shows Shopify's answer; an invalid code is reported as not valid."}
      ]
    },
    {
      "type": "bundle_offer",
      "name": "Bundle offer",
      "limit": 1,
      "settings": [
        {"type": "text", "id": "bundle_heading", "label": "Heading", "default": "Pair it with"},
        {"type": "product_list", "id": "bundle_products", "label": "Products", "limit": 3},
        {"type": "checkbox", "id": "bundle_include_current", "label": "Include this product", "default": true},
        {"type": "checkbox", "id": "bundle_preselect_all", "label": "Preselect companion products", "default": true},
        {"type": "checkbox", "id": "bundle_show_images", "label": "Show images", "default": true},
        {"type": "text", "id": "bundle_discount_note", "label": "Discount note", "info": "Only fill this in when an automatic discount for these products exists under Discounts, for example \"10% off the set\". Shoppers see it with \"Discount applied at checkout\". The total always shows the real prices."},
        {"type": "text", "id": "bundle_button_label", "label": "Button label", "info": "Leave blank for \"Add selected to cart\"."},
        {"type": "paragraph", "content": "The total is the sum of the real prices of the ticked items. All items are added in one step."}
      ]
    },
    {
      "type": "upsells",
      "name": "Product upsells",
      "limit": 2,
      "settings": [
        {"type": "text", "id": "upsell_heading", "label": "Heading", "default": "Add to your order"},
        {"type": "select", "id": "upsell_source", "label": "Products", "options": [{"value": "recommendations", "label": "Shopify recommendations"}, {"value": "manual", "label": "Pick products"}], "default": "recommendations"},
        {"type": "product_list", "id": "upsell_products", "label": "Picked products", "limit": 4, "info": "Used when Products is set to Pick products."},
        {"type": "select", "id": "upsell_intent", "label": "Recommendation type", "options": [{"value": "related", "label": "Related"}, {"value": "complementary", "label": "Complementary"}], "default": "related", "info": "Complementary uses the products you pair in the Search & Discovery app; with none set, the block stays hidden.", "visible_if": "{{ block.settings.upsell_source == 'recommendations' }}"},
        {"type": "range", "id": "upsell_limit", "label": "Products shown", "min": 1, "max": 4, "step": 1, "default": 3},
        {"type": "checkbox", "id": "upsell_hide_in_cart", "label": "Hide products already in the cart", "default": true},
        {"type": "checkbox", "id": "upsell_show_price", "label": "Show prices", "default": true}
      ]
    },
    {"type": "@app"}
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "Featured product",
      "blocks": [
        {"type": "title"},
        {"type": "price"},
        {"type": "variant_picker"},
        {"type": "quantity"},
        {"type": "buy_buttons"},
        {"type": "payment_badges"},
        {"type": "description"}
      ]
    }
  ],
  "disabled_on": {"groups": ["*"]}
}
{% endschema %}
