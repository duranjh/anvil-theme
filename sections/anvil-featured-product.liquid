{%- comment -%}
  Featured product: the addable twin of main-product for any page. Same layout, same blocks (minus the sticky bar
  and gifts on quantity) through snippets/anvil-product-block.liquid, same product form contract; that snippet's doc
  header explains how the form keeps block order. Without a chosen product it shows an example layout. The schema
  is generated by scripts/sync-block-schemas.py from docs/product-blocks/; edit the fragments, not the schema.
  The product forms validate natively (no novalidate), as in main-product. ?variant= does not select a variant here
  (Shopify reads it only on product pages), so variant changes are client-side only (assets/anvil-product.js).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign featured = s.product
  assign form_id = 'anvil-pf-' | append: section.id
  assign picker = section.blocks | where: 'type', 'variant_picker' | first

  # Variant state, computed once (WAVE1-CONTRACTS §3), exactly as in main-product: ?variant= wins; then the offer
  # card the variant picker preselects when that variant is available; then the first available variant.
  assign current_variant = featured.selected_variant
  if current_variant == blank and picker.settings.picker_style == 'cards'
    assign preselect = picker.settings.offer_cards_preselect | plus: 0
    if preselect > 0
      assign card_pos = preselect
      assign cards = section.blocks | where: 'type', 'offer_card'
      if cards.size > 0
        assign card_pos = 0
        if preselect <= cards.size
          assign card_index = preselect | minus: 1
          assign card_pos = cards[card_index].settings.card_variant_position | plus: 0
          if card_pos < 1
            assign card_pos = preselect
          endif
        endif
      endif
      if card_pos > 0
        assign drive = featured.options_with_values.first
        assign wanted = picker.settings.offer_cards_option | append: '' | strip | downcase
        for option in featured.options_with_values
          assign option_pos = forloop.index | append: ''
          assign option_name = option.name | strip | downcase
          if wanted == option_pos or wanted == option_name
            assign drive = option
            break
          endif
        endfor
        assign value_index = card_pos | minus: 1
        assign card_variant = drive.values[value_index].variant
        if card_variant.available
          assign current_variant = card_variant
        endif
      endif
    endif
  endif
  if current_variant == blank
    assign current_variant = featured.selected_or_first_available_variant
  endif

  assign gallery_side = s.layout_gallery_position | default: 'left'
  assign gallery_width = s.layout_gallery_width | default: 55
  assign sticky_mode = s.layout_sticky | default: 'info'
  assign block_gap = s.layout_block_gap | default: 16
  assign trust_width = s.layout_trust_width | default: 240
  assign trust_sizes = trust_width | append: 'px'
  assign add_label = 'anvil.product.add_to_cart' | t
  assign form_done = false
-%}
{% render 'anvil-stylesheet', file: 'anvil-product.css', section: section %}
<div {% render 'anvil-section-attrs', section: section, type: 'anvil-featured-product' %}>
  <div class="av-section__inner">
    {% render 'anvil-section-head', section: section %}
    <div
      class="av-product av-product--gallery-{{ gallery_side }} av-product--sticky-{{ sticky_mode }}{% if s.layout_mobile_bleed %} av-product--bleed{% endif %}"
      style="--av-product-gallery-w: {{ gallery_width }}%; --av-pb-gap: {{ block_gap }}px;"
      {% if featured != blank %}data-anvil-product="{{ featured.id }}" data-anvil-form-id="{{ form_id }}"{% endif %}
    >
      {%- if featured == blank -%}
        {%- comment -%} No product chosen yet: an example layout, nothing a shopper could mistake for a real offer. {%- endcomment -%}
        <div class="av-product__gallery">
          {% render 'anvil-media', ratio: '1:1', placeholder: 'product-1' %}
        </div>
        <div class="av-product__info">
          <h2 class="av-product__title">{{ 'anvil.product.example_title' | t }}</h2>
          <p class="av-product__example">{{ 'anvil.editor.example_content' | t }}</p>
          {% render 'anvil-button', label: add_label, style: 'primary', size: 'lg', full: true, disabled: true %}
          {%- if request.design_mode -%}
            <p class="av-device-note">{{ 'anvil.editor.choose_product' | t }}</p>
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="av-product__gallery">
          {% render 'anvil-gallery', product: featured, section: section, current_variant: current_variant %}
        </div>

        <div class="av-product__info">
          {%- if section.blocks.size == 0 -%}
            {%- comment -%} No blocks configured: a plain, working buy box. {%- endcomment -%}
            <h2 class="av-product__title"><a class="av-product__title-link" href="{{ featured.url }}">{{ featured.title | escape }}</a></h2>
            {% render 'anvil-price', variant: current_variant, size: 'lg' %}
            {%- liquid
              assign fallback_off = false
              if current_variant.available == false
                assign add_label = 'anvil.product.sold_out' | t
                assign fallback_off = true
              endif
            -%}
            {%- form 'product', featured, id: form_id, class: 'av-product__form', data-anvil-product-form: '' -%}
              {%- if featured.has_only_default_variant -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}" data-anvil-variant-input>
              {%- else -%}
                <div class="av-field">
                  <label class="av-field__label" for="{{ form_id }}-id">{{ 'anvil.product.choose_variant' | t }}</label>
                  <select class="av-field__input" id="{{ form_id }}-id" name="id" data-anvil-variant-input>
                    {%- for variant in featured.variants -%}
                      <option value="{{ variant.id }}"{% if variant.id == current_variant.id %} selected{% endif %}>
                        {{- variant.title | escape -}}
                        {%- unless variant.available %} ({{ 'anvil.product.sold_out' | t }}){% endunless -%}
                      </option>
                    {%- endfor -%}
                  </select>
                </div>
              {%- endif -%}
              {% render 'anvil-button', label: add_label, style: 'primary', size: 'lg', full: true, type: 'submit', disabled: fallback_off, attrs: 'name="add"' %}
            {%- endform -%}
            {% render 'anvil-editor-empty' %}
          {%- else -%}
            {%- for block in section.blocks -%}
              {%- if block.type == '@app' -%}
                <div class="av-product__app" {{ block.shopify_attributes }}>{% render block %}</div>
              {%- elsif block.type == 'buy_buttons' and form_done == false -%}
                {%- assign form_done = true -%}
                {%- form 'product', featured, id: form_id, class: 'av-product__form', data-anvil-product-form: '' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}" data-anvil-variant-input>
                  {% render 'anvil-product-block', product: featured, block: block, section: section, form_id: form_id, current_variant: current_variant %}
                  {%- if block.settings.show_dynamic_checkout -%}
                    {{ form | payment_button }}
                  {%- endif -%}
                {%- endform -%}
              {%- else -%}
                {% render 'anvil-product-block', product: featured, block: block, section: section, form_id: form_id, current_variant: current_variant %}
              {%- endif -%}
            {%- endfor -%}
            {%- unless form_done -%}
              {%- form 'product', featured, id: form_id, class: 'av-product__form av-product__form--bare', data-anvil-product-form: '' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}" data-anvil-variant-input>
              {%- endform -%}
            {%- endunless -%}
          {%- endif -%}

          {%- if s.layout_trust_image != blank -%}
            <div class="av-product__trust" style="--av-product-trust-w: {{ trust_width }}px;">
              {{ s.layout_trust_image | image_url: width: 960 | image_tag: widths: '240, 480, 720, 960', sizes: trust_sizes, loading: 'lazy', class: 'av-product__trust-img' }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
{%- if featured != blank -%}
  <script type="module" src="{{ 'anvil-product.js' | asset_url }}"></script>
{%- endif -%}

{% schema %}
{
  "name": "Featured product",
  "settings": [
    {"type": "header", "content": "Heading"},
    {"type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Bold a word to colour it with the accent"},
    {"type": "richtext", "id": "subheading", "label": "Subheading"},
    {"type": "text_alignment", "id": "head_align", "label": "Heading alignment", "default": "center"},
    {"type": "select", "id": "head_size", "label": "Heading size", "options": [{"value": "xs", "label": "Extra small"}, {"value": "sm", "label": "Small"}, {"value": "md", "label": "Medium"}, {"value": "lg", "label": "Large"}, {"value": "xl", "label": "Extra large"}], "default": "lg"},
    {"type": "select", "id": "accent_style", "label": "Accent style for bold words", "options": [{"value": "color", "label": "Accent colour"}, {"value": "underline", "label": "Underline"}, {"value": "highlight", "label": "Highlight"}, {"value": "gradient", "label": "Gradient"}], "default": "color"},
    {"type": "header", "content": "Layout"},
    {"type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1"},
    {"type": "select", "id": "width", "label": "Width", "options": [{"value": "page", "label": "Page width"}, {"value": "narrow", "label": "Narrow"}, {"value": "full", "label": "Full width"}], "default": "page"},
    {"type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48},
    {"type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48},
    {"type": "select", "id": "pad_mobile", "label": "Padding on phones", "options": [{"value": "same", "label": "Same as desktop"}, {"value": "compact", "label": "Compact"}, {"value": "none", "label": "None"}], "default": "compact"},
    {"type": "select", "id": "reveal", "label": "Animate on scroll", "options": [{"value": "none", "label": "Off"}, {"value": "fade-up", "label": "Fade up"}, {"value": "fade", "label": "Fade"}, {"value": "zoom", "label": "Zoom"}], "default": "none"},
    {"type": "select", "id": "show_on", "label": "Show on", "options": [{"value": "all", "label": "All devices"}, {"value": "mobile", "label": "Phones only"}, {"value": "desktop", "label": "Desktop only"}], "default": "all"},
    {"type": "text", "id": "anchor", "label": "Anchor id", "info": "Letters, numbers and hyphens. Link to this section with #your-id"},
    {"type": "header", "content": "Featured product"},
    {"type": "product", "id": "product", "label": "Product", "info": "Until you pick one, the section shows an example layout."},
    {"type": "header", "content": "Columns"},
    {"type": "select", "id": "layout_gallery_position", "label": "Gallery side on desktop", "options": [{"value": "left", "label": "Left"}, {"value": "right", "label": "Right"}], "default": "left", "info": "On phones the gallery always comes first, above the buy column."},
    {"type": "range", "id": "layout_gallery_width", "label": "Gallery share of the width", "min": 40, "max": 60, "step": 5, "unit": "%", "default": 55, "info": "Applies from tablet width up; the buy column takes the rest."},
    {"type": "select", "id": "layout_sticky", "label": "Keep in view while scrolling", "options": [{"value": "info", "label": "Buy column"}, {"value": "gallery", "label": "Gallery"}, {"value": "none", "label": "Nothing"}], "default": "info", "info": "Desktop only. The shorter column stays in view while the taller one scrolls. A buy column taller than the screen shows its lower blocks only after the gallery has scrolled by, so pick Gallery when the buy column is long."},
    {"type": "range", "id": "layout_block_gap", "label": "Space between blocks", "min": 0, "max": 40, "step": 4, "unit": "px", "default": 16},
    {"type": "checkbox", "id": "layout_mobile_bleed", "label": "Edge-to-edge gallery on phones", "default": false},
    {"type": "header", "content": "Badge under the buy column"},
    {"type": "image_picker", "id": "layout_trust_image", "label": "Badge image", "info": "Upload only artwork you own or are licensed to use, showing claims that are true for your store. Anvil ships no platform, review-site or payment logos. Describe the badge in the image's alt text."},
    {"type": "range", "id": "layout_trust_width", "label": "Badge width", "min": 80, "max": 480, "step": 8, "unit": "px", "default": 240},
    {"type": "header", "content": "Gallery"},
    {"type": "select", "id": "gallery_thumbs_desktop", "label": "Thumbnails on desktop", "options": [{"value": "left", "label": "Left of the image"}, {"value": "bottom", "label": "Under the image"}, {"value": "hidden", "label": "None, arrows only"}, {"value": "stacked", "label": "None, stack every image"}], "default": "bottom"},
    {"type": "select", "id": "gallery_thumbs_mobile", "label": "Thumbnails on phones", "options": [{"value": "hidden", "label": "None"}, {"value": "bottom", "label": "Under the image"}], "default": "hidden"},
    {"type": "select", "id": "gallery_pager_mobile", "label": "Position marker on phones", "options": [{"value": "dots_under", "label": "Dots under the image"}, {"value": "dots_overlay", "label": "Dots on the image"}, {"value": "numeric", "label": "Counter, like 2 / 5"}, {"value": "hidden", "label": "None"}], "default": "dots_under"},
    {"type": "range", "id": "gallery_mobile_peek", "label": "Peek of the next image on phones", "min": 0, "max": 40, "step": 4, "unit": "px", "default": 0, "info": "Shows a sliver of the next image so shoppers can tell the gallery swipes."},
    {"type": "select", "id": "gallery_ratio", "label": "Media shape", "options": [{"value": "adapt", "label": "Each image's own shape"}, {"value": "1:1", "label": "Square"}, {"value": "4:5", "label": "Portrait 4:5"}, {"value": "3:4", "label": "Portrait 3:4"}], "default": "adapt", "info": "A fixed shape fits the whole image inside the frame, so nothing is cropped."},
    {"type": "select", "id": "gallery_zoom", "label": "Zoom", "options": [{"value": "none", "label": "Off"}, {"value": "hover", "label": "Magnify under the mouse"}, {"value": "lightbox", "label": "Open full screen"}], "default": "lightbox", "info": "The magnifier needs a mouse. On touch screens, and for keyboard users, the image opens full screen instead, where it can be pinched or zoomed."},
    {"type": "checkbox", "id": "gallery_variant_image_first", "label": "Show the selected variant's image first", "default": true},
    {"type": "checkbox", "id": "gallery_hide_other_variant_media", "label": "Hide images of other variants", "default": false, "info": "An image belongs to a variant when it is that variant's image in the product admin. Images that belong to no variant always show."},
    {"type": "header", "content": "Product videos"},
    {"type": "checkbox", "id": "gallery_video_autoplay", "label": "Play videos automatically", "default": false, "info": "Videos play muted while on screen, and only for shoppers whose device does not ask for reduced motion. A pause control always stays available."},
    {"type": "checkbox", "id": "gallery_video_loop", "label": "Loop videos", "default": false},
    {"type": "checkbox", "id": "gallery_video_muted", "label": "Start videos muted", "default": true, "info": "Videos that play automatically are always muted, because browsers block autoplay with sound."},
    {"type": "checkbox", "id": "gallery_video_controls", "label": "Show video controls", "default": true, "info": "When off, one play and pause button replaces the player controls. YouTube and Vimeo videos keep their own player."}
  ],
  "blocks": [
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        {"type": "select", "id": "picker_style", "label": "Style", "options": [{"value": "dropdown", "label": "Dropdowns"}, {"value": "pills", "label": "Pills and swatches"}, {"value": "cards", "label": "Offer cards"}], "default": "pills"},
        {"type": "checkbox", "id": "picker_hide_sold_out", "label": "Hide sold-out values", "default": false, "info": "A value stays visible while it is selected, so a shopper arriving on a sold-out variant still sees what they picked."},
        {"type": "checkbox", "id": "pills_use_swatches", "label": "Show colour swatches", "default": true, "info": "Uses the swatches set on your product options in Shopify, then the fallback list in Theme settings > Colour swatches. Values without either stay text pills."},
        {"type": "text", "id": "size_chart_option_name", "label": "Size chart option", "info": "Option name, for example Size. A size chart link appears next to it when this section also has a Size chart block with a page or image."},
        {"type": "header", "content": "Offer cards"},
        {"type": "paragraph", "content": "Add Offer card blocks to write each card's label, caption, badge and benefit line. Without them, one card per option value is generated."},
        {"type": "select", "id": "offer_cards_option", "label": "Option shown as cards", "options": [{"value": "1", "label": "First option"}, {"value": "2", "label": "Second option"}, {"value": "3", "label": "Third option"}], "default": "1", "info": "The product's other options appear as pills under the cards. Falls back to the first option when a product has fewer options."},
        {"type": "range", "id": "offer_cards_preselect", "label": "Card selected on load", "min": 0, "max": 6, "step": 1, "default": 0, "info": "0 opens on the first available variant. A sold-out card is never preselected, and a link that names a variant (?variant=) always wins."},
        {"type": "select", "id": "offer_cards_savings", "label": "Savings on cards", "options": [{"value": "amount", "label": "Amount"}, {"value": "percent", "label": "Percentage"}, {"value": "both", "label": "Amount and percentage"}, {"value": "none", "label": "None"}], "default": "amount", "info": "Computed from each variant's compare-at price, and shown only when it is higher than the price. Enter a compare-at price only if the item really sold at it; there is no manual savings field."},
        {"type": "select", "id": "offer_cards_image_source", "label": "Card image", "options": [{"value": "variant", "label": "Variant image"}, {"value": "none", "label": "None"}], "default": "variant"},
        {"type": "select", "id": "offer_cards_layout", "label": "Card layout", "options": [{"value": "stack", "label": "One per row"}, {"value": "grid", "label": "Side by side"}], "default": "stack"}
      ]
    },
    {
      "type": "offer_card",
      "name": "Offer card",
      "limit": 6,
      "settings": [
        {"type": "paragraph", "content": "Shows inside the Variant picker when its style is Offer cards. Price, strike-through and savings come from the variant this card selects."},
        {"type": "range", "id": "card_variant_position", "label": "Option value position", "min": 0, "max": 20, "step": 1, "default": 0, "info": "Which value of the card option this card sells: 1 is the first value. On a product with one option this is the variant's position. 0 follows the order of these blocks."},
        {"type": "text", "id": "card_label", "label": "Label", "info": "Leave blank to show the option value, for example 2 Pack. Do not type prices or savings here; the card computes them."},
        {"type": "text", "id": "card_caption", "label": "Caption", "info": "Describe what this option includes. Do not type prices, savings or 'was' amounts here; the card computes them from the variant's price and compare-at price."},
        {"type": "text", "id": "card_badge", "label": "Badge", "info": "For example Most popular. It shows only when the box below is ticked."},
        {"type": "checkbox", "id": "card_badge_backed_by_sales", "label": "Badge is backed by sales data", "default": false, "info": "Only tick if sales data supports this badge. Shoppers never see it otherwise."},
        {"type": "text", "id": "card_benefit", "label": "Benefit line", "info": "Only promise what this option really includes, for example a shipping rate or a discount you have set up in Shopify."},
        {"type": "checkbox", "id": "card_show_image", "label": "Show image", "default": true, "info": "Uses the image assigned to the card's variant, when the picker's card image is set to Variant image."}
      ]
    },
    {
      "type": "quantity",
      "name": "Quantity selector",
      "limit": 1,
      "settings": [
        {"type": "select", "id": "quantity_style", "label": "Style", "options": [{"value": "stepper", "label": "Stepper"}, {"value": "tiers", "label": "Tier cards"}], "default": "stepper", "info": "Tier cards come from Quantity tier blocks; without any, the stepper shows. Both follow each variant's minimum, maximum and increment from Shopify."},
        {"type": "checkbox", "id": "quantity_show_label", "label": "Show label", "default": true},
        {"type": "range", "id": "quantity_max", "label": "Highest quantity", "min": 0, "max": 50, "step": 1, "default": 0, "info": "0 means no limit beyond the variant's own quantity rule. This only limits the selector; Shopify still enforces stock at checkout."},
        {"type": "range", "id": "quantity_tier_default", "label": "Tier selected on load", "min": 1, "max": 5, "step": 1, "default": 1}
      ]
    },
    {
      "type": "quantity_tier",
      "name": "Quantity tier",
      "limit": 5,
      "settings": [
        {"type": "paragraph", "content": "Shows as a card when the Quantity selector style is Tier cards. Choosing the card sets the quantity. The theme only displays a discount; Shopify grants it."},
        {"type": "range", "id": "tier_qty", "label": "Quantity", "min": 1, "max": 20, "step": 1, "default": 1},
        {"type": "text", "id": "tier_label", "label": "Label", "info": "Leave blank to show Buy 2, Buy 3 and so on. Do not type a saving or a price here; a discount shows only from the two fields below."},
        {"type": "text", "id": "tier_badge", "label": "Badge", "info": "For example Most popular. It shows only when the box below is ticked."},
        {"type": "checkbox", "id": "tier_badge_backed_by_sales", "label": "Badge is backed by sales data", "default": false, "info": "Only tick if sales data supports this badge. Shoppers never see it otherwise."},
        {"type": "range", "id": "tier_discount_percent", "label": "Discount to show", "min": 0, "max": 80, "step": 1, "unit": "%", "default": 0, "info": "First create an automatic Amount off products discount in Shopify with this minimum quantity (up to 25 automatic discounts can be active), then copy its percentage here. The card shows the price with that discount; Shopify applies it at checkout."},
        {"type": "text", "id": "tier_discount_title", "label": "Discount name", "info": "The automatic discount's title, as shoppers see it at checkout. No discounted price is shown until it is filled in. In the theme editor a red note appears after adding to cart if the cart line's discount differs from this promise."}
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {"type": "text", "id": "atc_label", "label": "Button label", "info": "Leave blank for Add to cart."},
        {"type": "text", "id": "atc_sold_out_label", "label": "Sold-out label", "info": "Leave blank for Sold out."},
        {"type": "select", "id": "atc_style", "label": "Button style", "options": [{"value": "primary", "label": "Solid button"}, {"value": "accent", "label": "Accent button"}, {"value": "secondary", "label": "Outline button"}], "default": "primary"},
        {"type": "checkbox", "id": "show_dynamic_checkout", "label": "Show express checkout buttons", "default": false, "info": "Express buttons send shoppers straight to checkout, so they skip the cart drawer and never see upsells, gifts or the free-shipping bar."},
        {"type": "checkbox", "id": "show_secure_line", "label": "Show secure checkout line", "default": false},
        {"type": "text", "id": "atc_secure_text", "label": "Secure line text", "info": "Leave blank for Secure checkout. Keep it to facts about your checkout."}
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        {"type": "text", "id": "headline", "label": "Custom headline", "info": "Shown as the page heading instead of the product name. Connect a product metafield to give each product its own headline. Only state what is true for the product."},
        {"type": "checkbox", "id": "show_name", "label": "Show the product name under a custom headline", "default": true},
        {"type": "select", "id": "size", "label": "Size", "options": [{"value": "sm", "label": "Small"}, {"value": "md", "label": "Medium"}, {"value": "lg", "label": "Large"}, {"value": "xl", "label": "Extra large"}], "default": "md"},
        {"type": "text_alignment", "id": "align", "label": "Alignment", "default": "left"},
        {"type": "checkbox", "id": "uppercase", "label": "Uppercase", "default": false},
        {"type": "range", "id": "space_top", "label": "Extra space above", "min": 0, "max": 64, "step": 4, "unit": "px", "default": 0},
        {"type": "range", "id": "space_bottom", "label": "Extra space below", "min": 0, "max": 64, "step": 4, "unit": "px", "default": 0}
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": [
