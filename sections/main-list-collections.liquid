{% render 'anvil-stylesheet', file: 'anvil-sec-main-list-collections.css', section: section %}
{%- liquid
  assign s = section.settings
  assign card_ratio = settings.collection_card_image_ratio | default: '1:1'
  assign card_style = settings.collection_card_style | default: 'flat'
-%}
<div {% render 'anvil-section-attrs', section: section, type: 'main-list-collections' %}>
  <div class="av-section__inner">
    {% render 'anvil-section-head', section: section %}
    {%- paginate collections by s.per_page -%}
      <div class="av-list-collections">
        <h1 class="av-list-collections__title">{{ s.title | escape }}</h1>
        {%- if collections.size > 0 -%}
          <ul class="av-list-collections__grid av-list-collections__grid--{{ s.cols_desktop }} av-list-reset">
            {%- for collection in collections -%}
              {%- assign ph_index = forloop.index0 | modulo: 6 | plus: 1 -%}
              {%- assign ph_name = 'collection-' | append: ph_index -%}
              <li class="av-list-collections__cell">
                {%- liquid
                  assign img_loading = 'lazy'
                  if forloop.index <= 4
                    if section.index == nil or section.index <= 2
                      assign img_loading = 'eager'
                    endif
                  endif
                -%}
                <a class="av-list-collections__card av-list-collections__card--{{ card_style }}" href="{{ collection.url }}">
                  <div class="av-list-collections__media">
                    {%- comment -%} The heading inside the link names it, so the image is decorative here. {%- endcomment -%}
                    {% render 'anvil-media', image: collection.featured_image, ratio: card_ratio, widths: '300, 450, 600', sizes: '(min-width: 990px) 33vw, 50vw', loading: img_loading, placeholder: ph_name, alt: '', class: 'av-list-collections__img' %}
                  </div>
                  <h2 class="av-list-collections__name">{{ collection.title | escape }}</h2>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <p class="av-list-collections__empty">{{ 'anvil.list_collections.empty' | t }}</p>
        {%- endif -%}
        {% render 'anvil-pagination', paginate: paginate %}
      </div>
    {%- endpaginate -%}
  </div>
</div>
{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "select", "id": "width", "label": "Width", "options": [ {"value":"page","label":"Page width"}, {"value":"narrow","label":"Narrow"}, {"value":"full","label":"Full width"} ], "default": "page" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "select", "id": "pad_mobile", "label": "Padding on phones", "options": [ {"value":"same","label":"Same as desktop"}, {"value":"compact","label":"Compact"}, {"value":"none","label":"None"} ], "default": "compact" },
    { "type": "header", "content": "Collections list" },
    {
      "type": "text",
      "id": "title",
      "label": "Page title",
      "default": "Collections"
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Collections per page",
      "min": 6,
      "max": 48,
      "step": 6,
      "default": 24
    },
    {
      "type": "select",
      "id": "cols_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "paragraph",
      "content": "Card style and image ratio are set under Theme settings > Cards > Collection cards."
    }
  ]
}
{% endschema %}
