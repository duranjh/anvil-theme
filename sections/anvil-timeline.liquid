{%- liquid
  assign s = section.settings

  assign orientation = s.orientation | default: 'horizontal'
  assign marker = s.marker | default: 'number'
  assign marker_px = s.marker_size | default: 48
  assign marker_style = s.marker_style | default: 'filled'
  assign marker_shape = s.marker_shape | default: 'circle'
  assign connector = s.connector | default: 'solid'
  assign connector_color = s.connector_color | default: 'border'
  assign step_align = s.text_align | default: 'center'

  comment
    Count the steps that will render: the storefront skips empty steps (no title, label, text or
    image), so columns, classes, sizes and the list guard follow the shown steps, not the blocks.
  endcomment
  assign step_count = 0
  for block in section.blocks
    assign b = block.settings
    if request.design_mode or b.heading != blank or b.text != blank or b.label != blank or b.image != blank
      assign step_count = step_count | plus: 1
    endif
  endfor

  comment
    Steps per row for the horizontal layout. Auto keeps up to six steps on one row and splits
    seven to ten steps into two balanced rows; a fixed number never exceeds the step count.
    Tablets follow the shared grid rule (.av-grid: up to 3; 4 becomes 2 + 2, 5 and 6 rows of 3), here with the
    timeline's own column classes because each row's last step draws no connector.
  endcomment
  if s.cols_desktop == blank or s.cols_desktop == 'auto'
    if step_count > 6
      assign cols_desktop = step_count | plus: 1 | divided_by: 2
    else
      assign cols_desktop = step_count
    endif
  else
    assign cols_desktop = s.cols_desktop | plus: 0 | at_most: step_count
  endif
  assign cols_desktop = cols_desktop | at_least: 1 | at_most: 6
  assign tablet_rows = cols_desktop | plus: 2 | divided_by: 3
  assign cols_tablet = cols_desktop | plus: tablet_rows | minus: 1 | divided_by: tablet_rows

  assign tl_class = 'av-timeline av-timeline--' | append: orientation
  assign tl_class = tl_class | append: ' av-timeline--mk-' | append: marker
  assign tl_class = tl_class | append: ' av-timeline--' | append: marker_style
  assign tl_class = tl_class | append: ' av-timeline--shape-' | append: marker_shape
  assign tl_class = tl_class | append: ' av-timeline--line-' | append: connector
  assign tl_class = tl_class | append: ' av-timeline--lc-' | append: connector_color
  if orientation == 'horizontal'
    assign tl_class = tl_class | append: ' av-timeline--al-' | append: step_align
    assign tl_class = tl_class | append: ' av-timeline--t' | append: cols_tablet
    assign tl_class = tl_class | append: ' av-timeline--d' | append: cols_desktop
  endif
  if s.image_position == 'top'
    assign tl_class = tl_class | append: ' av-timeline--img-top'
  endif

  comment
    Step images are capped at 36rem (576px) by the stylesheet; sizes follows the layout.
    Phones: page minus the gutters, the marker column and its gap.
    Phones always stack the steps, so only step 1 sits in the first visible row and loads eagerly;
    on wider screens the other first-row images are inside the browser's lazy-load distance anyway.
  endcomment
  assign img_widths = '300, 450, 600, 900, 1100'
  case orientation
    when 'horizontal'
      assign img_sizes = '(min-width: 990px) min(calc(100vw / ' | append: cols_desktop | append: '), 576px), (min-width: 750px) min(calc(100vw / ' | append: cols_tablet | append: '), 576px), calc(100vw - 96px)'
    when 'alternate'
      assign img_sizes = '(min-width: 990px) min(45vw, 576px), (min-width: 750px) 576px, calc(100vw - 96px)'
    else
      assign img_sizes = '(min-width: 750px) 576px, calc(100vw - 96px)'
  endcase
  capture fold
    render 'anvil-above-fold', section: section
  endcapture
  assign near_top = true
  if fold contains 'lazy'
    assign near_top = false
  endif

  assign icon_px = marker_px | divided_by: 2
  assign icon_img_px = icon_px | times: 2
  assign icon_img_widths = icon_px | append: ', ' | append: icon_img_px
  assign icon_img_sizes = icon_px | append: 'px'

  assign step_n = 0
-%}
{%- if step_count > 0 or request.design_mode -%}
<div {% render 'anvil-section-attrs', section: section, type: 'anvil-timeline' %}>
  <div class="av-section__inner">
    {%- if step_count > 0 -%}
      {%- assign fallback = 'anvil.timeline.heading' | t -%}
      {% render 'anvil-section-head', section: section, fallback: fallback %}
      <ol class="{{ tl_class }}" role="list" style="--av-timeline-marker-size: {{ marker_px }}px;">
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings

            # An empty step would leave a bare marker in the list, so the storefront skips it;
            # the editor keeps it, unnumbered and with a note, so the merchant can still select it.
            # Numbers count shown steps only, so they match between the editor and the storefront.
            assign has_content = false
            if b.heading != blank or b.text != blank or b.label != blank or b.image != blank
              assign has_content = true
            endif
            unless has_content or request.design_mode
              continue
            endunless

            assign step_number = ''
            if has_content
              assign step_n = step_n | plus: 1
              assign step_number = step_n | append: ''
              if s.number_style == 'padded' and step_n < 10
                assign step_number = '0' | append: step_n
              endif
            endif

            assign img_loading = 'lazy'
            if near_top and step_n == 1
              assign img_loading = 'eager'
            endif
          -%}
          <li class="av-timeline__step" {{ block.shopify_attributes }}>
            <span class="av-timeline__marker" aria-hidden="true">
              {%- case marker -%}
                {%- when 'icon' -%}
                  {%- if b.icon_image != blank -%}
                    {{ b.icon_image | image_url: width: icon_img_px | image_tag: widths: icon_img_widths, sizes: icon_img_sizes, loading: 'lazy', alt: '' }}
                  {%- elsif b.icon != blank and b.icon != 'none' -%}
                    {%- render 'anvil-icon', name: b.icon, size: icon_px -%}
                  {%- else -%}
                    {{ step_number }}
                  {%- endif -%}
                {%- when 'number' -%}
                  {{ step_number }}
              {%- endcase -%}
            </span>
            <div class="av-timeline__body">
              {%- if b.heading != blank -%}
                <h3 class="av-timeline__title">{{ b.heading | escape }}</h3>
              {%- endif -%}
              {%- if b.label != blank -%}
                <p class="av-timeline__label">{{ b.label | escape }}</p>
              {%- endif -%}
              {%- if b.text != blank -%}
                <div class="av-timeline__text av-rte">{{ b.text }}</div>
              {%- endif -%}
              {%- if b.image != blank -%}
                {%- render 'anvil-media', image: b.image, ratio: s.image_ratio, widths: img_widths, sizes: img_sizes, loading: img_loading, class: 'av-timeline__media' -%}
              {%- endif -%}
              {%- unless has_content -%}
                <p class="av-timeline__step-empty av-example-note">{{ 'anvil.editor.block_empty' | t }}</p>
              {%- endunless -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    {%- else -%}
      {% render 'anvil-section-head', section: section %}
      {% render 'anvil-editor-empty' %}
    {%- endif -%}
  </div>
</div>
{%- endif -%}
{% stylesheet %}
.av-timeline{--av-timeline-m:var(--av-timeline-marker-size,48px);--av-timeline-mt:0px;--av-timeline-lw:2px;--av-timeline-sp:var(--av-space-2);--av-timeline-gap:var(--av-grid-gap);--av-timeline-lc:var(--av-border);--av-timeline-ls:solid;display:grid;grid-template-columns:minmax(0,1fr);margin:0}
.av-timeline--line-dashed{--av-timeline-ls:dashed}
.av-timeline--line-dotted{--av-timeline-ls:dotted;--av-timeline-lw:3px}
.av-timeline--lc-accent{--av-timeline-lc:var(--av-accent)}
.av-timeline--lc-text{--av-timeline-lc:rgb(var(--av-fg-rgb) / 0.6)}
.av-timeline--mk-dot{--av-timeline-m:16px;--av-timeline-mt:6px}
.av-timeline__step{position:relative;display:grid;grid-template-columns:var(--av-timeline-m) minmax(0,1fr);column-gap:var(--av-space-4);align-items:start;align-content:start;margin:0;padding-bottom:var(--av-space-6)}
.av-timeline__step:last-child{padding-bottom:0}
.av-timeline__step::before{content:"";position:absolute;top:calc(var(--av-timeline-mt) + var(--av-timeline-m) + var(--av-timeline-sp));bottom:var(--av-timeline-sp);inset-inline-start:calc(var(--av-timeline-m) / 2 - var(--av-timeline-lw) / 2);border-inline-start:var(--av-timeline-lw) var(--av-timeline-ls) var(--av-timeline-lc)}
.av-timeline__step:last-child::before,.av-timeline--line-none .av-timeline__step::before{display:none}
.av-timeline__marker{box-sizing:border-box;display:inline-flex;align-items:center;justify-content:center;width:var(--av-timeline-m);height:var(--av-timeline-m);margin-top:var(--av-timeline-mt);border:2px solid transparent;border-radius:50%;background:var(--av-accent);color:var(--av-on-accent);font-family:var(--av-font-heading);font-size:calc(var(--av-timeline-m) * 0.4);font-weight:var(--av-heading-weight);line-height:1;font-variant-numeric:tabular-nums}
.av-timeline--shape-rounded .av-timeline__marker{border-radius:var(--av-radius-badge)}
.av-timeline--shape-square .av-timeline__marker{border-radius:0}
.av-timeline--outline .av-timeline__marker{background:transparent;border-color:var(--av-accent);color:var(--av-accent)}
.av-timeline--soft .av-timeline__marker{background:rgb(var(--av-accent-rgb) / 0.12);color:var(--av-accent)}
.av-timeline__marker svg,.av-timeline__marker img{display:block;width:50%;height:50%;object-fit:contain}
.av-timeline__body{display:flex;flex-direction:column;align-items:flex-start;justify-self:stretch;gap:var(--av-space-2);min-width:0;padding-top:max(0px,calc(var(--av-timeline-mt) + (var(--av-timeline-m) - 1.75rem) / 2))}
.av-timeline--mk-dot .av-timeline__body{padding-top:0}
.av-timeline__title{margin:0;font-size:var(--av-text-lg);line-height:1.3;overflow-wrap:anywhere}
.av-timeline__label{order:-1;margin:0;font-size:var(--av-text-xs);font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:var(--av-fg-muted)}
.av-timeline__text{color:var(--av-fg-muted)}
.av-timeline__media{order:1;max-width:36rem;margin-top:var(--av-space-2)}
.av-timeline--img-top .av-timeline__media{order:-2;margin:0 0 var(--av-space-2)}
@media (min-width: 750px){
.av-timeline--horizontal{grid-template-columns:repeat(var(--av-timeline-cols,1),minmax(0,1fr));gap:var(--av-space-7) var(--av-timeline-gap)}
.av-timeline--t1{--av-timeline-cols:1}
.av-timeline--t2{--av-timeline-cols:2}
.av-timeline--t3{--av-timeline-cols:3}
.av-timeline--horizontal .av-timeline__step{grid-template-columns:minmax(0,1fr);row-gap:var(--av-space-4);padding-bottom:0}
.av-timeline--horizontal .av-timeline__step::before{top:calc(var(--av-timeline-mt) + var(--av-timeline-m) / 2 - var(--av-timeline-lw) / 2);bottom:auto;inset-inline-start:calc(var(--av-timeline-m) + var(--av-timeline-sp));width:calc(100% + var(--av-timeline-gap) - var(--av-timeline-m) - 2 * var(--av-timeline-sp));border-inline-start:0;border-top:var(--av-timeline-lw) var(--av-timeline-ls) var(--av-timeline-lc)}
.av-timeline--horizontal .av-timeline__body{padding-top:0}
.av-timeline--al-center .av-timeline__step{justify-items:center;text-align:center}
.av-timeline--al-center .av-timeline__body{align-items:center}
.av-timeline--al-center .av-timeline__step::before{inset-inline-start:calc(50% + var(--av-timeline-m) / 2 + var(--av-timeline-sp))}
}
/* Each step draws the line to the next one; the last step of every row draws none. */
@media (min-width: 750px) and (max-width: 989.98px){
.av-timeline--t1 .av-timeline__step::before,.av-timeline--t2 .av-timeline__step:nth-child(2n)::before,.av-timeline--t3 .av-timeline__step:nth-child(3n)::before{display:none}
}
@media (min-width: 990px){
.av-timeline--d1{--av-timeline-cols:1}
.av-timeline--d2{--av-timeline-cols:2}
.av-timeline--d3{--av-timeline-cols:3}
.av-timeline--d4{--av-timeline-cols:4}
.av-timeline--d5{--av-timeline-cols:5}
.av-timeline--d6{--av-timeline-cols:6}
.av-timeline--d1 .av-timeline__step::before,.av-timeline--d2 .av-timeline__step:nth-child(2n)::before,.av-timeline--d3 .av-timeline__step:nth-child(3n)::before,.av-timeline--d4 .av-timeline__step:nth-child(4n)::before,.av-timeline--d5 .av-timeline__step:nth-child(5n)::before,.av-timeline--d6 .av-timeline__step:nth-child(6n)::before{display:none}
.av-timeline--alternate .av-timeline__step{grid-template-columns:minmax(0,1fr) var(--av-timeline-m) minmax(0,1fr);column-gap:var(--av-space-6)}
.av-timeline--alternate .av-timeline__marker{grid-column:2;grid-row:1}
.av-timeline--alternate .av-timeline__body{grid-column:3;grid-row:1}
.av-timeline--alternate .av-timeline__step:nth-child(even) .av-timeline__body{grid-column:1;align-items:flex-end;text-align:end}
.av-timeline--alternate .av-timeline__step::before{inset-inline-start:calc(50% - var(--av-timeline-lw) / 2)}
}
{% endstylesheet %}
{% schema %}
{
  "name": "Timeline",
  "max_blocks": 10,
  "disabled_on": { "groups": ["header", "custom.overlay"] },
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Bold a word to colour it with the accent" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "text_alignment", "id": "head_align", "label": "Heading alignment", "default": "center" },
    { "type": "select", "id": "head_size", "label": "Heading size", "options": [ {"value":"xs","label":"Extra small"}, {"value":"sm","label":"Small"}, {"value":"md","label":"Medium"}, {"value":"lg","label":"Large"}, {"value":"xl","label":"Extra large"} ], "default": "lg" },
    { "type": "select", "id": "accent_style", "label": "Accent style for bold words", "options": [ {"value":"color","label":"Accent colour"}, {"value":"underline","label":"Underline"}, {"value":"highlight","label":"Highlight"}, {"value":"gradient","label":"Gradient"} ], "default": "color" },
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "select", "id": "width", "label": "Width", "options": [ {"value":"page","label":"Page width"}, {"value":"narrow","label":"Narrow"}, {"value":"full","label":"Full width"} ], "default": "page" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "select", "id": "pad_mobile", "label": "Padding on phones", "options": [ {"value":"same","label":"Same as desktop"}, {"value":"compact","label":"Compact"}, {"value":"none","label":"None"} ], "default": "compact" },
    { "type": "select", "id": "reveal", "label": "Animate on scroll", "options": [ {"value":"none","label":"Off"}, {"value":"fade-up","label":"Fade up"}, {"value":"fade","label":"Fade"}, {"value":"zoom","label":"Zoom"} ], "default": "none" },
    { "type": "select", "id": "show_on", "label": "Show on", "options": [ {"value":"all","label":"All devices"}, {"value":"mobile","label":"Phones only"}, {"value":"desktop","label":"Desktop only"} ], "default": "all" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "info": "Letters, numbers and hyphens. Link to this section with #your-id" },
    { "type": "header", "content": "Timeline" },
    {
      "type": "select",
      "id": "orientation",
      "label": "Layout on desktop",
      "options": [
        { "value": "horizontal", "label": "Horizontal steps" },
        { "value": "vertical", "label": "Vertical list" },
        { "value": "alternate", "label": "Vertical, alternating sides" }
      ],
      "default": "horizontal",
      "info": "Phones always show a vertical list. Horizontal steps start at tablet width, alternating sides at desktop width."
    },
    {
      "type": "select",
      "id": "cols_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "auto", "label": "Match item count" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ],
      "default": "auto",
      "info": "Horizontal layout only. Match item count puts up to 6 steps in one row and splits more into two rows. Tablets show up to 3; 4 columns become 2."
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Step alignment",
      "options": [
        { "value": "center", "label": "Centre" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center",
      "info": "Horizontal layout only."
    },
    {
      "type": "select",
      "id": "connector",
      "label": "Connector",
      "options": [
        { "value": "solid", "label": "Solid line" },
        { "value": "dashed", "label": "Dashed line" },
        { "value": "dotted", "label": "Dotted line" },
        { "value": "none", "label": "None" }
      ],
      "default": "solid"
    },
    {
      "type": "select",
      "id": "connector_color",
      "label": "Connector colour",
      "options": [
        { "value": "border", "label": "Border" },
        { "value": "accent", "label": "Accent" },
        { "value": "text", "label": "Text colour" }
      ],
      "default": "border"
    },
    {
      "type": "select",
      "id": "marker",
      "label": "Markers",
      "options": [
        { "value": "number", "label": "Numbers" },
        { "value": "icon", "label": "Icons" },
        { "value": "dot", "label": "Dots" }
      ],
      "default": "number",
      "info": "With icons, a step without an icon shows its number."
    },
    {
      "type": "select",
      "id": "marker_style",
      "label": "Marker style",
      "options": [
        { "value": "filled", "label": "Filled" },
        { "value": "outline", "label": "Outline" },
        { "value": "soft", "label": "Tinted" }
      ],
      "default": "filled"
    },
    {
      "type": "select",
      "id": "marker_shape",
      "label": "Marker shape",
      "options": [
        { "value": "circle", "label": "Circle" },
        { "value": "rounded", "label": "Rounded square" },
        { "value": "square", "label": "Square" }
      ],
      "default": "circle",
      "info": "Rounded square follows the badge corner radius in theme settings."
    },
    {
      "type": "range",
      "id": "marker_size",
      "label": "Marker size",
      "min": 32,
      "max": 72,
      "step": 4,
      "unit": "px",
      "default": 48,
      "info": "Dots keep a fixed small size."
    },
    {
      "type": "select",
      "id": "number_style",
      "label": "Numbers",
      "options": [
        { "value": "plain", "label": "1, 2, 3" },
        { "value": "padded", "label": "01, 02, 03" }
      ],
      "default": "plain"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "adapt", "label": "Original" },
        { "value": "1:1", "label": "Square (1:1)" },
        { "value": "4:5", "label": "Portrait (4:5)" },
        { "value": "3:4", "label": "Portrait (3:4)" },
        { "value": "16:9", "label": "Landscape (16:9)" }
      ],
      "default": "16:9"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "bottom", "label": "Below the text" },
        { "value": "top", "label": "Above the text" }
      ],
      "default": "bottom"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 10,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "check", "label": "Check" },
            { "value": "check-circle", "label": "Check in circle" },
            { "value": "badge-check", "label": "Badge check" },
            { "value": "shopping-bag", "label": "Shopping bag" },
            { "value": "shopping-cart", "label": "Shopping cart" },
            { "value": "credit-card", "label": "Credit card" },
            { "value": "receipt", "label": "Receipt" },
            { "value": "package", "label": "Package" },
            { "value": "package-check", "label": "Package checked" },
            { "value": "box", "label": "Box" },
            { "value": "boxes", "label": "Boxes" },
            { "value": "truck", "label": "Truck" },
            { "value": "plane", "label": "Plane" },
            { "value": "ship", "label": "Ship" },
            { "value": "map-pin", "label": "Map pin" },
            { "value": "home", "label": "Home" },
            { "value": "store", "label": "Store" },
            { "value": "building", "label": "Building" },
            { "value": "mail", "label": "Mail" },
            { "value": "phone", "label": "Phone" },
            { "value": "message-circle", "label": "Chat bubble" },
            { "value": "clock", "label": "Clock" },
            { "value": "calendar", "label": "Calendar" },
            { "value": "hourglass", "label": "Hourglass" },
            { "value": "timer", "label": "Timer" },
            { "value": "gift", "label": "Gift" },
            { "value": "heart", "label": "Heart" },
            { "value": "hand-heart", "label": "Hand with heart" },
            { "value": "star", "label": "Star" },
            { "value": "sparkles", "label": "Sparkles" },
            { "value": "zap", "label": "Lightning" },
            { "value": "lightbulb", "label": "Light bulb" },
            { "value": "rocket", "label": "Rocket" },
            { "value": "flag", "label": "Flag" },
            { "value": "target", "label": "Target" },
            { "value": "trophy", "label": "Trophy" },
            { "value": "award", "label": "Award" },
            { "value": "medal", "label": "Medal" },
            { "value": "users", "label": "People" },
            { "value": "user", "label": "Person" },
            { "value": "user-check", "label": "Person checked" },
            { "value": "thumbs-up", "label": "Thumbs up" },
