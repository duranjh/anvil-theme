{% render 'anvil-stylesheet', file: 'anvil-sec-main-customers-register.css', section: section %}
{%- liquid
  assign s = section.settings
  assign submit_label = 'anvil.customer.register.submit' | t
-%}
<div {% render 'anvil-section-attrs', section: section, type: 'main-customers-register' %}>
  <div class="av-section__inner">
    {% render 'anvil-section-head', section: section %}
    <div class="av-customers-register">
      <h1 class="av-customers-register__title">{{ s.title | escape }}</h1>
      {%- form 'create_customer', id: 'anvil-register-form', class: 'av-customers-register__form' -%}
        {%- if form.errors -%}
          <div class="av-customers-register__notice av-form-message av-form-message--error" id="anvil-register-form-errors" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="av-customers-register__row">
          <div class="av-customers-register__field av-field">
            <label class="av-customers-register__label av-field__label" for="anvil-register-first">{{ 'anvil.customer.first_name' | t }}</label>
            <input class="av-customers-register__input av-field__input" id="anvil-register-first" type="text" name="customer[first_name]" value="{{ form.first_name }}" autocomplete="given-name">
          </div>
          <div class="av-customers-register__field av-field">
            <label class="av-customers-register__label av-field__label" for="anvil-register-last">{{ 'anvil.customer.last_name' | t }}</label>
            <input class="av-customers-register__input av-field__input" id="anvil-register-last" type="text" name="customer[last_name]" value="{{ form.last_name }}" autocomplete="family-name">
          </div>
        </div>
        <div class="av-customers-register__field av-field">
          <label class="av-customers-register__label av-field__label" for="anvil-register-email">{{ 'anvil.customer.email' | t }} <span aria-hidden="true">*</span></label>
          <input class="av-customers-register__input av-field__input" id="anvil-register-email" type="email" name="customer[email]" value="{{ form.email }}" autocomplete="email" autocorrect="off" autocapitalize="off" required aria-required="true"{% if form.errors contains 'email' %} aria-invalid="true" aria-describedby="anvil-register-form-errors"{% endif %}>
        </div>
        <div class="av-customers-register__field av-field">
          <label class="av-customers-register__label av-field__label" for="anvil-register-password">{{ 'anvil.customer.password' | t }} <span aria-hidden="true">*</span></label>
          <input class="av-customers-register__input av-field__input" id="anvil-register-password" type="password" name="customer[password]" autocomplete="new-password" required aria-required="true"{% if form.errors contains 'password' %} aria-invalid="true" aria-describedby="anvil-register-form-errors"{% endif %}>
        </div>
        <div class="av-customers-register__actions">
          {% render 'anvil-button', label: submit_label, style: 'primary', size: 'lg', full: true, type: 'submit' %}
        </div>
      {%- endform -%}
      <p class="av-customers-register__alt">{{ 'anvil.customer.register.have_account' | t }} <a class="av-customers-register__link" href="{{ routes.account_login_url }}">{{ 'anvil.customer.register.log_in' | t }}</a></p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer register",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "select", "id": "width", "label": "Width", "options": [ {"value":"page","label":"Page width"}, {"value":"narrow","label":"Narrow"}, {"value":"full","label":"Full width"} ], "default": "page" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "select", "id": "pad_mobile", "label": "Padding on phones", "options": [ {"value":"same","label":"Same as desktop"}, {"value":"compact","label":"Compact"}, {"value":"none","label":"None"} ], "default": "compact" },
    { "type": "header", "content": "Customer register" },
    {
      "type": "text",
      "id": "title",
      "label": "Page title",
      "default": "Create an account"
    }
  ]
}
{% endschema %}
