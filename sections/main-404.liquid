{% render 'anvil-stylesheet', file: 'anvil-sec-main-404.css', section: section %}
{%- liquid
  assign s = section.settings
-%}
<div {% render 'anvil-section-attrs', section: section, type: 'main-404' %}>
  <div class="av-section__inner">
    {% render 'anvil-section-head', section: section %}
    <div class="av-404">
      <p class="av-404__code" aria-hidden="true">404</p>
      <h1 class="av-404__title">{{ s.title | escape }}</h1>
      {%- if s.text != blank -%}
        <div class="av-404__text">{{ s.text }}</div>
      {%- endif -%}
      <div class="av-404__actions">
        {% render 'anvil-button', label: s.button_label, url: routes.root_url, style: 'primary', size: 'lg' %}
        <a class="av-404__link" href="{{ routes.search_url }}">{{ 'anvil.not_found.search' | t }}</a>
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "404 page",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "select", "id": "width", "label": "Width", "options": [ {"value":"page","label":"Page width"}, {"value":"narrow","label":"Narrow"}, {"value":"full","label":"Full width"} ], "default": "page" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "select", "id": "pad_mobile", "label": "Padding on phones", "options": [ {"value":"same","label":"Same as desktop"}, {"value":"compact","label":"Compact"}, {"value":"none","label":"None"} ], "default": "compact" },
    { "type": "header", "content": "404 page" },
    {
      "type": "text",
      "id": "title",
      "label": "Page title",
      "default": "Page not found"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>The page you are looking for may have moved or no longer exists.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Back to home"
    }
  ]
}
{% endschema %}
