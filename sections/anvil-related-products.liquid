{{ 'anvil-sec-related-products.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings

  comment
    One file, two renders (spec card):
    - On the product page it prints a shell: the section root, hidden, with an empty <anvil-related-products> whose
      data-anvil-urls lists the recommendation requests (section_id, product_id, limit, intent). In the editor the
      root stays visible and the element holds example cards and a note instead.
    - Shopify's product recommendations endpoint renders this same section instance with the recommendations object;
      that render prints the cards inside <anvil-related-products>, or nothing at all when there are none.
    assets/anvil-related-products.js fetches the first URL, moves the response's cards into the shell and shows the
    root. Intent complementary lists a related URL second, used when the complementary request has no products.
    The editor never fetches: the endpoint renders the saved settings, so its cards would replace examples that follow
    the unsaved ones.
  endcomment
  assign limit = s.limit | default: 4 | at_least: 2 | at_most: 10

  assign mode = 'shell'
  if recommendations.performed?
    if recommendations.products_count > 0
      assign mode = 'cards'
    else
      assign mode = 'none'
    endif
  elsif request.design_mode
    assign mode = 'example'
  endif

  assign rec_urls = ''
  if mode == 'shell' and product != blank
    assign rec_base = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product.id | append: '&limit=' | append: limit
    assign rec_related = rec_base | append: '&intent=related'
    if s.intent == 'complementary'
      assign rec_urls = rec_base | append: '&intent=complementary ' | append: rec_related
    else
      assign rec_urls = rec_related
    endif
  endif

  assign cols_d = s.cols_desktop | default: '4' | plus: 0 | at_least: 2 | at_most: 6
  assign cols_m = s.cols_mobile | default: '2' | plus: 0 | at_least: 1 | at_most: 2

  comment
    Example cards fill at least one desktop row and never exceed the product count.
  endcomment
  assign ph_count = 0
  assign row_products = nil
  if mode == 'cards'
    assign row_products = recommendations.products
  elsif mode == 'example'
    assign ph_count = cols_d | at_least: 4 | at_most: limit
  endif

  comment
    Card titles are h3, so a section without a visible heading gets a visually hidden h2 (CONVENTIONS §3); the same
    words name the slider region.
  endcomment
  assign list_label = s.heading | strip_html | strip
  if list_label == blank
    assign list_label = 'anvil.related_products.label' | t
  endif
-%}
{%- unless mode == 'none' -%}
<div {% render 'anvil-section-attrs', section: section, type: 'anvil-related-products' %}{% if mode == 'shell' %} hidden{% endif %}>
  <div class="av-section__inner">
    {% render 'anvil-section-head', section: section, fallback: list_label %}
    {%- unless recommendations.performed? -%}
      {{ 'anvil-card.css' | asset_url | stylesheet_tag }}
      {%- if s.layout == 'slider' -%}
        {{ 'anvil-slider.css' | asset_url | stylesheet_tag }}
      {%- endif -%}
    {%- endunless -%}
    <anvil-related-products class="av-related-products"{% if rec_urls != '' %} data-anvil-urls="{{ rec_urls | escape }}"{% endif %}>
      {%- if mode == 'example' -%}
        <p class="av-related-products__note av-example-note">{{ 'anvil.editor.related_products_example' | t }}</p>
      {%- endif -%}
      {%- comment -%} Recommendations load below the first screen, so their cards stay lazy. {%- endcomment -%}
      {%- render 'anvil-product-row',
        products: row_products,
        limit: limit,
        placeholders: ph_count,
        layout: s.layout,
        cols_desktop: cols_d,
        cols_mobile: cols_m,
        show_arrows: s.show_arrows,
        show_dots: s.show_dots,
        label: list_label,
        fold: 'lazy',
        width: s.width,
        show_vendor: s.show_vendor,
        show_rating: s.show_rating,
        quick_add: s.quick_add,
        image_ratio: s.image_ratio,
        hover_image: s.hover_image,
        uid: section.id
      -%}
    </anvil-related-products>
    {%- unless recommendations.performed? -%}
      {%- if rec_urls != '' -%}
        <script type="module" src="{{ 'anvil-related-products.js' | asset_url }}"></script>
        {%- if s.quick_add -%}
          <script type="module" src="{{ 'anvil-product.js' | asset_url }}"></script>
        {%- endif -%}
      {%- endif -%}
      {%- comment -%} The shell loads the slider module; the cards arrive later from the recommendations render. {%- endcomment -%}
      {%- if s.layout == 'slider' -%}
        <script type="module" src="{{ 'anvil-slider.js' | asset_url }}"></script>
      {%- endif -%}
    {%- endunless -%}
  </div>
</div>
{%- endunless -%}
{% schema %}
{
  "name": "Related products",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Bold a word to colour it with the accent" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "text_alignment", "id": "head_align", "label": "Heading alignment", "default": "center" },
    { "type": "select", "id": "head_size", "label": "Heading size", "options": [ {"value":"xs","label":"Extra small"}, {"value":"sm","label":"Small"}, {"value":"md","label":"Medium"}, {"value":"lg","label":"Large"}, {"value":"xl","label":"Extra large"} ], "default": "lg" },
    { "type": "select", "id": "accent_style", "label": "Accent style for bold words", "options": [ {"value":"color","label":"Accent colour"}, {"value":"underline","label":"Underline"}, {"value":"highlight","label":"Highlight"}, {"value":"gradient","label":"Gradient"} ], "default": "color" },
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "select", "id": "width", "label": "Width", "options": [ {"value":"page","label":"Page width"}, {"value":"narrow","label":"Narrow"}, {"value":"full","label":"Full width"} ], "default": "page" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "select", "id": "pad_mobile", "label": "Padding on phones", "options": [ {"value":"same","label":"Same as desktop"}, {"value":"compact","label":"Compact"}, {"value":"none","label":"None"} ], "default": "compact" },
    { "type": "select", "id": "reveal", "label": "Animate on scroll", "options": [ {"value":"none","label":"Off"}, {"value":"fade-up","label":"Fade up"}, {"value":"fade","label":"Fade"}, {"value":"zoom","label":"Zoom"} ], "default": "none" },
    { "type": "select", "id": "show_on", "label": "Show on", "options": [ {"value":"all","label":"All devices"}, {"value":"mobile","label":"Phones only"}, {"value":"desktop","label":"Desktop only"} ], "default": "all" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "info": "Letters, numbers and hyphens. Link to this section with #your-id" },
    { "type": "header", "content": "Related products" },
    { "type": "paragraph", "content": "Products come from Shopify's recommendations for the product on the page. The editor always shows example cards; preview the store to see real ones. The section stays hidden when Shopify has none, and it needs JavaScript to load." },
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation type",
      "options": [
        { "value": "related", "label": "Related products" },
        { "value": "complementary", "label": "Complementary products" }
      ],
      "default": "related",
      "info": "Complementary shows the products you pick for each product in the Search & Discovery app. A product without picks shows related products instead."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Product count",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4,
      "info": "The most products shown. Shopify may return fewer."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "slider", "label": "Slider" }
      ],
      "default": "grid",
      "info": "Slider shows one row that shoppers swipe or scroll."
    },
    {
      "type": "select",
      "id": "cols_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ],
      "default": "4",
      "info": "In a slider this is the number in view. Tablets show up to 3; 4 columns become 2."
    },
    {
      "type": "select",
      "id": "cols_mobile",
      "label": "Columns on phones",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2",
      "info": "In a slider this is the number in view."
    },
    { "type": "header", "content": "Product cards" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "theme", "label": "Same as theme cards" },
        { "value": "adapt", "label": "Original" },
        { "value": "1:1", "label": "Square (1:1)" },
        { "value": "4:5", "label": "Portrait (4:5)" },
        { "value": "3:4", "label": "Portrait (3:4)" },
        { "value": "16:9", "label": "Landscape (16:9)" }
      ],
      "default": "theme"
    },
    {
      "type": "checkbox",
      "id": "hover_image",
      "label": "Show second image on hover",
      "default": true,
      "info": "Only on devices that can hover. Phones never download the second image."
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show product rating",
      "default": false,
      "info": "Stars appear only for products rated by a review app (the reviews.rating metafield). Nothing shows otherwise."
    },
    {
      "type": "checkbox",
      "id": "quick_add",
      "label": "Show quick add",
      "default": false,
      "info": "Products with one variant get an Add to cart button. Products with options get a link to choose them."
    },
    {
      "type": "header",
      "content": "Slider",
      "visible_if": "{{ section.settings.layout == 'slider' }}"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'slider' }}",
      "info": "On tablets and desktops, beside the row while it scrolls. Phones swipe. Arrows stay on while dots are off."
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'slider' }}"
    }
  ],
  "presets": [
    {
      "name": "Related products",
      "settings": {
        "heading": "More to <strong>explore</strong>",
        "intent": "related",
        "limit": 4,
        "layout": "grid",
        "cols_desktop": "4"
      }
    }
  ]
}
{% endschema %}
