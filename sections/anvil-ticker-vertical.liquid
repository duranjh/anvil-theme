{% render 'anvil-stylesheet', file: 'anvil-sec-ticker-vertical.css', section: section %}
{%- liquid
  assign s = section.settings
  assign design = request.design_mode

  # Lines that render: a blank line is skipped on the storefront and kept in the editor (with a note) so the
  # merchant can still select it. Counted first for the "Slide N of M" names. Never put a tag delimiter inside a
  # comment line of a liquid tag: it would end the tag early.
  assign line_count = 0
  for block in section.blocks
    if block.settings.text != blank or design
      assign line_count = line_count | plus: 1
    endif
  endfor
  assign multi = false
  if line_count > 1
    assign multi = true
  endif

  assign transition = s.transition | default: 'slide'
  assign text_size = s.text_size | default: 'md'
  assign align = s.text_align | default: 'center'
  assign interval = s.autoplay | default: 4
  assign line_h = s.height | default: 40

  assign root_class = 'av-ticker-vertical av-ticker-vertical--' | append: transition
  assign root_class = root_class | append: ' av-ticker-vertical--' | append: text_size
  assign root_class = root_class | append: ' av-ticker-vertical--' | append: align
  if s.uppercase
    assign root_class = root_class | append: ' av-ticker-vertical--upper'
  endif
  if multi
    assign root_class = root_class | append: ' av-ticker-vertical--multi av-enhance'
    # strip_html keeps the heading's stored entities (an ampersand is saved as an entity), so the label is printed
    # with escape_once, which leaves those entities as they are instead of escaping them a second time.
    assign region_label = s.heading | strip_html | strip
    if region_label == blank
      assign region_label = 'anvil.a11y.highlights' | t
    endif
    assign pause_label = 'anvil.a11y.pause' | t
    assign play_label = 'anvil.a11y.play' | t
  endif
  assign empty_label = 'anvil.editor.block_empty' | t
  assign n = 0
-%}
{%- if line_count > 0 -%}
<div {% render 'anvil-section-attrs', section: section, type: 'anvil-ticker-vertical' %}>
  <div class="av-section__inner">
    {% render 'anvil-section-head', section: section %}
    {%- if line_count > 0 -%}
      <anvil-ticker-vertical
        class="{{ root_class }}"
        style="--av-ticker-vertical-h: {{ line_h }}px;"
        {%- if multi %}
          interval="{{ interval }}"
          role="region"
          aria-roledescription="{{ 'anvil.a11y.carousel' | t }}"
          aria-label="{{ region_label | escape_once }}"
        {%- endif %}
      >
        {%- if multi -%}
          <button
            type="button"
            class="av-ticker-vertical__toggle av-enhanced-only"
            aria-label="{{ pause_label | escape }}"
            data-anvil-toggle
            data-anvil-pause="{{ pause_label | escape }}"
            data-anvil-play="{{ play_label | escape }}"
          >
            {%- render 'anvil-icon', name: 'pause', size: 18, class: 'av-ticker-vertical__ico-pause' -%}
            {%- render 'anvil-icon', name: 'play', size: 18, class: 'av-ticker-vertical__ico-play' -%}
          </button>
        {%- endif -%}
        <div class="av-ticker-vertical__viewport"{% if multi %} aria-live="polite" data-anvil-viewport{% endif %}>
          {%- for block in section.blocks -%}
            {%- liquid
              assign text = block.settings.text
              assign link = block.settings.link
              if text == blank
                unless design
                  continue
                endunless
              endif
              assign n = n | plus: 1
              # A link around the whole line cannot hold the text's own links (no nested anchors).
              if link != blank and text contains '<a'
                assign text = text | strip_html
              endif
            -%}
            <div
              class="av-ticker-vertical__item{% if n == 1 %} av-is-current{% endif %}"
              {%- if multi %}
                role="group"
                aria-label="{{ 'anvil.a11y.slide_of' | t: index: n, total: line_count }}"
                data-anvil-line
              {%- endif %}
              {{ block.shopify_attributes }}
            >
              {%- if text == blank -%}
                <span class="av-ticker-vertical__text av-example-note">{{ empty_label }}</span>
              {%- elsif link != blank -%}
                <a class="av-ticker-vertical__text av-ticker-vertical__link" href="{{ link }}">{{ text }}</a>
              {%- else -%}
                <span class="av-ticker-vertical__text">{{ text }}</span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </anvil-ticker-vertical>
      {%- if multi -%}
        <script type="module" src="{{ 'anvil-ticker-vertical.js' | asset_url }}"></script>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>
{%- elsif design -%}
<div {% render 'anvil-section-attrs', section: section, type: 'anvil-ticker-vertical' %}>
  <div class="av-section__inner">
    {% render 'anvil-section-head', section: section %}
    {% render 'anvil-editor-empty' %}
  </div>
</div>
{%- endif -%}
{% schema %}
{
  "name": "Ticker (vertical)",
  "max_blocks": 12,
  "disabled_on": { "groups": ["custom.overlay"] },
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Bold a word to colour it with the accent" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "text_alignment", "id": "head_align", "label": "Heading alignment", "default": "center" },
    { "type": "select", "id": "head_size", "label": "Heading size", "options": [ {"value":"xs","label":"Extra small"}, {"value":"sm","label":"Small"}, {"value":"md","label":"Medium"}, {"value":"lg","label":"Large"}, {"value":"xl","label":"Extra large"} ], "default": "lg" },
    { "type": "select", "id": "accent_style", "label": "Accent style for bold words", "options": [ {"value":"color","label":"Accent colour"}, {"value":"underline","label":"Underline"}, {"value":"highlight","label":"Highlight"}, {"value":"gradient","label":"Gradient"} ], "default": "color" },
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "select", "id": "width", "label": "Width", "options": [ {"value":"page","label":"Page width"}, {"value":"narrow","label":"Narrow"}, {"value":"full","label":"Full width"} ], "default": "page" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "select", "id": "pad_mobile", "label": "Padding on phones", "options": [ {"value":"same","label":"Same as desktop"}, {"value":"compact","label":"Compact"}, {"value":"none","label":"None"} ], "default": "compact" },
    { "type": "select", "id": "reveal", "label": "Animate on scroll", "options": [ {"value":"none","label":"Off"}, {"value":"fade-up","label":"Fade up"}, {"value":"fade","label":"Fade"}, {"value":"zoom","label":"Zoom"} ], "default": "none" },
    { "type": "select", "id": "show_on", "label": "Show on", "options": [ {"value":"all","label":"All devices"}, {"value":"mobile","label":"Phones only"}, {"value":"desktop","label":"Desktop only"} ], "default": "all" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "info": "Letters, numbers and hyphens. Link to this section with #your-id" },
    { "type": "header", "content": "Ticker (vertical)" },
    {
      "type": "range",
      "id": "autoplay",
      "label": "Auto-advance every",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4,
      "info": "Shoppers can pause with the button beside the lines, and rotation waits while the pointer or keyboard focus is on them. It starts paused on the first line for shoppers who prefer reduced motion, and for every shopper when animations are off in Theme settings."
    },
    {
      "type": "range",
      "id": "height",
      "label": "Height",
      "min": 24,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40,
      "info": "Minimum height of the line area. A line that wraps on a small screen makes it taller instead of being cut off."
    },
    {
      "type": "select",
      "id": "transition",
      "label": "Transition",
      "options": [
        { "value": "slide", "label": "Slide up" },
        { "value": "fade", "label": "Fade" }
      ],
      "default": "slide"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text size",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" },
        { "value": "xl", "label": "Extra large" }
      ],
      "default": "md"
    },
    {
      "type": "text_alignment",
      "id": "text_align",
      "label": "Text alignment",
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "Uppercase text",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "Example: replace with a message that is true for your store",
          "info": "State only what is true for your store: offers, shipping thresholds and dates must match your settings and policies. No deadlines or stock levels that are not real."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional. Makes the whole line a link. If the text has its own links, the line is then shown as plain text without links, bold or italic."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ticker (vertical)",
      "settings": {
        "pad_top": 12,
        "pad_bottom": 12
      },
      "blocks": [
        {
          "type": "text",
          "settings": {
            "text": "Example: <strong>free shipping</strong> on orders over $50 — replace with your real threshold"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "Example: 30-day returns — replace with the window in your refund policy"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "Example: new arrivals every week — replace with news that is true for your store"
          }
        }
      ]
    }
  ]
}
{% endschema %}
