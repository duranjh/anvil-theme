{% render 'anvil-stylesheet', file: 'anvil-sec-group.css', section: section %}
{%- liquid
  assign s = section.settings

  # A container section. Its blocks are theme blocks and app blocks rendered by content_for: most often
  # Group boxes (blocks/anvil-group.liquid), which carry their own colour scheme, padding, border and
  # corners and hold further groups and content blocks (Shopify allows 8 levels of blocks below the
  # section in all, counting the content inside the innermost group). The section owns the outer
  # layout only: stacked or two columns, the space between blocks, vertical alignment and an
  # optional content box in its own scheme behind the heading and the blocks.
  assign layout = s.layout | default: 'two'
  assign ratio = s.col_split | default: '1-1'
  assign valign = s.valign | default: 'stretch'

  assign space = 24
  if s.gap != nil
    assign space = s.gap
  endif

  assign grid_class = 'av-group'
  if layout == 'two'
    assign grid_class = grid_class | append: ' av-group--two av-group--r' | append: ratio | append: ' av-group--v-' | append: valign
    if s.cols_from == 'desktop'
      assign grid_class = grid_class | append: ' av-group--d'
    else
      assign grid_class = grid_class | append: ' av-group--t'
    endif
    if s.full_row
      assign grid_class = grid_class | append: ' av-group--span'
    endif
  endif
  if s.compact_mobile
    assign grid_class = grid_class | append: ' av-group--compact'
  endif

  # The content box composes the theme's container look (.av-box: Theme settings > Content containers)
  # in the scheme picked here; only its padding is set by the section. With no blocks and no heading
  # text the box is skipped on the storefront, so shoppers never see an empty panel; the editor keeps
  # it so the empty-section note shows where content will go.
  assign has_content = false
  if section.blocks.size > 0 or s.heading != blank or s.subheading != blank or request.design_mode
    assign has_content = true
  endif
  assign panel_class = 'av-group__panel'
  assign panel_style = ''
  if s.box and has_content
    assign box_scheme = 'scheme-2'
    if s.box_scheme != blank
      assign box_scheme = s.box_scheme.id
    endif
    assign box_pad = 32
    if s.box_pad != nil
      assign box_pad = s.box_pad
    endif
    assign panel_class = panel_class | append: ' av-group__panel--box av-box av-scheme av-scheme--' | append: box_scheme
    assign panel_style = ' style="--av-group-box-pad: ' | append: box_pad | append: 'px;"'
  endif
-%}
<div {% render 'anvil-section-attrs', section: section, type: 'anvil-group' %}>
  <div class="av-section__inner">
    <div class="{{ panel_class }}"{{ panel_style }}>
      {% render 'anvil-section-head', section: section %}
      {%- if section.blocks.size == 0 -%}
        {% render 'anvil-editor-empty' %}
      {%- endif -%}
      <div class="{{ grid_class }}" style="--av-group-space: {{ space }}px;">
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Group",
  "disabled_on": { "groups": ["header", "custom.overlay"] },
  "settings": [
    { "type": "header", "content": "Heading" },
