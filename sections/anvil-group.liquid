      "default": "tablet",
      "info": "Narrower screens stack the blocks in the order set in the editor.",
      "visible_if": "{{ section.settings.layout == 'two' }}"
    },
    {
      "type": "select",
      "id": "valign",
      "label": "Vertical alignment",
      "options": [
        { "value": "stretch", "label": "Equal heights" },
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "stretch",
      "info": "Equal heights makes the boxes in a row line up top and bottom.",
      "visible_if": "{{ section.settings.layout == 'two' }}"
    },
    {
      "type": "checkbox",
      "id": "full_row",
      "label": "Other blocks span both columns",
      "default": true,
      "info": "Headings, text, buttons and app blocks placed straight in the section take a full row of their own. Groups before and after them start new rows, so place them above or below the groups.",
      "visible_if": "{{ section.settings.layout == 'two' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between blocks",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "compact_mobile",
      "label": "Tighter group padding on phones",
      "default": true,
      "info": "Below 750 px, groups use at most 24 px of padding and groups inside groups at most 12 px, so nested boxes keep room for their content."
    },
    { "type": "header", "content": "Content box" },
    {
      "type": "checkbox",
      "id": "box",
      "label": "Show content box",
      "default": false,
      "info": "Draws the heading and the blocks on a panel in its own colour scheme. Corners, border and shadow follow Theme settings > Content containers."
    },
    {
      "type": "color_scheme",
      "id": "box_scheme",
      "label": "Content box colour scheme",
      "default": "scheme-2",
      "visible_if": "{{ section.settings.box }}"
    },
    {
      "type": "range",
      "id": "box_pad",
      "label": "Content box padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32,
      "info": "Phones use at most 24 px.",
      "visible_if": "{{ section.settings.box }}"
    }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "presets": [
    {
