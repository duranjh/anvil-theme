{%- liquid
  assign s = block.settings
-%}
<div class="av-spacer" style="--av-spacer: {{ s.height }}px; --av-spacer-mobile: {{ s.height_mobile }}px;" aria-hidden="true" {{ block.shopify_attributes }}></div>
{% stylesheet %}
.av-spacer{width:100%;flex:none;height:var(--av-spacer-mobile,16px)}
@media (min-width:750px){.av-spacer{height:var(--av-spacer,32px)}}
{% endstylesheet %}
{% schema %}
{
  "name": "Spacer",
  "tag": null,
  "settings": [
    { "type": "range", "id": "height", "label": "Height on desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "height_mobile", "label": "Height on phones", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 16 }
  ],
  "presets": [ { "name": "Spacer" } ]
}
{% endschema %}
