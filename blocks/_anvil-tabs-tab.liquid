{
  "name": "Tab",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Tab title",
      "default": "Example tab",
      "info": "Shoppers pick the tab by this name. A tab without a title is hidden from shoppers."
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "info", "label": "Info" },
        { "value": "check-circle", "label": "Check in circle" },
        { "value": "badge-check", "label": "Badge check" },
        { "value": "help-circle", "label": "Question mark" },
        { "value": "book-open", "label": "Open book" },
        { "value": "file-text", "label": "Document" },
        { "value": "layers", "label": "Layers" },
        { "value": "ruler", "label": "Ruler" },
        { "value": "scale", "label": "Scale" },
        { "value": "leaf", "label": "Leaf" },
        { "value": "droplet", "label": "Droplet" },
        { "value": "recycle", "label": "Recycle" },
        { "value": "sun", "label": "Sun" },
        { "value": "snowflake", "label": "Snowflake" },
        { "value": "flame", "label": "Flame" },
        { "value": "shirt", "label": "Shirt" },
        { "value": "utensils", "label": "Cutlery" },
        { "value": "home", "label": "Home" },
        { "value": "box", "label": "Box" },
        { "value": "package", "label": "Package" },
        { "value": "truck", "label": "Truck" },
        { "value": "globe", "label": "Globe" },
        { "value": "map-pin", "label": "Map pin" },
        { "value": "rotate-ccw", "label": "Return arrow" },
        { "value": "shield-check", "label": "Shield check" },
        { "value": "lock", "label": "Lock" },
        { "value": "wrench", "label": "Wrench" },
        { "value": "settings", "label": "Gear" },
        { "value": "zap", "label": "Lightning" },
        { "value": "sparkles", "label": "Sparkles" },
        { "value": "star", "label": "Star" },
        { "value": "heart", "label": "Heart" },
        { "value": "thumbs-up", "label": "Thumbs up" },
        { "value": "award", "label": "Award" },
        { "value": "trophy", "label": "Trophy" },
        { "value": "gift", "label": "Gift" },
        { "value": "tag", "label": "Tag" },
        { "value": "percent", "label": "Percent" },
        { "value": "users", "label": "People" },
        { "value": "message-circle", "label": "Chat bubble" },
        { "value": "clock", "label": "Clock" },
        { "value": "calendar", "label": "Calendar" },
        { "value": "play", "label": "Play" },
        { "value": "video", "label": "Video" },
        { "value": "camera", "label": "Camera" },
        { "value": "image", "label": "Image" }
      ],
      "default": "none"
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "Custom icon image",
      "info": "Replaces the icon. Square images work best. Upload only artwork you are entitled to use."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Tab link id",
      "info": "Letters, numbers and hyphens, different from every other id on the page. With \"Open tabs from links\" on, a link ending in #your-id opens this tab."
    },
    { "type": "header", "content": "Panel" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "stack", "label": "Stacked" },
        { "value": "split", "label": "Two columns from tablets up" }
      ],
      "default": "stack"
    },
    {
      "type": "select",
      "id": "valign",
      "label": "Vertical alignment in two columns",
      "options": [
        { "value": "center", "label": "Middle" },
        { "value": "top", "label": "Top" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Content width",
      "options": [
        { "value": "full", "label": "Container" },
        { "value": "narrow", "label": "Narrow" }
      ],
      "default": "full"
    },
    {
      "type": "text_alignment",
      "id": "align",
      "label": "App block alignment",
      "default": "left",
      "info": "Aligns app blocks and the title shown without JavaScript. Theme blocks keep their own alignment setting."
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between blocks",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
