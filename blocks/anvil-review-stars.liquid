{% doc %}
  Theme block: "rated X on <platform>" badge. Every part of it (stars, number, wording, logo) renders only with a source link shoppers can follow; the stars and the number also need a typed rating above 0.

  Settings (id · type · values · default):
  - logo · image_picker
  - text · text · default "Example: rated by our customers on — replace with your real wording"
  - rating · range · 0–5 step 0.1 · default 0 (not set: no stars or number until the merchant types the rating)
  - source_url · url
  - show_stars · checkbox · default true
  - show_number · checkbox · default true
  - align · text_alignment · default "left"

  @example
  {"type": "anvil-review-stars"}
{% enddoc %}
{%- liquid
  assign s = block.settings
  assign has_source = false
  if s.source_url != blank
    assign has_source = true
  endif
  assign has_rating = false
  if s.rating > 0
    assign has_rating = true
  endif
  assign logo_alt = s.logo.alt | default: ''
  comment
    Everything in this badge is a rating claim (stars, number, wording, platform logo), so all of it renders only
    with a source link shoppers can follow to check it (docs/HONEST.md, CONVENTIONS section 10). The rating defaults
    to 0, "not set", so the stars and the number stay hidden until the merchant types the rating the source shows.
  endcomment
  capture badge_inner
    if has_rating and s.show_stars
      render 'anvil-stars', rating: s.rating, size: 18, class: 'av-review-stars__stars'
    endif
    if has_rating and s.show_number
      echo '<span class="av-review-stars__number">'
      echo s.rating
      echo '/5</span>'
    endif
    if s.text != blank
      echo '<span class="av-review-stars__text">'
      echo s.text
      echo '</span>'
    endif
    if s.logo != blank
      echo s.logo | image_url: width: 200 | image_tag: widths: '100, 200', sizes: '100px', loading: 'lazy', alt: logo_alt, class: 'av-review-stars__logo'
    endif
  endcapture
  assign badge_inner = badge_inner | strip
-%}
<div class="av-review-stars av-review-stars--{{ s.align }}" {{ block.shopify_attributes }}>
  {%- if has_source and badge_inner != blank -%}
    <a class="av-review-stars__link" href="{{ s.source_url }}" target="_blank" rel="noopener">{{ badge_inner }}<span class="av-visually-hidden"> {{ 'anvil.a11y.new_window' | t }}</span></a>
  {%- elsif request.design_mode -%}
    {%- if has_source -%}
      <p class="av-review-stars__note">{{ 'anvil.editor.block_empty' | t }}</p>
    {%- else -%}
      <p class="av-review-stars__note">{{ 'anvil.editor.review_stars_no_source' | t }}</p>
    {%- endif -%}
  {%- endif -%}
</div>
{% stylesheet %}
.av-review-stars{display:flex;flex-wrap:wrap;align-items:center;gap:var(--av-space-2);font-family:var(--av-font-body);font-size:var(--av-text-sm);line-height:1.4}
.av-review-stars--left{justify-content:flex-start}
.av-review-stars--center{justify-content:center;text-align:center}
.av-review-stars--right{justify-content:flex-end}
.av-review-stars__link{display:inline-flex;flex-wrap:wrap;align-items:center;gap:var(--av-space-2);color:inherit;text-decoration:none}
.av-review-stars__link:hover .av-review-stars__text{text-decoration:underline}
.av-review-stars__number{font-weight:600}
.av-review-stars__logo{height:1.5em;width:auto;max-width:120px;object-fit:contain}
.av-review-stars__note{margin:0;font-size:var(--av-text-xs);color:var(--av-fg-muted)}
{% endstylesheet %}
{% schema %}
{
  "name": "Review platform stars",
  "tag": null,
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Platform logo", "info": "Upload a logo you are entitled to use. Anvil ships no third-party logos." },
    { "type": "text", "id": "text", "label": "Text", "default": "Example: rated by our customers on — replace with your real wording", "info": "Do not type a rating or review count here. The number shows only from the rating below, and the whole badge only with a source link shoppers can check." },
    { "type": "range", "id": "rating", "label": "Rating", "min": 0, "max": 5, "step": 0.1, "default": 0, "info": "0 means not set: no stars or number show. Type the rating exactly as the source page shows it and keep it up to date." },
    { "type": "url", "id": "source_url", "label": "Source link", "info": "The page where shoppers can verify this rating. Nothing in this badge shows until this link is set." },
    { "type": "checkbox", "id": "show_stars", "label": "Show stars", "default": true },
    { "type": "checkbox", "id": "show_number", "label": "Show the number", "default": true },
    { "type": "text_alignment", "id": "align", "label": "Alignment", "default": "left" }
  ],
  "presets": [ { "name": "Review platform stars" } ]
}
{% endschema %}
