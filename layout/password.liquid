<!doctype html>
<html
  class="no-js av-scrollbar--{{ settings.scrollbar_style }}"
  lang="{{ request.locale.iso_code }}"
  data-animations="{% if settings.animations_enabled %}on{% else %}off{% endif %}"
>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.body_color_scheme.settings.background }}">
    {%- render 'anvil-meta' -%}
    {%- render 'anvil-css-tokens', part: 'preload' -%}
    <style>{% render 'anvil-css-tokens' %}</style>
    {{ 'anvil-base.css' | asset_url | stylesheet_tag: preload: true }}
    {{ content_for_header }}
    <script>
      document.documentElement.classList.replace('no-js', 'js');
      window.Anvil = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          cartClear: {{ routes.cart_clear_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }},
          search: {{ routes.search_url | json }},
          productRecommendations: {{ routes.product_recommendations_url | json }},
          collections: {{ routes.collections_url | json }},
          allProducts: {{ routes.all_products_collection_url | json }},
          account: {{ routes.account_url | json }},
          login: {{ routes.account_login_url | json }}
        },
        modules: {
          events: {{ 'anvil-events.js' | asset_url | json }},
          'cart-api': {{ 'anvil-cart-api.js' | asset_url | json }},
          sections: {{ 'anvil-sections.js' | asset_url | json }},
          dom: {{ 'anvil-dom.js' | asset_url | json }}
        },
        moneyFormat: {{ shop.money_format | json }},
        moneyWithCurrencyFormat: {{ shop.money_with_currency_format | json }},
        currency: {{ cart.currency.iso_code | json }},
        locale: {{ request.locale.iso_code | json }},
        designMode: {{ request.design_mode | json }},
        strings: {
          close: {{ 'anvil.a11y.close' | t | json }},
          loading: {{ 'anvil.a11y.loading' | t | json }},
          error: {{ 'anvil.a11y.error' | t | json }},
          newsletterSuccess: {{ 'anvil.newsletter.success' | t | json }},
          newsletterError: {{ 'anvil.newsletter.error' | t | json }}
        },
        settings: {
          cartType: {{ settings.cart_type | json }},
          openCartOnAdd: false,
          showCurrencyCode: {{ settings.show_currency_code | json }},
          animations: {{ settings.animations_enabled | json }},
          revealStyle: {{ settings.animations_reveal | json }},
          predictiveSearch: false,
          predictiveSearchShowPrice: false
        }
      };
      {%- comment -%} Decode the HTML-escaped translations to plain text, as in theme.liquid (DECISIONS 135). {%- endcomment %}
      (function (s, box) {
        for (var k in s) {
          if (/Html$/.test(k)) continue;
          box.innerHTML = s[k];
          s[k] = box.value;
        }
      })(window.Anvil.strings, document.createElement('textarea'));
    </script>
    <link rel="modulepreload" href="{{ 'anvil-events.js' | asset_url }}">
    <link rel="modulepreload" href="{{ 'anvil-cart-api.js' | asset_url }}">
    <link rel="modulepreload" href="{{ 'anvil-sections.js' | asset_url }}">
    <link rel="modulepreload" href="{{ 'anvil-dom.js' | asset_url }}">
    <script type="module" src="{{ 'anvil-core.js' | asset_url }}"></script>
    {%- if request.design_mode -%}
      <script type="module" src="{{ 'anvil-editor.js' | asset_url }}"></script>
    {%- endif -%}
  </head>
  <body
    class="av-body av-scheme av-scheme--{{ settings.body_color_scheme.id }} av-tpl--password av-btn-hover--{{ settings.button_hover }}{% if settings.animations_hover_lift %} av-hover-lift{% endif %}{% if request.design_mode %} av-design-mode{% endif %}"
  >
    <a class="av-skip-link" href="#main">{{ 'anvil.a11y.skip_to_content' | t }}</a>
    <main id="main" class="av-main" tabindex="-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>
