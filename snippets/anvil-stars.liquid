{% doc %}
  Star rating: max stars (default 5) with partial fill, announced as one image.
  This snippet only draws; the number must come from a rating metafield or carry a source link (docs/HONEST.md).
  Styles live in assets/anvil-card.css.

  @param {number} rating - Rating value, for example 4.5
  @param {number} [max] - Scale maximum (default 5)
  @param {number} [size] - Star size in px (default 18)
  @param {string} [label] - Accessible label; default "4.5 out of 5 stars" (escaped here with escape_once)
  @param {string} [class] - Extra classes

  @example
  {% render 'anvil-stars', rating: product.metafields.reviews.rating.value.rating, max: product.metafields.reviews.rating.value.scale_max %}
{% enddoc %}
{%- liquid
  assign stars_max = max | default: 5 | round
  if stars_max < 1
    assign stars_max = 5
  endif
  assign stars_value = rating | default: 0 | times: 1.0
  if stars_value < 0
    assign stars_value = 0.0
  endif
  if stars_value > stars_max
    assign stars_value = stars_max | times: 1.0
  endif
  assign fill_pct = stars_value | divided_by: stars_max | times: 100.0 | round: 1
  assign stars_size = size | default: 18
  assign rating_text = stars_value | round: 1
  if label != blank
    assign stars_label = label
  else
    assign stars_label = 'anvil.stars.label' | t: rating: rating_text, max: stars_max
  endif
  assign star_body = '<path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/>'
-%}
<span class="av-stars{% if class != blank %} {{ class }}{% endif %}" role="img" aria-label="{{ stars_label | escape_once }}" style="--av-stars-fill: {{ fill_pct }}%; --av-stars-size: {{ stars_size }}px;">
  <span class="av-stars__row av-stars__row--base" aria-hidden="true">
    {%- for i in (1..stars_max) -%}<svg class="av-stars__star" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="{{ stars_size }}" height="{{ stars_size }}" fill="currentColor" stroke="currentColor" stroke-width="1" stroke-linejoin="round" focusable="false">{{ star_body }}</svg>{%- endfor -%}
  </span>
  <span class="av-stars__row av-stars__row--fill" aria-hidden="true">
    {%- for i in (1..stars_max) -%}<svg class="av-stars__star" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="{{ stars_size }}" height="{{ stars_size }}" fill="currentColor" stroke="currentColor" stroke-width="1" stroke-linejoin="round" focusable="false">{{ star_body }}</svg>{%- endfor -%}
  </span>
</span>
