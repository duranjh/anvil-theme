{% doc %}
  Document <title>, description, canonical link, Open Graph and Twitter cards
  from Shopify's page_title / page_description / page_image objects, and the
  favicon from theme settings. Rendered once in <head> by both layouts.
{% enddoc %}
{%- liquid
  assign title = page_title
  if current_tags
    assign tag_label = current_tags | join: ', '
    assign tags_text = 'general.meta.tags' | t: tags: tag_label
    assign title = title | append: ' – ' | append: tags_text
  endif
  if current_page and current_page > 1
    assign page_text = 'general.meta.page' | t: page: current_page
    assign title = title | append: ' – ' | append: page_text
  endif
  unless page_title contains shop.name
    assign title = title | append: ' – ' | append: shop.name
  endunless

  assign og_type = 'website'
  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  endif
-%}
<title>{{ title | escape }}</title>
{%- if page_description -%}
  <meta name="description" content="{{ page_description | escape }}">
{%- endif -%}
<link rel="canonical" href="{{ canonical_url }}">
{%- if settings.favicon != blank -%}
  <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
{%- endif -%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ title | escape }}">
<meta property="og:type" content="{{ og_type }}">
{%- if page_description -%}
  <meta property="og:description" content="{{ page_description | escape }}">
{%- endif -%}
{%- if page_image -%}
  {%- liquid
    assign og_width = page_image.width | at_most: 1200
    assign og_height = 0
    if page_image.width > 0
      assign og_height = page_image.height | times: og_width | divided_by: page_image.width
    endif
  -%}
  <meta property="og:image" content="http:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="{{ og_width }}">
  <meta property="og:image:height" content="{{ og_height }}">
  {%- if page_image.alt != blank -%}
    <meta property="og:image:alt" content="{{ page_image.alt | escape }}">
  {%- endif -%}
{%- endif -%}
{%- if request.page_type == 'product' and product -%}
  <meta property="og:price:amount" content="{{ product.selected_or_first_available_variant.price | divided_by: 100.0 }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}
<meta name="twitter:card" content="{% if page_image %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ title | escape }}">
{%- if page_description -%}
  <meta name="twitter:description" content="{{ page_description | escape }}">
{%- endif -%}
