{% doc %}
  Inline SVG icon from the Lucide icon set (ISC licence; credited in NOTICE). Renders nothing when the name is unknown.
  The path data lives in four small lookup snippets split by first letter (anvil-icon-a-c, -d-l, -m-r, -s-z), so
  each render evaluates one short case/when instead of scanning a 27 KB table.

  @param {string} name - Icon name, for example 'check', 'truck' or 'star'
  @param {number} [size] - Width and height in pixels (default 24)
  @param {string} [label] - Accessible name; when set the icon gets role="img" and aria-label, otherwise it is aria-hidden (escaped here with escape_once)
  @param {string} [class] - Extra classes added to the <svg>

  @example
  {% render 'anvil-icon', name: 'truck', size: 20 %}
  {% render 'anvil-icon', name: 'star', label: 'Rated 5 stars' %}
{% enddoc %}
{%- liquid
  assign icon_size = size | default: 24
  assign icon_first = name | slice: 0 | downcase
  capture icon_body
    case icon_first
      when 'a', 'b', 'c'
        render 'anvil-icon-a-c', name: name
      when 'd', 'e', 'f', 'g', 'h', 'i', 'j', 'k', 'l'
        render 'anvil-icon-d-l', name: name
      when 'm', 'n', 'o', 'p', 'q', 'r'
        render 'anvil-icon-m-r', name: name
      when 's', 't', 'u', 'v', 'w', 'x', 'y', 'z'
        render 'anvil-icon-s-z', name: name
    endcase
  endcapture
-%}
{%- if icon_body != blank -%}
<svg class="av-icon{% if class != blank %} {{ class }}{% endif %}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"{% if label != blank %} role="img" aria-label="{{ label | escape_once }}"{% else %} aria-hidden="true" focusable="false"{% endif %}>{{ icon_body }}</svg>
{%- endif -%}
