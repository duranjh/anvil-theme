{% doc %}
  One quantity tier card (DESIGN-money-path §D, SPEC §3.2): a radio named quantity that posts with
  form="<form_id>" (so it works without JavaScript) and sets how many units are added. It shows the label, a badge
  (only when the merchant ticked "backed by sales data") and the price per unit.
  A discount is only ever displayed, never granted: when the tier has both a percentage and the automatic
  discount's title, the card shows the unit price with that percentage off, the regular price struck through and
  "with <title> applied at checkout"; Shopify applies the real discount. Without a title no discounted price is
  shown (the editor shows a hint instead). In the theme editor, assets/anvil-product.js compares the cart line's
  discount with this promise after every add (data-anvil-pct / data-anvil-title).
  A tier outside the variant's quantity rule (below the minimum, above the maximum, not a multiple of the
  increment) is disabled. Rendered by snippets/anvil-pb-quantity.liquid; quantity_tier is a data block, so the
  dispatcher never renders it, and without a tier this snippet prints nothing.

  @param {object} [tier] - The quantity_tier block
  @param {object} [variant] - Variant whose price the card shows
  @param {string} [form_id] - Id of the product form
  @param {boolean} [checked] - Selected on load
  @param {number} [q_min] - Quantity rule minimum
  @param {number} [q_max] - Highest allowed quantity, 0 for no limit
  @param {number} [q_step] - Quantity rule increment
{% enddoc %}
{%- if tier != blank -%}
  {%- liquid
    assign ts = tier.settings
    assign qty = ts.tier_qty | default: 1
    assign pct = ts.tier_discount_percent | default: 0
    assign title = ts.tier_discount_title | strip
    assign label = ts.tier_label | strip
    if label == blank
      assign label = 'anvil.product.tier_label' | t: quantity: qty
    endif
    assign badge = ts.tier_badge | strip
    if ts.tier_badge_backed_by_sales != true
      assign badge = ''
    endif

    assign price = variant.price | default: 0
    assign unit = price
    assign promo = false
    if pct > 0 and title != blank
      assign promo = true
      assign unit_off = price | times: pct | divided_by: 100.0 | round
      assign unit = price | minus: unit_off
    endif
    capture unit_money
      render 'anvil-money', amount: unit
    endcapture
    assign unit_money = unit_money | strip

    assign step = q_step | default: 1
    assign rest = qty | modulo: step
    assign outside = false
    if qty < q_min or rest != 0
      assign outside = true
    endif
    if q_max > 0 and qty > q_max
      assign outside = true
    endif
  -%}
  <label class="av-offer-card av-tier" {{ tier.shopify_attributes }}>
    <input
      class="av-offer-card__input"
      type="radio"
      name="quantity"
      value="{{ qty }}"
      form="{{ form_id }}"
      data-anvil-tier
      {%- if promo %} data-anvil-pct="{{ pct }}" data-anvil-title="{{ title | escape }}"{% endif %}
      {%- if checked and outside == false %} checked{% endif %}
      {%- if outside %} disabled{% endif %}
    >
    <span class="av-offer-card__body">
      {%- if badge != blank -%}
        <span class="av-badge av-badge--accent av-offer-card__badge">{{ badge | escape }}</span>
      {%- endif -%}
      <span class="av-offer-card__text">
        <span class="av-offer-card__label">{{ label | escape }}</span>
        {%- if promo -%}
          {%- assign title_html = title | escape -%}
          <span class="av-offer-card__caption">{{ 'anvil.product.with_discount_html' | t: title: title_html }}</span>
        {%- elsif request.design_mode and pct > 0 -%}
          <span class="av-offer-card__caption av-tier__hint">{{ 'anvil.editor.tier_needs_title' | t }}</span>
        {%- endif -%}
      </span>
      <span class="av-offer-card__price">
        <span class="av-offer-card__now" data-anvil-tier-unit>{{ 'anvil.product.per_unit_html' | t: price: unit_money }}</span>
        {%- if promo -%}
          <s class="av-offer-card__compare" data-anvil-tier-reg>
            <span class="av-visually-hidden">{{ 'anvil.price.regular_price' | t }}</span>
            <span>{% render 'anvil-money', amount: price %}</span>
          </s>
        {%- endif -%}
      </span>
    </span>
  </label>
{%- endif -%}
