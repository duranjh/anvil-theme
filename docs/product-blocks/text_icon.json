{
  "type": "text_icon",
  "name": "Text with icon",
  "settings": [
    {"type": "inline_richtext", "id": "text", "label": "Text", "default": "Example: free returns within 30 days — replace with what your policy says", "info": "State only what your shipping and returns policies back up."},
    {"type": "select", "id": "icon_name", "label": "Icon", "options": [{"value": "none", "label": "None"}, {"value": "check", "label": "Check"}, {"value": "check-circle", "label": "Check in circle"}, {"value": "badge-check", "label": "Badge check"}, {"value": "truck", "label": "Truck"}, {"value": "package", "label": "Package"}, {"value": "package-check", "label": "Package checked"}, {"value": "plane", "label": "Plane"}, {"value": "globe", "label": "Globe"}, {"value": "map-pin", "label": "Map pin"}, {"value": "rotate-ccw", "label": "Return arrow"}, {"value": "refresh-cw", "label": "Refresh"}, {"value": "shield", "label": "Shield"}, {"value": "shield-check", "label": "Shield check"}, {"value": "lock", "label": "Lock"}, {"value": "key", "label": "Key"}, {"value": "credit-card", "label": "Credit card"}, {"value": "wallet", "label": "Wallet"}, {"value": "banknote", "label": "Banknote"}, {"value": "receipt", "label": "Receipt"}, {"value": "piggy-bank", "label": "Piggy bank"}, {"value": "tag", "label": "Tag"}, {"value": "percent", "label": "Percent"}, {"value": "gift", "label": "Gift"}, {"value": "award", "label": "Award"}, {"value": "medal", "label": "Medal"}, {"value": "trophy", "label": "Trophy"}, {"value": "star", "label": "Star"}, {"value": "heart", "label": "Heart"}, {"value": "hand-heart", "label": "Hand with heart"}, {"value": "thumbs-up", "label": "Thumbs up"}, {"value": "users", "label": "People"}, {"value": "message-circle", "label": "Chat bubble"}, {"value": "headphones", "label": "Headphones"}, {"value": "mail", "label": "Mail"}, {"value": "phone", "label": "Phone"}, {"value": "smartphone", "label": "Phone device"}, {"value": "clock", "label": "Clock"}, {"value": "timer", "label": "Timer"}, {"value": "calendar", "label": "Calendar"}, {"value": "hourglass", "label": "Hourglass"}, {"value": "zap", "label": "Lightning"}, {"value": "sparkles", "label": "Sparkles"}, {"value": "lightbulb", "label": "Light bulb"}, {"value": "leaf", "label": "Leaf"}, {"value": "recycle", "label": "Recycle"}, {"value": "trees", "label": "Trees"}, {"value": "droplet", "label": "Droplet"}, {"value": "sun", "label": "Sun"}, {"value": "home", "label": "Home"}, {"value": "store", "label": "Store"}, {"value": "scale", "label": "Scale"}, {"value": "ruler", "label": "Ruler"}, {"value": "wrench", "label": "Wrench"}, {"value": "info", "label": "Info"}], "default": "rotate-ccw"},
    {"type": "image_picker", "id": "icon_custom", "label": "Custom icon image", "info": "Replaces the icon. Square images work best. Upload only images you are entitled to use."},
    {"type": "select", "id": "text_size", "label": "Size", "options": [{"value": "sm", "label": "Small"}, {"value": "md", "label": "Medium"}], "default": "md"},
    {"type": "text_alignment", "id": "align", "label": "Alignment", "default": "left"},
    {"type": "header", "content": "Background"},
    {"type": "checkbox", "id": "bg_enabled", "label": "Background pill", "default": false},
    {"type": "select", "id": "bg_style", "label": "Pill style", "options": [{"value": "subtle", "label": "Subtle tint"}, {"value": "accent", "label": "Accent colour"}, {"value": "outline", "label": "Outline"}], "default": "subtle", "visible_if": "{{ block.settings.bg_enabled }}", "info": "Colours come from the section's colour scheme."},
    {"type": "select", "id": "radius", "label": "Pill corners", "options": [{"value": "pill", "label": "Round"}, {"value": "soft", "label": "Soft"}, {"value": "square", "label": "Square"}], "default": "pill", "visible_if": "{{ block.settings.bg_enabled }}"},
    {"type": "header", "content": "Spacing"},
    {"type": "range", "id": "space_top", "label": "Space above", "min": 0, "max": 48, "step": 4, "unit": "px", "default": 0},
    {"type": "range", "id": "space_bottom", "label": "Space below", "min": 0, "max": 48, "step": 4, "unit": "px", "default": 0}
  ]
}
