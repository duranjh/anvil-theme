{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "rating": {
          "type": "rating",
          "settings": {
            "rating_show_number": true,
            "rating_show_count": true,
            "rating_size": "md",
            "rating_align": "left"
          }
        },
        "title": {
          "type": "title",
          "settings": {
            "show_name": true,
            "size": "lg",
            "align": "left",
            "uppercase": false,
            "space_top": 0,
            "space_bottom": 0
          }
        },
        "price": {
          "type": "price",
          "settings": {
            "size": "lg",
            "show_compare": true,
            "badge": "theme",
            "show_unit": true,
            "show_tax_note": false
